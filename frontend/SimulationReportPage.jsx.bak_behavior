import { useEffect, useMemo, useState } from "react";
import {
  ArrowLeft,
  ArrowRight,
  CheckCircle2,
  Download,
  Mail,
  ShieldAlert,
  ShieldCheck,
  Sparkles,
} from "lucide-react";
import { Link, useNavigate, useParams } from "react-router-dom";
import { simulationService } from "../../services/api";
import { useAuth } from "../../context/AuthContext";

function describeAction(action) {
  const raw = String(
    action?.interaction_id ||
      action?.action ||
      action?.type ||
      action?.interaction ||
      action?.decision ||
      action?.name ||
      action?.label ||
      ""
  ).toLowerCase();

  const suppliedDescription =
    action?.description ||
    action?.text ||
    action?.title ||
    "";

  if (
    suppliedDescription &&
    typeof suppliedDescription === "string" &&
    suppliedDescription.length > 12 &&
    !suppliedDescription.toLowerCase().includes("interaction")
  ) {
    return suppliedDescription.trim().replace(
      /[.!?]+$/,
      ""
    );
  }

  if (
    raw.includes("inspect") &&
    raw.includes("sender")
  ) {
    return "verificou os dados do remetente";
  }

  if (
    raw.includes("sender") ||
    raw.includes("remetente")
  ) {
    return "analisou a origem da mensagem";
  }

  if (
    raw.includes("open") &&
    raw.includes("link")
  ) {
    return "abriu a ligação apresentada na mensagem";
  }

  if (
    raw.includes("click") &&
    raw.includes("link")
  ) {
    return "abriu a ligação apresentada na mensagem";
  }

  if (
    raw.includes("link")
  ) {
    return "acedeu à ligação apresentada na mensagem";
  }

  if (
    raw.includes("open") &&
    raw.includes("form")
  ) {
    return "abriu o formulário apresentado";
  }

  if (
    raw.includes("form")
  ) {
    return "avançou para o formulário apresentado";
  }

  if (
    raw.includes("report") ||
    raw.includes("denunc") ||
    raw.includes("flag")
  ) {
    return "denunciou a mensagem como suspeita";
  }

  if (
    raw.includes("inspect") &&
    raw.includes("url")
  ) {
    return "verificou o endereço da página";
  }

  if (
    raw.includes("url")
  ) {
    return "analisou o endereço apresentado";
  }

  if (
    raw.includes("credential") ||
    raw.includes("password") ||
    raw.includes("senha") ||
    raw.includes("login") ||
    raw.includes("sign")
  ) {
    return "introduziu dados de acesso no formulário";
  }

  if (
    raw.includes("email") ||
    raw.includes("mail")
  ) {
    return "introduziu o endereço de correio electrónico";
  }

  if (
    raw.includes("mfa") ||
    raw.includes("code") ||
    raw.includes("otp")
  ) {
    return "introduziu um código de segurança";
  }

  if (
    raw.includes("refuse") ||
    raw.includes("reject") ||
    raw.includes("cancel")
  ) {
    return "recusou continuar com o pedido";
  }

  if (
    raw.includes("leave") ||
    raw.includes("back") ||
    raw.includes("exit")
  ) {
    return "saiu da página sem fornecer mais informação";
  }

  if (
    raw.includes("download")
  ) {
    return "descarregou o ficheiro apresentado";
  }

  if (
    raw.includes("delete") ||
    raw.includes("remove")
  ) {
    return "eliminou o conteúdo suspeito";
  }

  if (
    raw.includes("inspect") ||
    raw.includes("verify") ||
    raw.includes("check")
  ) {
    return "verificou a informação antes de continuar";
  }

  if (
    raw.includes("continue") ||
    raw.includes("next")
  ) {
    return "continuou para a etapa seguinte";
  }

  return "avançou numa etapa da situação simulada";
}

function getRiskText(report) {
  const dangerous =
    Array.isArray(
      report?.dangerous_actions
    )
      ? report.dangerous_actions
      : [];

  const hasCredentials =
    dangerous.some((item) => {
      const value = String(
        item?.interaction_id ||
          item?.action ||
          ""
      ).toLowerCase();

      return (
        value.includes("credential") ||
        value.includes("password") ||
        value.includes("login")
      );
    });

  if (hasCredentials) {
    return "A entrega de dados de acesso é a parte mais crítica desta experiência. Num caso real, um atacante poderia tentar utilizar essas informações para entrar na conta, consultar informação privada, alterar definições de segurança ou preparar novos ataques.";
  }

  if (dangerous.length > 0) {
    return "A situação mostrou como uma decisão aparentemente simples pode aumentar rapidamente o risco. O atacante beneficia quando a vítima age antes de confirmar a origem da mensagem.";
  }

  return "Nesta experiência, o comportamento apresentado reduziu o risco porque houve cuidado antes de avançar.";
}

function buildNarrative(
  decisionHistory,
  dataShared,
  wasReported
) {
  const descriptions =
    decisionHistory
      .map(
        (item) =>
          describeAction(item)
      )
      .filter(Boolean);

  const uniqueDescriptions =
    descriptions.filter(
      (value, index, array) =>
        value &&
        (
          index === 0 ||
          value !== array[index - 1]
        )
    );

  const parts = [];

  if (
    wasReported &&
    uniqueDescriptions.length === 1
  ) {
    parts.push(
      "Ao analisar a mensagem, denunciou-a como suspeita. Esta foi a decisão mais segura porque interrompeu a tentativa antes de fornecer informação ao remetente."
    );
  }
  else if (
    uniqueDescriptions.length > 0
  ) {
    parts.push(
      `Ao longo da experiência, ${uniqueDescriptions.join(
        ", "
      )}.`
    );
  }

  const emailItem =
    dataShared.find(
      (item) =>
        typeof item === "object" &&
        item !== null &&
        String(
          item.field || ""
        ).toLowerCase() === "email"
    );

  const passwordItem =
    dataShared.find(
      (item) =>
        typeof item === "object" &&
        item !== null &&
        String(
          item.field || ""
        ).toLowerCase() === "password"
    );

  if (emailItem?.value) {
    parts.push(
      `O endereço de correio electrónico introduzido foi ${emailItem.value}.`
    );
  }

  if (passwordItem) {
    parts.push(
      "Também foi introduzida uma palavra-passe. O seu conteúdo não é guardado nem apresentado pelo SICSI III."
    );
  }

  if (
    dataShared.length === 0 &&
    wasReported
  ) {
    parts.push(
      "Nenhuma informação sensível foi entregue. A denúncia interrompeu a situação antes de existir recolha de dados."
    );
  }

  if (
    dataShared.length > 0
  ) {
    parts.push(
      "Num caso real, essa informação poderia ser utilizada para tornar novos ataques mais convincentes, tentar recuperar acessos ou preparar outras formas de fraude."
    );
  }

  return (
    parts.join(" ") ||
    "A experiência foi concluída sem informação suficiente para produzir uma análise detalhada."
  );
}
export default function SimulationReportPage() {
  const { simulationId } = useParams();
  const navigate = useNavigate();
  const { user } = useAuth();

  const [simulation, setSimulation] =
    useState(null);

  const [result, setResult] =
    useState(null);

  const [loading, setLoading] =
    useState(true);

  const [error, setError] =
    useState("");

  const [downloading, setDownloading] =
    useState(false);

  const [endingSimulation, setEndingSimulation] =
    useState(false);

  const [platformMessage, setPlatformMessage] =
    useState("");

  useEffect(() => {
    let active = true;

    async function loadReport() {
      try {
        const [
          simulationData,
          resultData,
        ] = await Promise.all([
          simulationService.get(
            simulationId
          ),
          simulationService.getResult(
            simulationId,
            user?.id
          ),
        ]);

        if (!active) {
          return;
        }

        setSimulation(simulationData);
        setResult(resultData);
      } catch (requestError) {
        if (!active) {
          return;
        }

        setError(
          requestError?.message ||
            "Não foi possível carregar o relatório."
        );
      } finally {
        if (active) {
          setLoading(false);
        }
      }
    }

    if (user?.id) {
      loadReport();
    }

    return () => {
      active = false;
    };
  }, [simulationId, user?.id]);

  const report =
    result?.report || {};

  const safeActions =
    Array.isArray(
      report.safe_actions
    )
      ? report.safe_actions
      : [];

  const dangerousActions =
    Array.isArray(
      report.dangerous_actions
    )
      ? report.dangerous_actions
      : [];

  const dataShared =
    Array.isArray(
      report.data_shared
    )
      ? report.data_shared
      : [];

  const decisionHistory =
    Array.isArray(
      report.decision_history
    )
      ? report.decision_history
      : [];

  const wasReported =
    Boolean(
      report.was_reported
    );

  const score =
    Number(
      report.behaviour_score
    ) || 0;

  const narrative = useMemo(
    () =>
      buildNarrative(
        decisionHistory,
        dataShared,
        wasReported
      ),
    [
      decisionHistory,
      dataShared,
      wasReported,
    ]
  );

  const riskText =
    getRiskText(report);

  const emailItem =
    dataShared.find(
      (item) =>
        typeof item === "object" &&
        item !== null &&
        String(
          item.field || ""
        ).toLowerCase() === "email"
    );

  const passwordItem =
    dataShared.find(
      (item) =>
        typeof item === "object" &&
        item !== null &&
        String(
          item.field || ""
        ).toLowerCase() === "password"
    );

  const currentSequence =
    Number(
      simulation?.sequence || 0
    );

  const phishingSequence = {
    1: "phishing-01",
    2: "phishing-02",
    3: "phishing-03",
    4: "phishing-04",
    5: "phishing-05",
  };

  const nextSimulationId =
    phishingSequence[
      currentSequence + 1
    ] || null;

  const classification =
    score >= 80
      ? "Comportamento seguro"
      : score >= 60
        ? "Atenção necessária"
        : "Exposição elevada ao risco";

  async function downloadPdf() {
    if (
      downloading ||
      !user?.id ||
      !simulationId
    ) {
      return;
    }

    setDownloading(true);

    try {
      const blob =
        await simulationService.downloadResultPdf(
          simulationId,
          user.id
        );

      const url =
        window.URL.createObjectURL(
          blob
        );

      const anchor =
        document.createElement("a");

      const safeTitle =
        String(
          simulation?.title ||
            simulationId
        )
          .normalize("NFD")
          .replace(
            /[\u0300-\u036f]/g,
            ""
          )
          .replace(
            /[^a-zA-Z0-9]+/g,
            "_"
          )
          .replace(
            /^_+|_+$/g,
            ""
          );

      anchor.href = url;
      anchor.download = "SICSI III RELACTÓRIO.pdf";

      document.body.appendChild(
        anchor
      );
      anchor.click();
      anchor.remove();

      window.URL.revokeObjectURL(
        url
      );
    } catch (downloadError) {
      setPlatformMessage(
        "Não foi possível guardar o relatório em PDF neste momento. O relatório continua disponível nesta página. Tente novamente dentro de alguns instantes."
      );
    } finally {
      setDownloading(false);
    }
  }

  async function endSimulation() {
    if (
      endingSimulation ||
      !user?.id ||
      !simulationId
    ) {
      return;
    }

    setEndingSimulation(true);

    try {
      await simulationService.clearResult(
        simulationId,
        user.id
      );

      navigate(
        "/student/simulacoes"
      );
    } catch {
      setEndingSimulation(false);

      setPlatformMessage(
        "Não foi possível encerrar a simulação neste momento. Os dados temporários continuam disponíveis."
      );
    }
  }

  function goToNextSimulation() {
    if (!nextSimulationId) {
      navigate(
        "/student/simulacoes"
      );
      return;
    }

    navigate(
      `/student/simulacoes/${nextSimulationId}`
    );
  }

  if (loading) {
    return (
      <div className="mx-auto flex min-h-[65vh] w-full max-w-6xl items-center justify-center px-4">
        <div className="text-center">
          <div className="mx-auto h-11 w-11 animate-spin rounded-full border-4 border-blue-600 border-t-transparent" />

          <p className="mt-4 text-sm font-semibold text-slate-500">
            A preparar a análise...
          </p>
        </div>
      </div>
    );
  }

  if (error || !result) {
    return (
      <div className="mx-auto w-full max-w-3xl px-4 py-10">
        <div className="rounded-[2rem] border border-slate-200 bg-white p-10 text-center shadow-xl">
          <ShieldAlert className="mx-auto h-12 w-12 text-red-500" />

          <h1 className="mt-5 text-2xl font-black text-slate-950">
            Relatório indisponível
          </h1>

          <p className="mt-3 text-sm leading-7 text-slate-500">
            {error ||
              "Ainda não existe um relatório concluído para esta experiência."}
          </p>

          <Link
            to="/student/simulacoes"
            className="mt-7 inline-flex items-center gap-2 rounded-xl bg-blue-600 px-5 py-3 text-sm font-bold text-white"
          >
            <ArrowLeft className="h-4 w-4" />
            Voltar às simulações
          </Link>
        </div>
      </div>
    );
  }

  return (
    <>
      {platformMessage && (
        <div
          className="fixed inset-0 z-[100] flex items-center justify-center bg-slate-950/50 px-4 backdrop-blur-sm"
          role="dialog"
          aria-modal="true"
        >
          <div className="w-full max-w-md rounded-[2rem] border border-slate-200 bg-white p-6 shadow-2xl sm:p-7">
            <div className="flex items-start gap-4">
              <div className="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-red-50 text-red-600">
                <ShieldAlert className="h-6 w-6" />
              </div>

              <div className="min-w-0">
                <p className="text-[11px] font-black uppercase tracking-[0.16em] text-red-600">
                  SICSI III
                </p>

                <h2 className="mt-1 text-xl font-black text-slate-950">
                  Não foi possível concluir
                </h2>

                <p className="mt-3 text-sm leading-7 text-slate-600">
                  {platformMessage}
                </p>
              </div>
            </div>

            <button
              type="button"
              onClick={() =>
                setPlatformMessage("")
              }
              className="mt-6 w-full rounded-xl bg-blue-600 px-5 py-3 text-sm font-bold text-white transition hover:bg-blue-700"
            >
              Entendi
            </button>
          </div>
        </div>
      )}

      <div className="mx-auto w-full max-w-6xl px-4 pb-16 pt-6 sm:px-6 lg:px-8">
      {/* TOPO */}
      <section className="relative overflow-hidden rounded-[2.25rem] bg-slate-950 shadow-2xl shadow-slate-300/40">
        <div className="absolute inset-0 bg-gradient-to-br from-blue-700/80 via-blue-700/30 to-indigo-700/70" />

        <div className="relative px-6 py-8 sm:px-9 sm:py-10 lg:px-12 lg:py-12">
          <div className="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
            <div className="max-w-3xl">
              <div className="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-3 py-1.5 text-[11px] font-black uppercase tracking-[0.16em] text-blue-100">
                <CheckCircle2 className="h-4 w-4" />
                Experiência concluída
              </div>

              <p className="mt-6 text-xs font-black uppercase tracking-[0.18em] text-blue-200">
                {simulation?.category ||
                  "Phishing"}
              </p>

              <h1 className="mt-2 text-3xl font-black tracking-tight text-white sm:text-4xl lg:text-5xl">
                {simulation?.title}
              </h1>

              <p className="mt-4 max-w-2xl text-sm leading-7 text-blue-50 sm:text-base">
                O relatório explica o que fez, o que
                ficou potencialmente exposto e como
                poderá reconhecer uma situação semelhante
                no futuro.
              </p>
            </div>

            <div className="shrink-0 rounded-[1.75rem] border border-white/15 bg-white/10 p-5 text-center backdrop-blur-md">
              <p className="text-[10px] font-black uppercase tracking-[0.18em] text-blue-100">
                Resultado
              </p>

              <p className="mt-1 text-5xl font-black text-white">
                {score}
              </p>

              <p className="text-xs font-bold text-blue-100">
                em 100
              </p>

              <p className="mt-2 text-xs font-black text-white">
                {classification}
              </p>
            </div>
          </div>
        </div>
      </section>

      {/* RESUMO */}
      <section className="mt-6 grid gap-4 md:grid-cols-3">
        <div className="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm">
          <p className="text-[11px] font-black uppercase tracking-[0.15em] text-emerald-600">
            Decisões seguras
          </p>

          <p className="mt-2 text-3xl font-black text-slate-950">
            {safeActions.length}
          </p>

          <p className="mt-1 text-sm text-slate-500">
            Decisões que reduziram o risco.
          </p>
        </div>

        <div className="rounded-3xl border border-red-100 bg-white p-5 shadow-sm">
          <p className="text-[11px] font-black uppercase tracking-[0.15em] text-red-600">
            Decisões de risco
          </p>

          <p className="mt-2 text-3xl font-black text-slate-950">
            {dangerousActions.length}
          </p>

          <p className="mt-1 text-sm text-slate-500">
            Momentos em que a exposição aumentou.
          </p>
        </div>

        <div className="rounded-3xl border border-blue-100 bg-white p-5 shadow-sm">
          <p className="text-[11px] font-black uppercase tracking-[0.15em] text-blue-600">
            Informação envolvida
          </p>

          <p className="mt-2 text-3xl font-black text-slate-950">
            {dataShared.length}
          </p>

          <p className="mt-1 text-sm text-slate-500">
            Dados que poderiam ter sido aproveitados.
          </p>
        </div>
      </section>

      {/* PERCURSO */}
      <section className="mt-6 rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm sm:p-8 lg:p-9">
        <div className="flex items-start gap-4">
          <div className="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-blue-50 text-blue-600">
            <Sparkles className="h-5 w-5" />
          </div>

          <div>
            <p className="text-[11px] font-black uppercase tracking-[0.16em] text-blue-600">
              Leitura da experiência
            </p>

            <h2 className="mt-1 text-2xl font-black tracking-tight text-slate-950">
              O que aconteceu
            </h2>
          </div>
        </div>

        <div className="mt-6 rounded-[1.5rem] border border-slate-100 bg-slate-50 p-6 sm:p-7">
          <p className="text-sm leading-8 text-slate-700 sm:text-[15px]">
            {narrative}
          </p>
        </div>
      </section>

      {/* DADOS */}
      <section className="mt-6 rounded-[2rem] border border-red-100 bg-white p-6 shadow-sm sm:p-8 lg:p-9">
        <div className="flex items-start gap-4">
          <div className="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-red-50 text-red-600">
            <ShieldAlert className="h-5 w-5" />
          </div>

          <div>
            <p className="text-[11px] font-black uppercase tracking-[0.16em] text-red-600">
              Informação potencialmente exposta
            </p>

            <h2 className="mt-1 text-2xl font-black tracking-tight text-slate-950">
              O que poderia ter sido aproveitado
            </h2>
          </div>
        </div>

        {dataShared.length === 0 ? (
          <div className="mt-6 rounded-2xl border border-emerald-100 bg-emerald-50 p-5">
            <div className="flex items-start gap-3">
              <ShieldCheck className="mt-0.5 h-5 w-5 shrink-0 text-emerald-600" />

              <div>
                <p className="text-sm font-black text-emerald-900">
                  {wasReported
                    ? "A sua denúncia interrompeu a tentativa antes da entrega de informação sensível."
                    : "Nenhuma informação sensível foi entregue durante a experiência."}
                </p>

                <p className="mt-1 text-sm leading-6 text-emerald-800">
                  A experiência terminou sem registo de
                  dados que pudessem ser aproveitados pelo
                  atacante simulado.
                </p>
              </div>
            </div>
          </div>
        ) : (
          <div className="mt-6 grid gap-4 lg:grid-cols-2">
            {emailItem?.value && (
              <div className="rounded-[1.5rem] border border-red-100 bg-red-50 p-5">
                <div className="flex items-start gap-4">
                  <div className="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-white text-red-600 shadow-sm">
                    <Mail className="h-5 w-5" />
                  </div>

                  <div className="min-w-0">
                    <p className="text-[10px] font-black uppercase tracking-[0.15em] text-red-600">
                      Endereço de correio electrónico
                    </p>

                    <p className="mt-2 break-all text-sm font-black text-slate-950">
                      {emailItem.value}
                    </p>

                    <p className="mt-2 text-xs leading-6 text-red-800">
                      Poderia ser utilizado para tornar
                      futuras mensagens fraudulentas mais
                      convincentes ou para associar novos
                      ataques à sua identidade digital.
                    </p>
                  </div>
                </div>
              </div>
            )}

            {passwordItem && (
              <div className="rounded-[1.5rem] border border-red-100 bg-red-50 p-5">
                <div className="flex items-start gap-4">
                  <div className="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-white text-red-600 shadow-sm">
                    <ShieldAlert className="h-5 w-5" />
                  </div>

                  <div>
                    <p className="text-[10px] font-black uppercase tracking-[0.15em] text-red-600">
                      Palavra-passe
                    </p>

                    <p className="mt-2 text-sm font-black text-slate-950">
                      Introduzida — conteúdo não guardado
                    </p>

                    <p className="mt-2 text-xs leading-6 text-red-800">
                      Num caso real, esta informação poderia
                      permitir uma tentativa de acesso à
                      conta. O SICSI III não guarda nem
                      apresenta a palavra-passe introduzida.
                    </p>
                  </div>
                </div>
              </div>
            )}
          </div>
        )}
      </section>

      {/* IMPACTO */}
      <section className="mt-6 grid gap-6 lg:grid-cols-[1.15fr_0.85fr]">
        <div className="rounded-[2rem] border border-red-100 bg-gradient-to-br from-red-50 to-white p-6 shadow-sm sm:p-8">
          <p className="text-[11px] font-black uppercase tracking-[0.16em] text-red-600">
            Porque importa
          </p>

          <h2 className="mt-2 text-2xl font-black text-slate-950">
            Impacto possível num caso real
          </h2>

          <p className="mt-4 text-sm leading-8 text-slate-700 sm:text-[15px]">
            {riskText}
          </p>
        </div>

        <div className="rounded-[2rem] border border-blue-100 bg-gradient-to-br from-blue-50 to-white p-6 shadow-sm sm:p-8">
          <p className="text-[11px] font-black uppercase tracking-[0.16em] text-blue-600">
            Próxima oportunidade
          </p>

          <h2 className="mt-2 text-2xl font-black text-slate-950">
            Como melhorar
          </h2>

          <p className="mt-4 text-sm leading-7 text-slate-700">
            Pare antes de agir. Confirme o remetente,
            verifique o endereço real da página e aceda
            directamente ao serviço oficial.
          </p>

          <div className="mt-5 rounded-2xl bg-white p-4 shadow-sm">
            <p className="text-sm font-black leading-6 text-slate-950">
              Uma mensagem urgente não deve decidir por si.
            </p>
          </div>
        </div>
      </section>

      {/* FINAL */}
      <section className="mt-6 rounded-[2rem] border border-slate-200 bg-slate-50 p-5 sm:p-7">
        <div className="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between">
          <div>
            <p className="text-sm font-black text-slate-950">
              Relatório concluído
            </p>

            <p className="mt-1 text-xs leading-6 text-slate-500">
              Guarde uma cópia organizada do relatório ou
              continue directamente para a próxima situação.
            </p>
          </div>

          <div className="flex flex-col gap-3 sm:flex-row">
            <button
              type="button"
              onClick={downloadPdf}
              disabled={downloading}
              className="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-5 py-3 text-sm font-bold text-slate-700 shadow-sm transition hover:border-blue-300 hover:text-blue-700 disabled:cursor-not-allowed disabled:opacity-60"
            >
              <Download className="h-4 w-4" />
              {downloading
                ? "A gerar relatório..."
                : "Guardar em PDF"}
            </button>

            {nextSimulationId && (
              <button
                type="button"
                onClick={goToNextSimulation}
                className="inline-flex items-center justify-center gap-2 rounded-xl bg-blue-600 px-6 py-3 text-sm font-bold text-white shadow-lg shadow-blue-600/20 transition hover:bg-blue-700"
              >
                Próxima simulação
                <ArrowRight className="h-4 w-4" />
              </button>
            )}

            <button
              type="button"
              onClick={endSimulation}
              disabled={endingSimulation}
              className="inline-flex items-center justify-center gap-2 rounded-xl border border-red-200 bg-red-50 px-5 py-3 text-sm font-bold text-red-700 transition hover:bg-red-100 disabled:cursor-not-allowed disabled:opacity-60"
            >
              <ArrowLeft className="h-4 w-4" />
              {endingSimulation
                ? "A encerrar..."
                : "Encerrar simulação"}
            </button>
          </div>
        </div>
      </section>
    </div>
    </>
  );
}