function loadAllPhishingEvents() {
  try {
    const parsed = JSON.parse(localStorage.getItem("sicsi_simulation_events") || "[]");
    return Array.isArray(parsed) ? parsed.filter((event) => String(event?.simulation_id || "").startsWith("phishing-")).sort((a, b) => new Date(a?.timestamp || 0).getTime() - new Date(b?.timestamp || 0).getTime()) : [];
  } catch { return []; }
}

function actionLabel(action = "", metadata = {}) {
  if (metadata?.decision_label) return metadata.decision_label;
  const labels = {
    investigate_alert: "Investigou o alerta antes de decidir",
    ignore_security_alert: "Ignorou o alerta de segurança",
    review_activity: "Consultou a actividade recente",
    review_devices: "Consultou os dispositivos e sessões",
    review_security_changes: "Consultou as alterações de segurança",
    review_session: "Consultou os detalhes da sessão",
    block_unknown_session: "Bloqueou a sessão desconhecida",
    keep_unknown_session: "Manteve a sessão desconhecida activa",
    confirm_unverified_activity: "Prosseguiu sem validar a actividade",
    secure_account: "Seleccionou protecção da conta",
    contact_support: "Escolheu um canal institucional independente",
    continue_without_protection: "Continuou sem reforçar as protecções",
    finish_secure_response: "Concluiu a resposta segura",
    complete_simulation: "Concluiu a simulação",
  };
  return labels[action] || String(action || "Interacção relevante").replaceAll("_", " ").replace(/\b\w/g, (character) => character.toUpperCase());
}

function inferOutcome(event = {}) {
  if (typeof event?.metadata?.safe === "boolean") return event.metadata.safe ? "positive" : "negative";
  const action = String(event?.action || "").toLowerCase();
  if (SAFE_ACTIONS.some((value) => action === value || action.includes(value))) return "positive";
  if (RISK_ACTIONS.some((value) => action === value || action.includes(value))) return "negative";
  return "neutral";
}

function buildReportData(account) {
  const events = loadAllPhishingEvents();
  const simulations = Object.entries(SIMULATION_LABELS).map(([id, label]) => {
    const simulationEvents = events.filter((event) => event.simulation_id === id);
    const relevant = simulationEvents.filter((event) => {
      const outcome = inferOutcome(event);
      return outcome !== "neutral" || event?.metadata?.report_relevant;
    }).map((event) => ({
      label: actionLabel(event.action, event.metadata),
      outcome: inferOutcome(event),
      feedback: event?.metadata?.feedback || (inferOutcome(event) === "positive" ? "A decisão contribuiu para reduzir o risco." : inferOutcome(event) === "negative" ? "A decisão aumentou ou manteve a exposição ao risco." : "Interacção registada no percurso."),
    })).slice(-3);
    return { id, label, relevant, positive: relevant.filter((item) => item.outcome === "positive").length, negative: relevant.filter((item) => item.outcome === "negative").length };
  });
  return { account, generatedAt: new Date(), simulations, positive: simulations.reduce((sum, item) => sum + item.positive, 0), negative: simulations.reduce((sum, item) => sum + item.negative, 0) };
}

function drawWrappedText(pdf, text, x, y, width, options = {}) {
  const size = options.size || 9; const lineHeight = options.lineHeight || 4.8; const colour = options.colour || [71, 85, 105];
  pdf.setFontSize(size); pdf.setTextColor(...colour); const lines = pdf.splitTextToSize(String(text || ""), width); pdf.text(lines, x, y); return y + lines.length * lineHeight;
}

function downloadPdfReport(account) {
  const report = buildReportData(account);
  const pdf = new jsPDF({ unit: "mm", format: "a4" });
  const pageWidth = pdf.internal.pageSize.getWidth(); const pageHeight = pdf.internal.pageSize.getHeight(); const margin = 16; const contentWidth = pageWidth - margin * 2; let y = 18;

  pdf.setFillColor(15, 23, 42); pdf.rect(0, 0, pageWidth, 43, "F"); pdf.setTextColor(255, 255, 255); pdf.setFont("helvetica", "bold"); pdf.setFontSize(18); pdf.text("SICSI · Relatório de Segurança", margin, 18); pdf.setFontSize(9); pdf.text("Síntese das experiências de phishing", margin, 25); pdf.setFont("helvetica", "normal"); pdf.text(`Conta: ${report.account}`, margin, 32); pdf.text(`Gerado: ${report.generatedAt.toLocaleString("pt-PT")}`, margin, 38);
  y = 53; pdf.setTextColor(15, 23, 42); pdf.setFont("helvetica", "bold"); pdf.setFontSize(12); pdf.text("Resumo executivo", margin, y); y += 7; y = drawWrappedText(pdf, "O relatório sintetiza decisões relevantes e os principais feedbacks recebidos nas cinco experiências de phishing. Não reproduz credenciais, códigos de autenticação nem uma cronologia exaustiva de interacções.", margin, y, contentWidth, { size: 9, lineHeight: 5 }); y += 5;

  const cardWidth = (contentWidth - 6) / 3; [["Experiências", "05"], ["Feedbacks positivos", String(report.positive)], ["Feedbacks de risco", String(report.negative)]].forEach(([label, value], index) => { const x = margin + index * (cardWidth + 3); pdf.setDrawColor(226, 232, 240); pdf.setFillColor(248, 250, 252); pdf.roundedRect(x, y, cardWidth, 20, 3, 3, "FD"); pdf.setFont("helvetica", "bold"); pdf.setFontSize(7); pdf.setTextColor(100, 116, 139); pdf.text(label.toUpperCase(), x + 4, y + 7); pdf.setFontSize(13); pdf.setTextColor(15, 23, 42); pdf.text(value, x + 4, y + 15); }); y += 30;

  report.simulations.forEach((simulation) => { if (y > pageHeight - 35) { pdf.addPage(); y = 18; } pdf.setFont("helvetica", "bold"); pdf.setFontSize(11); pdf.setTextColor(15, 23, 42); pdf.text(`Simulação ${simulation.id.split("-")[1]} · ${simulation.label}`, margin, y); y += 6; if (simulation.relevant.length === 0) { y = drawWrappedText(pdf, "Sem decisões críticas adicionais disponíveis para sintetizar nesta experiência.", margin, y, contentWidth, { size: 8.5, lineHeight: 4.6 }); } else { simulation.relevant.forEach((item) => { if (y > pageHeight - 30) { pdf.addPage(); y = 18; } const safe = item.outcome === "positive"; pdf.setFillColor(...(safe ? [236, 253, 245] : [254, 242, 242])); pdf.setDrawColor(...(safe ? [167, 243, 208] : [252, 165, 165])); pdf.roundedRect(margin, y, contentWidth, 21, 3, 3, "FD"); pdf.setFont("helvetica", "bold"); pdf.setFontSize(8); pdf.setTextColor(...(safe ? [6, 95, 70] : [153, 27, 27])); pdf.text(safe ? "FEEDBACK POSITIVO" : "FEEDBACK DE RISCO", margin + 4, y + 6); pdf.setTextColor(15, 23, 42); pdf.text(item.label, margin + 4, y + 11); drawWrappedText(pdf, item.feedback, margin + 4, y + 16, contentWidth - 8, { size: 7.5, lineHeight: 4, colour: [71, 85, 105] }); y += 25; }); } y += 3; });
  if (y > pageHeight - 28) { pdf.addPage(); y = 18; } pdf.setDrawColor(226, 232, 240); pdf.line(margin, y, pageWidth - margin, y); y += 7; pdf.setFont("helvetica", "bold"); pdf.setFontSize(9); pdf.setTextColor(30, 41, 59); pdf.text("Síntese final", margin, y); y += 5; drawWrappedText(pdf, "As experiências foram desenhadas para desenvolver a capacidade de reconhecer sinais, validar contexto, evitar decisões sob pressão e responder de forma segura a incidentes envolvendo contas e informação institucional.", margin, y, contentWidth, { size: 8.5, lineHeight: 4.8 });
  pdf.save("SICSI_Relatorio_Seguranca_Phishing.pdf");
}

export default function Phishing05Page() {
  const navigate = useNavigate(); const { user } = useAuth(); const accountEmail = getAccountEmail(user);
  const [state, setState] = useState(STATES.HOME); const [reviewed, setReviewed] = useState({ activity: false, devices: false, security: false, session: false }); const [lastDecision, setLastDecision] = useState(null); const [lastOutcome, setLastOutcome] = useState(null); const [events, setEvents] = useState([]); const [startedAt, setStartedAt] = useState(Date.now()); const [elapsed, setElapsed] = useState(0); const [sessionReady, setSessionReady] = useState(false);
  const reviewedCount = useMemo(() => Object.values(reviewed).filter(Boolean).length, [reviewed]);

  useEffect(() => { const current = getCurrentSimulation(); if (current && current.simulation_id === SIMULATION.id && !current.completed) { setStartedAt(current.started_at ? new Date(current.started_at).getTime() : Date.now()); } else { const session = startSimulation({ area: SIMULATION.area, simulationId: SIMULATION.id, simulationNumber: SIMULATION.number, initialState: STATES.HOME }); setStartedAt(session?.started_at ? new Date(session.started_at).getTime() : Date.now()); registerAction({ action: "simulation_started", nextState: STATES.HOME, interactionType: "system", metadata: { simulation_id: SIMULATION.id, simulation_number: SIMULATION.number, title: SIMULATION.title } }); } setSessionReady(true); }, []);
  useEffect(() => { if (!sessionReady) return undefined; const timer = window.setInterval(() => setElapsed(Date.now() - startedAt), 1000); return () => window.clearInterval(timer); }, [sessionReady, startedAt]);
  useEffect(() => { if (!sessionReady) return undefined; const timer = window.setTimeout(() => { try { const stored = JSON.parse(localStorage.getItem("sicsi_simulation_events") || "[]"); const session = getCurrentSimulation(); if (session?.session_id) setEvents(stored.filter((event) => event.session_id === session.session_id)); } catch { setEvents([]); } }, 40); return () => window.clearTimeout(timer); }, [state, sessionReady]);

  function track(action, nextState, interactionType = "interaction", metadata = {}) { const result = registerAction({ action, nextState, interactionType, metadata }); if (result?.event) setEvents((current) => [...current, result.event]); return result; }
  function go(nextState, action, metadata = {}) { track(action, nextState, "navigation", metadata); setState(nextState); }
  function startIncident() { go(STATES.ALERT, "open_security_alert"); }
  function investigateAlert() { track("investigate_alert", STATES.CENTER, "decision", { report_relevant: true, safe: true, feedback: "Investigar antes de decidir reduziu a pressão e criou espaço para validar evidências.", feedback_title: "Boa prática: investigar antes de agir", decision_label: "Investigou o alerta antes de decidir" }); setState(STATES.CENTER); }
  function ignoreAlert() { const feedback = "Ignorar um alerta sem validar a origem mantém o cenário de risco aberto."; track("ignore_security_alert", STATES.CONSEQUENCE, "decision", { report_relevant: true, safe: false, feedback, feedback_title: "Decisão de risco: alerta ignorado", decision_label: "Ignorou o alerta de segurança" }); setLastDecision("Ignorou o alerta de segurança"); setLastOutcome({ safe: false, title: "O alerta foi ignorado sem validação.", description: "A simulação mantém o cenário de risco activo porque a decisão foi tomada sem confirmar a legitimidade da actividade.", feedback }); setState(STATES.CONSEQUENCE); }
  function openEvidence(type) { const actionMap = { activity: "review_activity", devices: "review_devices", security: "review_security_changes", session: "review_session" }; const stateMap = { activity: STATES.ACTIVITY, devices: STATES.DEVICES, security: STATES.SECURITY_CHANGES, session: STATES.SESSION_DETAIL }; track(actionMap[type], stateMap[type], "navigation", { evidence_type: type }); setState(stateMap[type]); }
  function markEvidence(type) { const actionMap = { activity: "review_activity", devices: "review_devices", security: "review_security_changes", session: "review_session" }; setReviewed((current) => ({ ...current, [type]: true })); track(actionMap[type], STATES.CENTER, "security_review", { evidence_type: type, evidence_reviewed: true, report_relevant: false }); setState(STATES.CENTER); }
  function makeSafeDecision() { const decision = "Bloqueou a sessão desconhecida"; const feedback = reviewedCount >= 2 ? "A decisão combinou investigação com contenção. Mesmo sem certeza absoluta, revogar uma sessão não reconhecida reduz a superfície de ataque." : "A decisão foi defensiva, mas uma investigação com mais evidências teria fortalecido a validação antes da resposta."; track("block_unknown_session", STATES.CONSEQUENCE, "decision", { report_relevant: true, safe: true, feedback, feedback_title: "Decisão segura: contenção do acesso", decision_label: decision, evidence_count: reviewedCount }); setLastDecision(decision); setLastOutcome({ safe: true, title: "A sessão desconhecida foi colocada em contenção.", description: "A decisão reduziu a exposição imediata e criou condições para uma resposta segura ao incidente.", feedback }); setState(STATES.CONSEQUENCE); }
  function makeRiskDecision() { const decision = "Manteve a sessão desconhecida activa"; const feedback = "Manter uma sessão não reconhecida sem contenção prolonga a exposição e dá mais tempo a um possível atacante para actuar."; track("keep_unknown_session", STATES.CONSEQUENCE, "decision", { report_relevant: true, safe: false, feedback, feedback_title: "Decisão de risco: sessão mantida", decision_label: decision, evidence_count: reviewedCount }); setLastDecision(decision); setLastOutcome({ safe: false, title: "A sessão suspeita permaneceu activa.", description: "A ausência de contenção manteve o cenário exposto e obrigou a uma resposta adicional.", feedback }); setState(STATES.CONSEQUENCE); }
  function continueFromConsequence() { track(lastOutcome?.safe ? "secure_account" : "confirm_unverified_activity", STATES.RESPONSE, "navigation", { report_relevant: !lastOutcome?.safe, safe: Boolean(lastOutcome?.safe) }); setState(STATES.RESPONSE); }
  function secureResponse() { track("finish_secure_response", STATES.RESPONSE_PROCESSING, "decision", { report_relevant: true, safe: true, feedback: "Encerrar a sessão suspeita e reforçar a conta fecha o ciclo de resposta em vez de parar na simples detecção.", feedback_title: "Boa resposta: contenção e protecção", decision_label: "Protegeu a conta e encerrou a sessão suspeita" }); setState(STATES.RESPONSE_PROCESSING); window.setTimeout(() => { setLastOutcome({ safe: true, title: "Resposta concluída com contenção.", description: "A conta foi protegida, a sessão suspeita foi encerrada e o percurso ficou preparado para o fecho da experiência.", feedback: "A resposta combinou detecção, contenção e recuperação do controlo." }); setState(STATES.RESPONSE_RESULT); }, 800); }
  function riskyResponse() { track("continue_without_protection", STATES.RESPONSE_RESULT, "decision", { report_relevant: true, safe: false, feedback: "Continuar sem reforçar a protecção mantém a conta dependente de sinais futuros, em vez de reduzir activamente a exposição.", feedback_title: "Resposta insuficiente: protecção adiada", decision_label: "Continuou sem reforçar as protecções" }); setLastOutcome({ safe: false, title: "A resposta foi concluída sem reforço de protecção.", description: "A conta continua exposta a uma sessão que já apresentou sinais de anomalia.", feedback: "Em incidentes de conta, detectar sem conter pode não ser suficiente." }); setState(STATES.RESPONSE_RESULT); }
  function downloadReport() { track("download_general_report", STATES.RESPONSE_RESULT, "download", { format: "pdf", report_scope: "phishing_01_to_05", report_relevant: false }); downloadPdfReport(accountEmail); }
  function finalizeSimulation() { track("complete_simulation", STATES.RESPONSE_RESULT, "navigation", { report_relevant: false, safe: lastOutcome?.safe, feedback: "A experiência foi concluída e integrada no percurso geral de phishing." }); completeSimulation(); completeSimulationSession(); navigate("/student/simulacoes"); }
  function renderState() {
    if (state === STATES.HOME) return <AcademicHomeView account={accountEmail} onStart={startIncident} />;
    if (state === STATES.ALERT) return <AlertView account={accountEmail} onInvestigate={investigateAlert} onIgnore={ignoreAlert} onBack={() => setState(STATES.HOME)} />;
    if (state === STATES.CENTER) return <IncidentCenterView reviewed={reviewed} onEvidence={openEvidence} onDecision={() => setState(STATES.DECISION)} onBack={() => setState(STATES.ALERT)} />;
    if (state === STATES.ACTIVITY) return <EvidenceView type="activity" onBack={() => setState(STATES.CENTER)} onNext={() => markEvidence("activity")} />;
    if (state === STATES.DEVICES) return <EvidenceView type="devices" onBack={() => setState(STATES.CENTER)} onNext={() => markEvidence("devices")} />;
    if (state === STATES.SECURITY_CHANGES) return <EvidenceView type="security" onBack={() => setState(STATES.CENTER)} onNext={() => markEvidence("security")} />;
    if (state === STATES.SESSION_DETAIL) return <EvidenceView type="session" onBack={() => setState(STATES.CENTER)} onNext={() => markEvidence("session")} />;
    if (state === STATES.DECISION) return <DecisionView reviewed={reviewed} onSafe={makeSafeDecision} onRisk={makeRiskDecision} onBack={() => setState(STATES.CENTER)} />;
    if (state === STATES.CONSEQUENCE) return <ConsequenceView safe={Boolean(lastOutcome?.safe)} title={lastOutcome?.title || "Decisão registada"} description={lastOutcome?.description || ""} decisionLabel={lastDecision || "Decisão registada"} onContinue={continueFromConsequence} onBack={() => setState(STATES.DECISION)} />;
    if (state === STATES.RESPONSE) return <ResponseView safePath={Boolean(lastOutcome?.safe)} onSecure={secureResponse} onRisky={riskyResponse} onBack={() => setState(STATES.CONSEQUENCE)} />;
    if (state === STATES.RESPONSE_PROCESSING) return <ResponseProcessingView />;
    if (state === STATES.RESPONSE_RESULT) return <ResponseResultView safe={Boolean(lastOutcome?.safe)} onComplete={finalizeSimulation} onDownload={downloadReport} />;
    return <AcademicHomeView account={accountEmail} onStart={startIncident} />;
  }

  if (!sessionReady) return <Shell title="Conta académica"><main className="flex min-h-[calc(100vh-4rem)] items-center justify-center px-4"><div className="text-center"><RefreshCw size={25} className="mx-auto animate-spin text-blue-700" /><div className="mt-4 text-sm font-semibold text-slate-500">A preparar a simulação...</div></div></main></Shell>;
  return renderState();
