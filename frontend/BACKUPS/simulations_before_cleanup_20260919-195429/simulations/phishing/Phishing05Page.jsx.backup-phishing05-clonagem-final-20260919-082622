function ProgressBar({ step, total = 5 }) {
  const progress = Math.min(100, Math.max(0, (step / total) * 100));
  return (
    <div className="mt-6">
      <div className="flex items-center justify-between text-[10px] font-bold uppercase tracking-[0.14em] text-slate-400"><span>Progressão da experiência</span><span>{step} / {total}</span></div>
      <div className="mt-2 h-2 overflow-hidden rounded-full bg-slate-100"><div className="h-full rounded-full bg-blue-600 transition-all duration-500" style={{ width: `${progress}%` }} /></div>
    </div>
  );
}

