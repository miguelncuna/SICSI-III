                                className="rounded-2xl border border-blue-100 bg-blue-50 p-4 text-sm leading-6 text-slate-700"
                              >
                                {recommendation}
                              </div>
                            )
                          )}

                      </div>

                    </section>

                  </div>

                </article>
              );
            }
          )}

        </section>

        <section className="mt-8 rounded-3xl bg-gradient-to-br from-blue-900 via-blue-800 to-blue-600 p-7 text-white shadow-xl sm:p-9">

          <div className="text-xs font-black uppercase tracking-[0.18em] text-blue-100">
            Fecho do percurso
          </div>

          <h2 className="mt-2 text-2xl font-black">
            O teu relatório está pronto.
          </h2>

          <p className="mt-3 max-w-3xl text-sm leading-7 text-blue-50">
            O relatório apresenta apenas a análise essencial das cinco simulações. Os dados técnicos utilizados pelo sistema permanecem internos e palavras-passe ou códigos secretos não são apresentados.
          </p>

          <div className="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap">

            <button
              type="button"
              onClick={handleDownloadPdf}
              className="rounded-xl bg-white px-5 py-3 text-sm font-black text-blue-800 transition hover:bg-blue-50"
            >
              Descarregar relatório em PDF
            </button>

            <button
              type="button"
              onClick={onBack}
              className="rounded-xl border border-white/30 bg-white/10 px-5 py-3 text-sm font-black text-white backdrop-blur-sm transition hover:bg-white/20"
            >
              Voltar ao percurso
            </button>

            <button
              type="button"
              onClick={handleFinish}
              className="rounded-xl border border-white/30 bg-transparent px-5 py-3 text-sm font-black text-white transition hover:bg-white/10"
            >
              Encerrar simulação
            </button>

          </div>

