                    </section>

                  </div>

                  <div className="grid gap-5 border-t border-slate-100 p-6 sm:p-8 lg:grid-cols-3">

                    <section>

                      <h3 className="text-sm font-black uppercase tracking-wide text-red-700">
                        O que poderia ter acontecido
                      </h3>

                      <div className="mt-4 space-y-3">

                        {outcomes
                          .slice(0, 2)
                          .map(
                            (
                              outcome,
                              index
                            ) => (
                              <div
                                key={`outcome-${simulation.number}-${index}`}
                                className="rounded-2xl border border-red-100 bg-red-50 p-4 text-sm leading-6 text-slate-700"
                              >
                                {outcome}
                              </div>
