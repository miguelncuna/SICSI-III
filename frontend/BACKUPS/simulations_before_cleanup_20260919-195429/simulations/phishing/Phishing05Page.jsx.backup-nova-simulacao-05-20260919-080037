                    <section>

                      <h3 className="text-sm font-black uppercase tracking-wide text-slate-800">
                        Vulnerabilidades pessoais
                      </h3>

                      <div className="mt-4 space-y-3">

                        {safeList(
                          simulation.vulnerabilities,
                          "Não foram identificadas vulnerabilidades pessoais relevantes nesta etapa."
                        )
                          .slice(0, 2)
                          .map(
                            (
                              vulnerability
                            ) => (
                              <div
                                key={vulnerability}
                                className="rounded-2xl border border-slate-200 bg-slate-50 p-4 text-sm leading-6 text-slate-600"
