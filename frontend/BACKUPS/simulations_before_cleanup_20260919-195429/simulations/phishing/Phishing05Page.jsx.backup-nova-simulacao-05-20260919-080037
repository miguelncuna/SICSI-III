function formatReportTime(milliseconds = 0) {
  const totalSeconds = Math.max(
    0,
    Math.round(
      Number(milliseconds || 0) / 1000
    )
  );

  const minutes = Math.floor(
    totalSeconds / 60
  );

  const seconds =
    totalSeconds % 60;

  if (minutes === 0) {
    return `${seconds}s`;
  }

  return `${minutes}m ${String(
    seconds
  ).padStart(2, "0")}s`;
}

function formatReportDate(value) {
  if (!value) {
    return "—";
  }

  const date = new Date(value);

  if (Number.isNaN(date.getTime())) {
    return "—";
  }

  return date.toLocaleString(
    "pt-PT",
    {
      day: "2-digit",
      month: "2-digit",
      year: "numeric",
      hour: "2-digit",
      minute: "2-digit",
    }
  );
}

function buildGeneralPhishingReport(events = []) {

  const simulations = [1, 2, 3, 4, 5].map(
    (number) => {

      const simulationEvents =
        events.filter(
          (event) =>
            Number(
              event?.simulation_number
            ) === number
        );

      const safe =
        simulationEvents.filter(
          (event) =>
            classifyPhishingReportAction(
              event.action
            ) === "safe"
        );

      const risk =
        simulationEvents.filter(
          (event) =>
            classifyPhishingReportAction(
              event.action
            ) === "risk"
        );

      const neutral =
        simulationEvents.filter(
          (event) =>
            classifyPhishingReportAction(
              event.action
            ) === "neutral"
        );

      const timeMs =
        simulationEvents.reduce(
          (total, event) =>
            total +
            Math.max(
              0,
              Number(
                event?.duration_ms || 0
              )
            ),
          0
        );

      const vulnerabilities = [];

      risk.forEach((event) => {

        const vulnerability =
          getPersonalVulnerability(
            event.action
          );

        if (
          !vulnerabilities.includes(
            vulnerability
          )
        ) {
          vulnerabilities.push(
            vulnerability
          );
        }
      });

      const recommendations = [];

      risk.forEach((event) => {

        const recommendation =
          getImprovementRecommendation(
            event.action
          );

        if (
          !recommendations.includes(
            recommendation
          )
        ) {
          recommendations.push(
            recommendation
          );
        }
      });

      return {
        number,
        title:
          getPhishingSimulationInfo(
            number
          ).title,
        shortTitle:
          getPhishingSimulationInfo(
            number
          ).shortTitle,

        events:
          simulationEvents,

        safe,
        risk,
        neutral,

        timeMs,

        vulnerabilities:
          vulnerabilities.slice(0, 4),

        recommendations:
          recommendations.slice(0, 4),
      };
    }
  );

  const safeTotal =
    simulations.reduce(
      (total, simulation) =>
        total +
        simulation.safe.length,
      0
    );

  const riskTotal =
    simulations.reduce(
      (total, simulation) =>
        total +
        simulation.risk.length,
      0
    );

  const neutralTotal =
    simulations.reduce(
      (total, simulation) =>
        total +
        simulation.neutral.length,
      0
    );

  const totalDuration =
    simulations.reduce(
      (total, simulation) =>
        total +
        simulation.timeMs,
      0
    );

  return {
    events,
    simulations,
    safeTotal,
    riskTotal,
    neutralTotal,
    totalDuration,
  };
}

function getOverallJourneyMessage(report) {

  if (
    report.events.length === 0
  ) {
    return {
      title: "O percurso ainda não contém dados suficientes.",
      body: "Complete as cinco experiências para obter uma análise personalizada."
    };
  }

  if (
    report.riskTotal === 0 &&
    report.safeTotal > 0
  ) {
    return {
      title: "O teu percurso mostra um comportamento muito cuidadoso.",
      body: "As decisões registadas mostram preferência por verificar, recusar, sair ou reportar antes de avançar."
    };
  }

  if (
    report.safeTotal >=
    report.riskTotal
  ) {
    return {
      title: "O teu percurso mostra uma boa base de segurança.",
      body: "Na maioria das situações registadas, adoptaste comportamentos protectores. Há ainda alguns pontos que merecem atenção."
    };
  }

  return {
    title: "O percurso mostra oportunidades claras de melhoria.",
    body: "Existiram decisões que aumentaram a exposição. A boa notícia é que cada uma delas aponta para um comportamento concreto que pode ser melhorado."
  };
}

function JourneyReportView({
  events = [],
  onBack,
  onClose,
  onDownload,
}) {
  const report =
    buildGeneralPhishingReport(events);

  const message =
    getOverallJourneyMessage(report);

  const [participant, setParticipant] =
    useState("Participante");

  useEffect(() => {
    try {
      const raw =
        localStorage.getItem("sicsi_user");

      if (!raw) {
        return;
      }

      const stored =
        JSON.parse(raw);

      const name =
        stored?.name ||
        stored?.full_name ||
        stored?.fullName ||
        stored?.username ||
        stored?.email ||
        "";

      if (name) {
        setParticipant(String(name));
      }
    } catch {
      // O relatório continua disponível.
    }
  }, []);

  function cleanText(
    value,
    fallback = "Sem informação adicional."
  ) {
    const text = String(value ?? "")
      .replace(/\s+/g, " ")
      .trim();

    return text || fallback;
  }

  function limitText(
    value,
    max = 260
  ) {
    const text = cleanText(value);

    if (text.length <= max) {
      return text;
    }

    return `${text.slice(0, max - 1).trimEnd()}…`;
  }

  function getSimulationSummary(
    simulation
  ) {
    const safeCount =
      Array.isArray(simulation.safe)
        ? simulation.safe.length
        : 0;

    const riskCount =
      Array.isArray(simulation.risk)
        ? simulation.risk.length
        : 0;

    if (
      riskCount === 0 &&
      safeCount > 0
    ) {
      return (
        "As decisões tomadas nesta situação demonstraram capacidade de reconhecer sinais relevantes e reduzir a exposição."
      );
    }

    if (riskCount >= 2) {
      return (
        "Foram identificadas escolhas com potencial para aumentar significativamente a exposição perante uma ameaça semelhante."
      );
    }

    if (riskCount === 1) {
      return (
        "O percurso foi globalmente controlado, mas existiu uma escolha que poderia aumentar a exposição."
      );
    }

    return (
      "Esta situação apresenta comportamentos que devem ser consolidados para reduzir riscos semelhantes no futuro."
    );
  }

  function getDecisionItems(
    items,
    type,
    maximum = 2
  ) {
    if (!Array.isArray(items)) {
      return [];
    }

    return items
      .slice(0, maximum)
      .map((event) => ({
        title: limitText(
          getPhishingReportActionLabel(
            event.action
          ),
          120
        ),
        consequence: limitText(
          getDecisionConsequence(
            event.action,
            type
          ),
          240
        ),
      }));
  }

  function getPotentialOutcomes(
    simulation
  ) {
    const risks =
      Array.isArray(simulation.risk)
        ? simulation.risk
        : [];

    const outcomes = risks
      .slice(0, 2)
      .map((event) =>
        limitText(
          getDecisionConsequence(
            event.action,
            "risk"
          ),
          260
        )
      )
      .filter(Boolean);

    if (outcomes.length > 0) {
      return outcomes;
    }

    return [
      "A decisão protectora reduziu a probabilidade de comprometimento da conta, dos dados ou de outros recursos envolvidos."
    ];
  }

  function safeList(
    values,
    fallback
  ) {
    if (!Array.isArray(values) ||
        values.length === 0) {
      return [fallback];
    }

    return values
      .slice(0, 2)
      .map((value) =>
        limitText(value, 230)
      );
  }

  function handleDownloadPdf() {
    if (
      typeof onDownload === "function"
    ) {
      onDownload();
    }

    const simulations =
      Array.isArray(report.simulations)
        ? report.simulations
        : [];

    const fixedSimulations =
      Array.from(
        { length: 5 },
        (_, index) =>
          simulations[index] || {
            number: index + 1,
            title:
              `Simulação ${String(
                index + 1
              ).padStart(2, "0")}`,
            safe: [],
            risk: [],
            vulnerabilities: [],
            recommendations: [],
          }
      );

    const doc = new jsPDF({
      orientation: "portrait",
      unit: "mm",
      format: "a4",
    });

    const pageWidth =
      doc.internal.pageSize.getWidth();

    const pageHeight =
      doc.internal.pageSize.getHeight();

    const margin = 15;
    const width =
      pageWidth - margin * 2;

    function wrap(
      value,
      size = 8.2
    ) {
      doc.setFontSize(size);

      return doc.splitTextToSize(
        cleanText(value),
        width - 8
      );
    }

    function heading(
      title,
      y,
      dark = false
    ) {
      if (dark) {
        doc.setFillColor(
          30,
          64,
          175
        );

        doc.setTextColor(
          255,
          255,
          255
        );
      }
      else {
        doc.setFillColor(
          239,
          246,
          255
        );

        doc.setTextColor(
          30,
          64,
          175
        );
      }

      doc.roundedRect(
        margin,
        y,
        width,
        8,
        2,
        2,
        "F"
      );

      doc.setFont(
        "helvetica",
        "bold"
      );

      doc.setFontSize(9);

      doc.text(
        title,
        margin + 4,
        y + 5.4
      );

      return y + 12;
    }

    function paragraph(
      value,
      y,
      size = 8.2,
      colour = [71, 85, 105]
    ) {
      const lines =
        wrap(value, size);

      doc.setFont(
        "helvetica",
        "normal"
      );

      doc.setFontSize(size);

      doc.setTextColor(
        colour[0],
        colour[1],
        colour[2]
      );

      doc.text(
        lines,
        margin + 3,
        y
      );

      return (
        y +
        lines.length * 3.35 +
        3
      );
    }

    function decisionCard(
      decision,
      y,
      safe
    ) {
      const titleLines =
        wrap(
          decision.title,
          8.3
        );

      const consequenceLines =
        wrap(
          decision.consequence,
          7.9
        );

      const height =
        Math.max(
          21,
          8 +
          titleLines.length * 2.45 +
          consequenceLines.length * 3.15
        );

      doc.setFillColor(
        safe ? 239 : 255,
        safe ? 246 : 247,
        safe ? 255 : 237
      );

      doc.setDrawColor(
        safe ? 191 : 253,
        safe ? 219 : 230,
        safe ? 254 : 200
      );

      doc.roundedRect(
        margin,
        y,
        width,
        height,
        2,
        2,
        "FD"
      );

      doc.setFont(
        "helvetica",
        "bold"
      );

      doc.setFontSize(8.3);

      doc.setTextColor(
        safe ? 30 : 154,
        safe ? 64 : 52,
        safe ? 175 : 18
      );

      doc.text(
        titleLines,
        margin + 4,
        y + 3.8
      );

      doc.setFont(
        "helvetica",
        "normal"
      );

      doc.setFontSize( 7.1);

      doc.setTextColor(
        71,
        85,
        105
      );

      doc.text(
        consequenceLines,
        margin + 4,
        y +
          5 +
          titleLines.length * 2.45 +
          2
      );

      return y + height + 1.2;
    }

    function simpleCard(
      value,
      y,
      mode = "neutral"
    ) {
      const lines =
        wrap(value, 7.2);

      const height =
        Math.max(9.5,
          lines.length * 2.45 + 4.5
        );

      if (mode === "risk") {
        doc.setFillColor(
          255,
          247,
          237
        );
      }
      else if (mode === "outcome") {
        doc.setFillColor(
          254,
          242,
          242
        );
      }
      else {
        doc.setFillColor(
          248,
          250,
          252
        );
      }

      doc.setDrawColor(
        226,
        232,
        240
      );

      doc.roundedRect(
        margin,
        y,
        width,
        height,
        2,
        2,
        "FD"
      );

      doc.setFont(
        "helvetica",
        "normal"
      );

      doc.setFontSize( 7.2);

      doc.setTextColor(
        71,
        85,
        105
      );

      doc.text(
        lines,
        margin + 4,
        y + 5
      );

      return y + height + 1.2;
    }

    fixedSimulations.forEach(
      (simulation, index) => {

        if (index > 0) {
          doc.addPage();
        }

        let y = 8;

        doc.setFillColor(
          30,
          64,
          175
        );

        doc.roundedRect(
          margin,
          y,
          width,
          27,
          3,
          3,
          "F"
        );

        doc.setFont(
          "helvetica",
          "bold"
        );

        doc.setTextColor(
          219,
          234,
          254
        );

        doc.setFontSize(7);

        doc.text(
          "SICSI · SEGURANÇA DA INFORMAÇÃO",
          margin + 5,
          y + 6
        );

        doc.setFontSize(15);

        doc.setTextColor(
          255,
          255,
          255
        );

        doc.text(
          `Simulação ${String(
            simulation.number
          ).padStart(2, "0")} · ${cleanText(
            simulation.title,
            "Experiência de Phishing"
          )}`,
          margin + 5,
          y + 14.5
        );

        doc.setFontSize(7);

        doc.setTextColor(
          219,
          234,
          254
        );

        doc.text(
          `Participante: ${limitText(
            participant,
            90
          )}`,
          margin + 5,
          y + 22
        );

        y += 34;

        y = heading(
          "Resumo da situação",
          y,
          true
        );

        y = paragraph(
          getSimulationSummary(
            simulation
          ),
          y,
          8.3,
          [51, 65, 85]
        );

        const safeDecisions =
          getDecisionItems(
            simulation.safe,
            "safe"
          );

        const riskDecisions =
          getDecisionItems(
            simulation.risk,
            "risk"
          );

        y = heading(
          "Decisões certas",
          y
        );

        if (
          safeDecisions.length > 0
        ) {
          safeDecisions.forEach(
            (decision) => {
              y = decisionCard(
                decision,
                y,
                true
              );
            }
          );
        }
        else {
          y = simpleCard(
            "Não foram identificadas decisões claramente protectoras para destacar nesta etapa.",
            y
          );
        }

        y = heading(
          "Decisões e exposições",
          y
        );

        if (
          riskDecisions.length > 0
        ) {
          riskDecisions.forEach(
            (decision) => {
              y = decisionCard(
                decision,
                y,
                false
              );
            }
          );
        }
        else {
          y = simpleCard(
            "Não foram identificadas exposições relevantes para destacar nesta etapa.",
            y
          );
        }

        y = heading(
          "O que poderia ter acontecido",
          y
        );

        getPotentialOutcomes(
          simulation
        )
          .slice(0, 2)
          .forEach((outcome) => {
            y = simpleCard(
              outcome,
              y,
              "outcome"
            );
          });

        y = heading(
          "Vulnerabilidades pessoais",
          y
        );

        safeList(
          simulation.vulnerabilities,
          "Não foram identificadas vulnerabilidades pessoais relevantes nesta etapa."
        )
          .slice(0, 2)
          .forEach((item) => {
            y = simpleCard(
              item,
              y
            );
          });

        y = heading(
          "Melhorias e recomendações",
          y
        );

        safeList(
          simulation.recommendations,
          "Continue a confirmar a origem das solicitações antes de agir."
        )
          .slice(0, 2)
          .forEach((item) => {
            y = simpleCard(
              item,
              y
            );
          });

        doc.setDrawColor(
          226,
          232,
          240
        );

        doc.line(
          margin,
          pageHeight - 13,
          pageWidth - margin,
          pageHeight - 13
        );

        doc.setFont(
          "helvetica",
          "normal"
        );

        doc.setFontSize(7);

        doc.setTextColor(
          100,
          116,
          139
        );

        doc.text(
          "SICSI III · Relatório individual da jornada de Phishing",
          margin,
          pageHeight - 7
        );

        doc.text(
          `${index + 1} / 5`,
          pageWidth - margin,
          pageHeight - 7,
          {
            align: "right",
          }
        );
      }
    );

    doc.save(
      "relatorio-phishing-sicsi-iii.pdf"
    );
  }

  function handleFinish() {
    try {
      if (
        typeof onClose === "function"
      ) {
        onClose();
        return;
      }
    } catch {
      // A navegação continua.
    }

    if (
      typeof onBack === "function"
    ) {
      onBack();
    }
  }

  return (
    <div className="min-h-screen bg-slate-50">

      <header className="border-b border-slate-200 bg-white">
        <div className="mx-auto max-w-7xl px-4 py-7 sm:px-6 lg:px-8">

