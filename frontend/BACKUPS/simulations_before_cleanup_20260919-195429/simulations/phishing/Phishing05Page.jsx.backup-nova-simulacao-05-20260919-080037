  );
}

export default function Phishing05Page() {
  const navigate = useNavigate();
  const { user } = useAuth();

  const accountEmail = getAccountEmail(user);

  const [state, setState] = useState(STATES.HOME);
  const [password, setPassword] = useState("");
  const [mfaCode, setMfaCode] = useState("");
  const [events, setEvents] = useState([]);
  const [startedAt, setStartedAt] = useState(Date.now());
  const [elapsed, setElapsed] = useState(0);
  const [sessionReady, setSessionReady] = useState(false);

  useEffect(() => {
    const current = getCurrentSimulation();

    if (
      current &&
      current.simulation_id === SIMULATION.id &&
      !current.completed
    ) {
      setStartedAt(
        current.started_at
          ? new Date(current.started_at).getTime()
          : Date.now()
      );
    } else {
      const session = startSimulation({
        area: SIMULATION.area,
        simulationId: SIMULATION.id,
        simulationNumber: SIMULATION.number,
        initialState: STATES.HOME,
      });

      setStartedAt(
        session?.started_at
          ? new Date(session.started_at).getTime()
          : Date.now()
      );

      registerAction({
        action: "simulation_started",
        nextState: STATES.HOME,
        interactionType: "system",
        metadata: {
          simulation_id: SIMULATION.id,
          simulation_number: SIMULATION.number,
          title: SIMULATION.title,
        },
      });
    }

    setSessionReady(true);
  }, []);

  useEffect(() => {
    if (!sessionReady) {
      return undefined;
    }

    const timer = window.setInterval(() => {
      setElapsed(Date.now() - startedAt);
    }, 1000);

    return () => window.clearInterval(timer);
  }, [sessionReady, startedAt]);

  useEffect(() => {
    const timer = window.setTimeout(() => {
      try {
        const stored = JSON.parse(
          localStorage.getItem("sicsi_simulation_events") || "[]"
        );

        const session = getCurrentSimulation();

        if (session?.session_id) {
          setEvents(
            stored.filter(
              (event) => event.session_id === session.session_id
            )
          );
        }
      } catch {
        setEvents([]);
      }
    }, 50);

    return () => window.clearTimeout(timer);
  }, [state]);

  function track(action, nextState, interactionType = "interaction", metadata = {}) {
    const result = registerAction({
      action,
      nextState,
      interactionType,
      metadata,
    });

    if (result?.event) {
      setEvents((current) => [...current, result.event]);
    }

    return result;
  }

  function go(nextState, action, metadata = {}) {
    track(action, nextState, "navigation", metadata);
    setState(nextState);
  }

  function openLogin() {
    go(STATES.LOGIN, "open_academic_login");
  }

  function openSecurity() {
    go(STATES.SECURITY_NOTICE, "open_account_security");
  }

  function openActivity() {
    go(STATES.ACTIVITY, "open_account_activity");
  }

  function submitLogin() {
    track(
      "submit_academic_credentials",
      STATES.LOGIN_PROCESSING,
      "form_submit",
      {
        account: accountEmail,
        password_entered: Boolean(password),
      }
    );

    setPassword("");
    setState(STATES.LOGIN_PROCESSING);

    window.setTimeout(() => {
      track(
        "authentication_challenge_requested",
        STATES.MFA,
        "system",
        {
          challenge_type: "mfa",
        }
      );

      setState(STATES.MFA);
    }, 650);
  }

  function continueMfa() {
    track(
      "submit_mfa_challenge",
      STATES.ACCOUNT_HOME,
      "form_submit",
      {
        mfa_code_entered: Boolean(mfaCode),
        secret_stored: false,
      }
    );

    setMfaCode("");
    setState(STATES.ACCOUNT_HOME);
  }

  function useAlternativeMfa() {
    track(
      "select_alternative_mfa_method",
      STATES.RECOVERY,
      "selection",
      {
        method: "account_recovery",
      }
    );

    setMfaCode("");
    setState(STATES.RECOVERY);
  }

  function openAccountActivity() {
    go(STATES.ACTIVITY, "open_account_activity_from_session");
  }

  function openDevices() {
    go(STATES.DEVICES, "open_account_devices");
  }

  function openRecovery() {
    go(STATES.RECOVERY, "open_account_recovery");
  }

  function openSessionDetail() {
    go(STATES.SESSION_DETAIL, "open_current_session");
  }

  function continueRecovery() {
    track(
      "select_account_recovery_option",
      STATES.SECURITY_RESULT,
      "selection",
      {
        method: "institutional_recovery",
      }
    );

    setState(STATES.SECURITY_RESULT);
  }

  function continueSecurityNotice() {
    go(STATES.ACCOUNT_HOME, "continue_security_review");
  }

  function continueSessionSecurity() {
    track(
      "review_current_session_security",
      STATES.SECURITY_RESULT,
      "interaction",
      {
        session_reviewed: true,
      }
    );

    setState(STATES.SECURITY_RESULT);
  }
  function openFeedback() {
    registerAction({
      action: "finish_simulation_and_view_journey",
      nextState: STATES.FEEDBACK,
      interactionType: "navigation",
      metadata: {
        source: "phishing-05",
        destination: "journey-report",
      },
    });

    completeSimulation();

    setState(STATES.FEEDBACK);
  }

  function getCurrentEvents() {
    try {
      const stored = JSON.parse(
        localStorage.getItem("sicsi_simulation_events") || "[]"
      );

      const session = getCurrentSimulation();

      if (!session?.session_id) {
        return [];
      }

      return stored.filter(
        (event) => event.session_id === session.session_id
      );
    } catch {
      return [];
    }
  }

  function completeAndClose() {
    track(
      "end_simulation",
      STATES.COMPLETED,
      "navigation",
      {
        destination: "/student/simulacoes",
      }
    );

    completeSimulation();
    completeSimulationSession();

    setState(STATES.COMPLETED);
  }

  function closeFromCompleted() {
    const session = getCurrentSimulation();

    if (session?.session_id) {
      clearSessionEvents(session.session_id);
    }

    navigate("/student/simulacoes");
  }

  function returnToAccount() {
    track(
      "return_to_account",
      STATES.ACCOUNT_HOME,
      "navigation"
    );

    setState(STATES.ACCOUNT_HOME);
  }

  function returnToHome() {
    track(
      "return_to_academic_portal",
      STATES.HOME,
      "navigation"
    );

    setState(STATES.HOME);
  }

  function renderState() {
    if (state === STATES.HOME) {
      return (
        <AcademicHome
          account={accountEmail}
          onLogin={openLogin}
          onSecurity={openSecurity}
          onActivity={openActivity}
        />
      );
    }

    if (state === STATES.LOGIN) {
      return (
        <LoginView
          account={accountEmail}
          password={password}
          setPassword={setPassword}
          onSubmit={submitLogin}
          onBack={returnToHome}
          onRecovery={openRecovery}
        />
      );
    }

    if (state === STATES.LOGIN_PROCESSING) {
      return <LoginProcessingView />;
    }

    if (state === STATES.MFA) {
      return (
        <MfaView
          code={mfaCode}
          setCode={setMfaCode}
          onContinue={continueMfa}
          onBack={() => {
            track(
              "return_to_login_from_mfa",
              STATES.LOGIN,
              "navigation"
            );

            setState(STATES.LOGIN);
          }}
          onAlternative={useAlternativeMfa}
        />
      );
    }

    if (state === STATES.SECURITY_NOTICE) {
      return (
        <SecurityNoticeView
          onContinue={continueSecurityNotice}
          onBack={returnToHome}
        />
      );
    }

    if (state === STATES.ACCOUNT_HOME) {
      return (
        <AccountHomeView
          account={accountEmail}
          onActivity={openAccountActivity}
          onDevices={openDevices}
          onRecovery={openRecovery}
          onFinish={openFeedback}
        />
      );
    }

    if (state === STATES.ACTIVITY) {
      return (
        <ActivityView
          onBack={returnToAccount}
          onSession={openSessionDetail}
        />
      );
    }

    if (state === STATES.DEVICES) {
      return (
        <DevicesView
          onBack={returnToAccount}
          onSession={openSessionDetail}
          onRecovery={openRecovery}
        />
      );
    }

    if (state === STATES.RECOVERY) {
      return (
        <RecoveryView
          onBack={returnToAccount}
          onContinue={continueRecovery}
        />
      );
    }

    if (state === STATES.SESSION_DETAIL) {
      return (
        <SessionDetailView
          onBack={returnToAccount}
          onSecurity={continueSessionSecurity}
        />
      );
    }

    if (state === STATES.SECURITY_RESULT) {
      return (
        <SecurityResultView
          onBack={returnToAccount}
          onFeedback={openFeedback}
        />
      );
    }

    if (state === STATES.FEEDBACK) {
      return (
        <JourneyReportView
          events={readAllPhishingJourneyEvents()}
          onBack={returnToAccount}
          onClose={completeAndClose}
          onDownload={() => {
            registerAction({
              action: "download_general_report",
              nextState: STATES.FEEDBACK,
              interactionType: "download",
              metadata: {
                format: "html",
              },
            });
          }}
        />
      );
    }

    if (state === STATES.COMPLETED) {
      return (
        <CompletedView
          events={getCurrentEvents()}
          duration={elapsed}
          onFeedback={() => {
            const currentEvents = getCurrentEvents();

            track(
              "open_general_report",
              STATES.FEEDBACK,
              "navigation",
              {
                event_count: currentEvents.length,
              }
            );

            setState(STATES.FEEDBACK);
          }}
          onClose={closeFromCompleted}
        />
      );
    }

    return (
      <AcademicHome
        account={accountEmail}
        onLogin={openLogin}
        onSecurity={openSecurity}
        onActivity={openActivity}
      />
    );
  }

  if (!sessionReady) {
    return (
      <Shell title="Conta académica">
        <main className="flex min-h-[calc(100vh-4rem)] items-center justify-center px-4">
          <div className="text-center">
            <RefreshCw
              size={25}
              className="mx-auto animate-spin text-blue-700"
            />
            <div className="mt-4 text-sm font-semibold text-slate-500">
              A preparar a simulação...
            </div>
          </div>
        </main>
      </Shell>
    );
  }

  return renderState();
}


