              </div>
            </div>

          </div>

        </div>
      </header>

      <main className="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">

        <section className="rounded-3xl bg-gradient-to-br from-blue-900 via-blue-800 to-blue-600 p-7 text-white shadow-xl sm:p-9">

          <div className="max-w-4xl">

            <div className="text-xs font-black uppercase tracking-[0.18em] text-blue-100">
              Visão geral
            </div>

            <h2 className="mt-2 text-2xl font-black sm:text-3xl">
              {message.title}
            </h2>

            <p className="mt-3 text-sm leading-7 text-blue-50">
              {message.body}
            </p>

          </div>

        </section>

        <section className="mt-8 space-y-6">

          {report.simulations.map(
            (simulation) => {

              const safeDecisions =
                getDecisionItems(
                  simulation.safe,
                  "safe"
                );

              const riskDecisions =
                getDecisionItems(
                  simulation.risk,
                  "risk"
                );

              const outcomes =
                getPotentialOutcomes(
                  simulation
                );

              return (
                <article
                  key={simulation.number}
                  className="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm"
                >

                  <div className="bg-gradient-to-r from-blue-50 via-white to-white px-6 py-6 sm:px-8">

                    <div className="text-xs font-black uppercase tracking-[0.18em] text-blue-700">
                      Simulação{" "}
                      {String(
                        simulation.number
                      ).padStart(2, "0")}
                    </div>

                    <h2 className="mt-1 text-2xl font-black text-slate-900">
                      {simulation.title}
                    </h2>

                    <p className="mt-2 max-w-4xl text-sm leading-7 text-slate-600">
                      {getSimulationSummary(
                        simulation
                      )}
                    </p>

                  </div>

                  <div className="grid gap-5 p-6 sm:p-8 lg:grid-cols-2">

                    <section>

                      <h3 className="text-sm font-black uppercase tracking-wide text-blue-800">
                        Decisões certas
                      </h3>

                      <div className="mt-4 space-y-3">

                        {safeDecisions.length > 0 ? (
                          safeDecisions.map(
                            (
                              decision,
                              index
                            ) => (
                              <div
                                key={`safe-${simulation.number}-${index}`}
                                className="rounded-2xl border border-blue-100 bg-blue-50/70 p-4"
                              >
                                <div className="font-bold text-slate-800">
                                  {decision.title}
                                </div>

                                <p className="mt-2 text-sm leading-6 text-slate-600">
                                  {decision.consequence}
                                </p>
                              </div>
                            )
                          )
                        ) : (
                          <div className="rounded-2xl bg-slate-50 p-5 text-sm leading-6 text-slate-500">
                            Não foram identificadas decisões claramente protectoras para destacar nesta etapa.
                          </div>
                        )}

                      </div>

                    </section>

                    <section>

                      <h3 className="text-sm font-black uppercase tracking-wide text-amber-800">
                        Decisões e exposições
                      </h3>

                      <div className="mt-4 space-y-3">

                        {riskDecisions.length > 0 ? (
                          riskDecisions.map(
                            (
                              decision,
                              index
