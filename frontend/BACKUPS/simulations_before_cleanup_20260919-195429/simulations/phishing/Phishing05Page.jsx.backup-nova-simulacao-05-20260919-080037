function readAllPhishingJourneyEvents() {
  try {
    const raw = localStorage.getItem(
      "sicsi_simulation_events"
    );

    if (!raw) {
      return [];
    }

    const parsed = JSON.parse(raw);

    if (!Array.isArray(parsed)) {
      return [];
    }

    return parsed
      .filter((event) =>
        String(
          event?.simulation_id || ""
        ).startsWith("phishing-")
      )
      .sort((a, b) => {
        const aTime = new Date(
          a?.timestamp || 0
        ).getTime();

        const bTime = new Date(
          b?.timestamp || 0
        ).getTime();

        return aTime - bTime;
      });
  } catch {
    return [];
  }
}

