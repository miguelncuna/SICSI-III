    "return",
    "back",
    "alternative",
    "recover",
    "archive",
    "delete",
    "logout",
    "close",
  ];

  const riskPatterns = [
    "open_link",
    "external",
    "password_entered",
    "mfa_code_entered",
    "credential",
    "submit",
    "confirm_payment",
    "beneficiary",
    "apply_external",
    "share_external",
    "download",
    "installer",
    "activator",
    "approve",
    "upload",
    "reply_email",
    "forward_email",
  ];

  if (
    safePatterns.some((pattern) =>
      value.includes(pattern)
    )
  ) {
    return "safe";
  }

  if (
    riskPatterns.some((pattern) =>
      value.includes(pattern)
    )
  ) {
    return "risk";
  }

  return "neutral";
}

function getDecisionConsequence(action = "", type = "neutral") {
  const value = String(action)
    .trim()
    .toLowerCase();

  if (type === "safe") {

    if (
      value.includes("inspect") ||
      value.includes("verify")
    ) {
      return "Ao verificar antes de avançar, reduziu a possibilidade de cair numa armadilha e protegeu os seus dados.";
    }

    if (value.includes("report")) {
      return "Ao reportar a situação, interrompeu o risco e ajudou a sinalizar uma tentativa suspeita.";
    }

    if (
      value.includes("refuse") ||
      value.includes("reject") ||
      value.includes("decline")
    ) {
      return "Ao recusar, evitou dar continuidade a uma acção que poderia expor a sua conta, informação ou dinheiro.";
    }

    if (
      value.includes("cancel") ||
      value.includes("leave")
    ) {
      return "Ao sair sem concluir a operação, evitou aumentar a exposição.";
    }

    return "Esta decisão reduziu a possibilidade de exposição e manteve o controlo da situação.";
  }

  if (type === "risk") {

    if (
      value.includes("password_entered") ||
      value.includes("credential")
    ) {
      return "A consequência poderia ser a utilização indevida das credenciais, permitindo acesso à conta e aos dados associados.";
    }

    if (
      value.includes("mfa_code_entered")
    ) {
      return "Um código de verificação entregue a terceiros poderia permitir concluir uma autenticação que não foi iniciada por si.";
    }

    if (
      value.includes("open_link")
    ) {
      return "A ligação poderia conduzir a uma página falsa, recolher dados ou iniciar uma acção prejudicial.";
    }

    if (
      value.includes("confirm_payment") ||
      value.includes("beneficiary")
    ) {
      return "A consequência poderia ser uma transferência indevida, perda financeira ou alteração de quem recebe o dinheiro.";
    }

    if (
      value.includes("external") ||
      value.includes("share")
    ) {
      return "A informação poderia ficar acessível a pessoas ou serviços que não deveriam recebê-la.";
    }

    if (
      value.includes("download") ||
      value.includes("installer") ||
      value.includes("activator")
    ) {
      return "O ficheiro poderia instalar software malicioso, comprometer o dispositivo ou permitir acesso indevido.";
    }

    if (
      value.includes("reply") ||
      value.includes("forward")
    ) {
      return "A resposta poderia confirmar que a conta está activa ou ajudar a espalhar a tentativa para outras pessoas.";
    }

    if (value.includes("submit")) {
      return "A informação submetida poderia ser utilizada para obter acesso ou continuar a tentativa de fraude.";
    }

    return "Esta decisão aumentou a exposição e poderia facilitar uma situação de fraude ou acesso indevido.";
  }

  return "Não foi identificada uma consequência de risco directa para esta interacção.";
}

