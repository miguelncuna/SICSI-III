  }

  if (value.includes("open_link")) {
    return "Pare e confirme o endereço antes de abrir uma ligação recebida por mensagem.";
  }

  if (
    value.includes("confirm_payment") ||
    value.includes("beneficiary")
  ) {
    return "Confirme beneficiário, valor e motivo da operação através de um canal independente.";
  }

  if (
    value.includes("external") ||
    value.includes("share")
  ) {
