function formatDuration(milliseconds) {
  const seconds = Math.max(0, Math.floor(milliseconds / 1000));

  if (seconds < 60) {
    return `${seconds}s`;
  }

  const minutes = Math.floor(seconds / 60);
  const remaining = seconds % 60;

  return `${minutes}m ${remaining}s`;
}

function createInitialSession() {
  const existing = getCurrentSimulation();

  if (
    existing &&
    existing.simulation_id === SIMULATION.id &&
    !existing.completed
  ) {
    return existing;
  }

  const session = startSimulation({
    area: SIMULATION.area,
    simulationId: SIMULATION.id,
    simulationNumber: SIMULATION.number,
    initialState: STATES.PAYMENT_HOME,
  });

  registerAction({
    action: "simulation_started",
    nextState: STATES.PAYMENT_HOME,
    interactionType: "lifecycle",
    metadata: {
      title: SIMULATION.title,
    },
  });

  return getCurrentSimulation() || session;
}

