export default function Phishing03Page() {
  const navigate = useNavigate();
  const { user } = useAuth();

  const accountName =
    user?.name ||
    user?.full_name ||
    user?.displayName ||
    user?.username ||
    "Titular da conta";

  const accountEmail =
    user?.email ||
    user?.username ||
    "";

  const [state, setState] = useState(STATES.PAYMENT_HOME);
  const [senderInspection, setSenderInspection] = useState(false);
  const [beneficiaryInspection, setBeneficiaryInspection] =
    useState(false);
  const [authorisationInspection, setAuthorisationInspection] =
    useState(false);
  const [officialChecked, setOfficialChecked] = useState(false);
  const [authorisationCode, setAuthorisationCode] = useState("");
  const [sessionStartedAt, setSessionStartedAt] = useState(Date.now());
  const [duration, setDuration] = useState("0s");
  const [mobileMenu, setMobileMenu] = useState(false);

  const currentSession = useMemo(
    () => getCurrentSimulation(),
    [state]
  );

  useEffect(() => {
    const session = createInitialSession();

    if (session?.current_state) {
      setState(session.current_state);
    }

    setSessionStartedAt(
      session?.started_at
        ? new Date(session.started_at).getTime()
        : Date.now()
    );
  }, []);

  useEffect(() => {
    const interval = window.setInterval(() => {
      setDuration(
        formatDuration(
          Date.now() - sessionStartedAt
        )
      );
    }, 1000);

    return () => window.clearInterval(interval);
  }, [sessionStartedAt]);

  function transition({
    action,
    nextState,
    interactionType = "interaction",
    metadata = {},
  }) {
    registerAction({
      action,
      nextState,
      interactionType,
      metadata,
    });

    setState(nextState);
    setMobileMenu(false);
  }

  function openPayment() {
    transition({
      action: "open_pending_payment",
      nextState: STATES.PAYMENT_DETAILS,
      interactionType: "navigation",
      metadata: {
        reference: PAYMENT.reference,
        amount: PAYMENT.amountNumeric,
      },
    });
  }

  function inspectPaymentFromHome() {
    transition({
      action: "inspect_pending_payment",
      nextState: STATES.PAYMENT_DETAILS,
      interactionType: "inspection",
      metadata: {
        source: "payment_home",
        reference: PAYMENT.reference,
      },
    });
  }

  function verifyBeneficiary() {
    transition({
      action: "open_beneficiary_verification",
      nextState: STATES.BENEFICIARY_VERIFICATION,
      interactionType: "inspection",
      metadata: {
        target: "beneficiary",
      },
    });
  }

  function continueBeneficiaryVerification() {
    transition({
      action: "continue_beneficiary_verification",
      nextState: STATES.BENEFICIARY_CHANGED,
      interactionType: "verification",
      metadata: {
        beneficiary_comparison: true,
      },
    });
  }

  function openBeneficiaryInspection() {
    transition({
      action: beneficiaryInspection
        ? "collapse_beneficiary_data"
        : "expand_beneficiary_data",
      nextState: STATES.BENEFICIARY_VERIFICATION,
      interactionType: "inspection",
      metadata: {
        target: "payment_data",
      },
    });

    setBeneficiaryInspection((value) => !value);
  }

  function goToConfirmation() {
    transition({
      action: "proceed_to_payment_confirmation",
      nextState: STATES.PAYMENT_CONFIRMATION,
      interactionType: "navigation",
      metadata: {
        beneficiary: PAYMENT.beneficiaryChanged,
        amount: PAYMENT.amountNumeric,
      },
    });
  }

  function goBackToPaymentDetails() {
    transition({
      action: "return_to_payment_details",
      nextState: STATES.PAYMENT_DETAILS,
      interactionType: "navigation",
    });
  }

  function goBackToBeneficiaryVerification() {
    transition({
      action: "return_to_beneficiary_verification",
      nextState: STATES.BENEFICIARY_VERIFICATION,
      interactionType: "navigation",
    });
  }

  function openAuthorisation() {
    transition({
      action: "open_payment_authorisation",
      nextState: STATES.PAYMENT_AUTHENTICATION,
      interactionType: "authentication",
      metadata: {
        authentication_required: true,
      },
    });
  }

  function submitAuthorisation(event) {
    event.preventDefault();

    if (!authorisationCode.trim()) {
      return;
    }

    transition({
      action: "submit_authorisation_code",
      nextState: STATES.PAYMENT_PROCESSING,
      interactionType: "credentials",
      metadata: {
        authorisation_code_entered: true,
        authorisation_code_content: "[REDACTED]",
        content_stored: false,
      },
    });

    setAuthorisationCode("");

    window.setTimeout(() => {
      transition({
        action: "payment_processing_completed",
        nextState: STATES.PAYMENT_RECEIPT,
        interactionType: "system",
        metadata: {
          reference: PAYMENT.reference,
          result: "pending_analysis",
        },
      });
    }, 1800);
  }

  function cancelOperation(sourceState) {
    transition({
      action: "cancel_payment_operation",
      nextState: STATES.CANCEL_FEEDBACK,
      interactionType: "cancellation",
      metadata: {
        source_state: sourceState,
        authorisation_code_entered:
          Boolean(authorisationCode),
      },
    });

    setAuthorisationCode("");
  }

  function openOfficialCheck() {
    transition({
      action: "open_official_verification",
      nextState: STATES.OFFICIAL_CHECK,
      interactionType: "verification",
      metadata: {
        method: "account_dashboard",
      },
    });
  }

  function completeOfficialCheck() {
    transition({
      action: "complete_official_verification",
      nextState: STATES.OFFICIAL_RESULT,
      interactionType: "verification",
      metadata: {
        reference: PAYMENT.reference,
        independent_channel: true,
      },
    });
  }

  function finishScenario() {
    registerAction({
      action: "complete_simulation",
      nextState: STATES.COMPLETED,
      interactionType: "lifecycle",
      metadata: {
        reference: PAYMENT.reference,
      },
    });

    completeSimulation();
    setState(STATES.COMPLETED);
  }

  function nextSimulation() {
    registerAction({
      action: "continue_to_simulation_04",
      nextState: "phishing-04",
      interactionType: "navigation",
      metadata: {
        destination: "/student/simulacoes/phishing/04",
      },
    });

    navigate("/student/simulacoes/phishing/04");
  }

  function endSimulation() {
    registerAction({
      action: "return_to_simulations",
      nextState: "simulations",
      interactionType: "navigation",
      metadata: {
        destination: "/student/simulacoes",
      },
    });

    navigate("/student/simulacoes");
  }

  function renderState() {
    switch (state) {
      case STATES.PAYMENT_DETAILS:
        return (
          <PaymentDetailsView
            onBack={() =>
              transition({
                action: "return_to_payment_home",
                nextState: STATES.PAYMENT_HOME,
                interactionType: "navigation",
              })
            }
            onVerify={verifyBeneficiary}
            onCancel={() =>
              cancelOperation(STATES.PAYMENT_DETAILS)
            }
          />
        );

      case STATES.BENEFICIARY_VERIFICATION:
        return (
          <BeneficiaryVerificationView
            expanded={beneficiaryInspection}
            onExpand={openBeneficiaryInspection}
            onContinue={continueBeneficiaryVerification}
            onBack={() =>
              transition({
                action: "return_to_payment_details",
                nextState: STATES.PAYMENT_DETAILS,
                interactionType: "navigation",
              })
            }
            onCancel={() =>
              cancelOperation(STATES.BENEFICIARY_VERIFICATION)
            }
          />
        );

      case STATES.BENEFICIARY_CHANGED:
        return (
          <BeneficiaryChangedView
            onContinue={goToConfirmation}
            onReview={goBackToBeneficiaryVerification}
            onCancel={() =>
              cancelOperation(STATES.BENEFICIARY_CHANGED)
            }
          />
        );

      case STATES.PAYMENT_CONFIRMATION:
        return (
          <ConfirmationView
            accountName={accountName}
            accepted={senderInspection}
            onAccepted={() =>
              setSenderInspection((value) => {
                registerAction({
                  action: value
                    ? "uncheck_payment_confirmation"
                    : "check_payment_confirmation",
                  nextState: STATES.PAYMENT_CONFIRMATION,
                  interactionType: "form",
                  metadata: {
                    confirmation_checked: !value,
                  },
                });

                return !value;
              })
            }
            onAuthorize={openAuthorisation}
            onBack={goBackToBeneficiaryVerification}
            onCancel={() =>
              cancelOperation(STATES.PAYMENT_CONFIRMATION)
            }
          />
        );

      case STATES.PAYMENT_AUTHENTICATION:
        return (
          <AuthenticationView
            accountEmail={accountEmail}
            code={authorisationCode}
            onCodeChange={setAuthorisationCode}
            onSubmit={submitAuthorisation}
            onInspect={() => {
              transition({
                action: authorisationInspection
                  ? "collapse_authorisation_details"
                  : "expand_authorisation_details",
                nextState: STATES.PAYMENT_AUTHENTICATION,
                interactionType: "inspection",
                metadata: {
                  target: "authorisation_details",
                },
              });

              setAuthorisationInspection(
                (value) => !value
              );
            }}
            inspectionOpen={authorisationInspection}
            onCancel={() =>
              cancelOperation(STATES.PAYMENT_AUTHENTICATION)
            }
          />
        );

      case STATES.PAYMENT_PROCESSING:
        return <ProcessingView />;

      case STATES.PAYMENT_RECEIPT:
        return (
          <ReceiptView
            onFinish={finishScenario}
          />
        );

      case STATES.CANCEL_FEEDBACK:
        return (
          <CancelFeedbackView
            onOfficialCheck={openOfficialCheck}
            onReturn={() =>
              transition({
                action: "return_to_payment_after_cancellation",
                nextState: STATES.PAYMENT_DETAILS,
                interactionType: "navigation",
              })
            }
            onFinish={finishScenario}
          />
        );

      case STATES.OFFICIAL_CHECK:
        return (
          <OfficialCheckView
            checked={officialChecked}
            onCheck={() =>
              setOfficialChecked((value) => {
                registerAction({
                  action: value
                    ? "uncheck_official_verification"
                    : "check_official_verification",
                  nextState: STATES.OFFICIAL_CHECK,
                  interactionType: "form",
                  metadata: {
                    verification_checked: !value,
                  },
                });

                return !value;
              })
            }
            onContinue={completeOfficialCheck}
            onBack={() =>
              transition({
                action: "return_from_official_check",
                nextState: STATES.CANCEL_FEEDBACK,
                interactionType: "navigation",
              })
            }
          />
        );

      case STATES.OFFICIAL_RESULT:
        return (
          <OfficialResultView
            onReturn={() =>
              transition({
                action: "return_to_payment_details_after_check",
                nextState: STATES.PAYMENT_DETAILS,
                interactionType: "navigation",
              })
            }
            onFinish={finishScenario}
          />
        );

      case STATES.COMPLETED:
        return (
          <CompletedView
            duration={duration}
            onNext={nextSimulation}
            onEnd={endSimulation}
          />
        );

      case STATES.PAYMENT_HOME:
      default:
        return (
          <div className="space-y-6">
            <div className="flex flex-col gap-5 border-b border-slate-200 pb-6 sm:flex-row sm:items-end sm:justify-between">
              <SectionTitle
                eyebrow="Área financeira"
                title="Operações"
                description="Consulte e acompanhe as operações associadas à sua conta."
                icon={CircleDollarSign}
              />

              <div className="hidden shrink-0 sm:block">
                <StatusPill tone="blue">
                  Sessão activa
                </StatusPill>
              </div>
            </div>

            <BalanceCard accountName={accountName} />

            <PaymentSummaryCard
              onOpen={openPayment}
              onInspect={inspectPaymentFromHome}
            />

            <TransactionList onOpen={openPayment} />
          </div>
        );
    }
  }

  const showMainNavigation = ![
    STATES.COMPLETED,
    STATES.PAYMENT_PROCESSING,
  ].includes(state);

  return (
    <div className="min-h-screen bg-slate-100 text-slate-900">
      <MobileHeader
        onBack={() => navigate(-1)}
        onMenu={() => setMobileMenu((value) => !value)}
      />

      {mobileMenu && (
        <div className="border-b border-slate-200 bg-white px-4 py-3 lg:hidden">
          <div className="flex items-center gap-3 rounded-2xl bg-slate-50 p-3">
            <div className="flex h-9 w-9 items-center justify-center rounded-xl bg-blue-600 text-white">
              <UserRound className="h-4 w-4" />
            </div>

            <div className="min-w-0">
              <p className="truncate text-xs font-black text-slate-900">
                {accountName}
              </p>
              <p className="truncate text-[10px] text-slate-400">
                {accountEmail || "Conta autenticada"}
              </p>
            </div>
          </div>
        </div>
      )}

      <div className="flex min-h-[calc(100vh-4rem)] lg:min-h-screen">
        <AccountRail
          accountName={accountName}
          accountEmail={accountEmail}
          active={state === STATES.PAYMENT_HOME}
          onHome={() =>
            transition({
              action: "return_to_operations",
              nextState: STATES.PAYMENT_HOME,
              interactionType: "navigation",
            })
          }
        />

        <main className="min-w-0 flex-1">
          <div className="mx-auto max-w-[1440px] px-4 py-5 sm:px-6 sm:py-7 xl:px-8">
            <div className="mb-5 flex items-center justify-between gap-4">
              <div className="flex items-center gap-2 text-[10px] font-black uppercase tracking-[0.14em] text-slate-400">
                <span>Simulações</span>
                <ChevronRight className="h-3.5 w-3.5" />
                <span>Phishing</span>
                <ChevronRight className="h-3.5 w-3.5" />
                <span className="text-blue-600">
                  03 · Pagamento
                </span>
              </div>

              {showMainNavigation && (
                <button
                  type="button"
                  onClick={() => navigate(-1)}
                  className="hidden items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-black text-slate-600 transition hover:bg-slate-50 sm:inline-flex"
                >
                  <ArrowLeft className="h-3.5 w-3.5" />
                  Voltar
                </button>
              )}
            </div>

            <div className="mb-6 flex flex-wrap items-center justify-between gap-3">
              <div className="flex items-center gap-2">
                <span className="rounded-lg bg-blue-600 px-2.5 py-1.5 text-[10px] font-black text-white">
                  03
                </span>

                <span className="text-xs font-bold text-slate-500">
                  {SIMULATION.title}
                </span>
              </div>

              <div className="flex items-center gap-2">
                <StatusPill tone="slate">
                  <Clock3 className="h-3 w-3" />
                  {duration}
                </StatusPill>

                {currentSession?.sequence ? (
                  <StatusPill tone="slate">
                    Acções {currentSession.sequence}
                  </StatusPill>
                ) : null}
              </div>
            </div>

            {renderState()}
          </div>
        </main>
      </div>

      {state !== STATES.COMPLETED && state !== STATES.PAYMENT_PROCESSING && (
        <div className="fixed bottom-4 right-4 z-30 hidden sm:block">
          <div className="flex items-center gap-2 rounded-2xl border border-slate-200 bg-white px-3 py-2 shadow-xl shadow-slate-300/30">
            <span className="flex h-7 w-7 items-center justify-center rounded-lg bg-slate-100 text-slate-500">
              <MoreHorizontal className="h-4 w-4" />
            </span>

            <span className="text-[10px] font-black uppercase tracking-[0.12em] text-slate-400">
              Percurso registado
            </span>
          </div>
        </div>
      )}
    </div>
  );
}










