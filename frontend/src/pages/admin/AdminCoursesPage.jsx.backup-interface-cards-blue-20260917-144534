/* ============================================================
   MODAL DO CURSO
============================================================ */

function CursoModal({
  curso,
  onClose,
  onSaved,
}) {
  const editar =
    Boolean(curso);

  const [titulo, setTitulo] =
    useState(
      curso?.title || ""
    );

  const [descricao, setDescricao] =
    useState(
      curso?.description || ""
    );

  const [link, setLink] =
    useState(
      curso?.link || ""
    );

  const [publicado, setPublicado] =
    useState(
      curso?.published !== false
    );

  const [perguntas, setPerguntas] =
    useState(
      normalizarPerguntas(
        curso?.questions
      )
    );

  const [etapa, setEtapa] =
    useState(1);

  const [erro, setErro] =
    useState("");

  const [saving, setSaving] =
    useState(false);

  function atualizarPergunta(
    indice,
    campo,
    valor
  ) {
    setPerguntas((actual) =>
      actual.map(
        (item, index) =>
          index === indice
            ? {
                ...item,
                [campo]: valor,
              }
            : item
      )
    );
  }

  function atualizarOpcao(
    perguntaIndex,
    opcaoIndex,
    valor
  ) {
    setPerguntas((actual) =>
      actual.map(
        (item, index) => {
          if (
            index !==
            perguntaIndex
          ) {
            return item;
          }

          return {
            ...item,
            options:
              item.options.map(
                (
                  opcao,
                  indexOpcao
                ) =>
                  indexOpcao ===
                  opcaoIndex
                    ? valor
                    : opcao
              ),
          };
        }
      )
    );
  }

  function validarCurso() {
    if (!titulo.trim()) {
      return "O título do curso é obrigatório.";
    }

    if (!descricao.trim()) {
      return "A descrição do curso é obrigatória.";
    }

    if (!link.trim()) {
      return "O link do curso é obrigatório.";
    }

    if (
      !/^https?:\/\//i.test(
        link.trim()
      )
    ) {
      return "O link deve começar por http:// ou https://.";
    }

    return "";
  }

  function validarPerguntas() {
    if (
      perguntas.length !==
      TOTAL_PERGUNTAS
    ) {
      return "O curso deve possuir exactamente 10 perguntas.";
    }

    for (
      let i = 0;
      i <
      TOTAL_PERGUNTAS;
      i++
    ) {
      const pergunta =
        perguntas[i];

      if (
        !pergunta.question.trim()
      ) {
        return `A pergunta ${i + 1} está vazia.`;
      }

      if (
        !Array.isArray(
          pergunta.options
        ) ||
        pergunta.options.length !==
          TOTAL_OPCOES
      ) {
        return `A pergunta ${i + 1} deve possuir 4 opções.`;
      }

      for (
        let j = 0;
        j < TOTAL_OPCOES;
        j++
      ) {
        if (
          !String(
            pergunta
              .options[j] || ""
          ).trim()
        ) {
          return `A opção ${j + 1} da pergunta ${i + 1} está vazia.`;
        }
      }

      const correcta =
        Number(
          pergunta.correct_answer
        );

      if (
        !Number.isInteger(
          correcta
        ) ||
        correcta < 0 ||
        correcta > 3
      ) {
        return `Seleccione a resposta correcta da pergunta ${i + 1}.`;
      }
    }

    return "";
  }

  function continuar() {
    const erroCurso =
      validarCurso();

    if (erroCurso) {
      setErro(erroCurso);
      setEtapa(1);
      return;
    }

    setErro("");
    setEtapa(2);
  }

  async function guardar(
    event
  ) {
    event.preventDefault();

    const erroCurso =
      validarCurso();

    if (erroCurso) {
      setErro(erroCurso);
      setEtapa(1);
      return;
    }

    const erroPerguntas =
      validarPerguntas();

    if (erroPerguntas) {
      setErro(
        erroPerguntas
      );
      setEtapa(2);
      return;
    }

    setSaving(true);
    setErro("");

    try {
      const payload = {
        title:
          titulo.trim(),
        description:
          descricao.trim(),
        link:
          link.trim(),
        published:
          publicado,
        questions:
          perguntas.map(
            (pergunta) => ({
              question:
                pergunta.question.trim(),
              options:
                pergunta.options.map(
                  (opcao) =>
                    opcao.trim()
                ),
              correct_answer:
                Number(
                  pergunta.correct_answer
                ),
            })
          ),
      };

      const resposta =
        await fetch(
          editar
            ? `${API_BASE}/courses/${curso.id}`
            : `${API_BASE}/courses`,
          {
            method:
              editar
                ? "PUT"
                : "POST",
            headers: {
              "Content-Type":
                "application/json",
            },
            body: JSON.stringify(
              payload
            ),
          }
        );

      const dados =
        await resposta
          .json()
          .catch(() => null);

      if (!resposta.ok) {
        throw new Error(
          obterMensagemErro(
            dados,
            "Não foi possível guardar o curso."
          )
        );
      }

      onSaved(
        dados,
        editar
          ? "Curso actualizado com sucesso."
          : "Curso criado com sucesso."
      );
    } catch (error) {
      setErro(
        error?.message ||
          "Não foi possível guardar o curso."
      );
    } finally {
      setSaving(false);
    }
  }

  return (
    <Modal
      wide
      title={
        editar
          ? "Editar curso"
          : "Novo curso"
      }
      subtitle="Título, descrição, link e 10 perguntas."
      onClose={onClose}
    >
      <form
        onSubmit={guardar}
        className="p-6"
      >
        <div className="grid grid-cols-2 gap-2">
          <button
            type="button"
            onClick={() => {
              setErro("");
              setEtapa(1);
            }}
            className={`rounded-xl px-4 py-3 text-sm font-black ${
              etapa === 1
                ? "bg-blue-600 text-white"
                : "bg-slate-100 text-slate-500"
            }`}
          >
            1 · Dados do curso
          </button>

          <button
            type="button"
            onClick={
              continuar
            }
            className={`rounded-xl px-4 py-3 text-sm font-black ${
              etapa === 2
                ? "bg-blue-600 text-white"
                : "bg-slate-100 text-slate-500"
            }`}
          >
            2 · 10 perguntas
          </button>
        </div>

        {erro ? (
          <div className="mt-5 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-700">
            {erro}
          </div>
        ) : null}

        {etapa === 1 ? (
          <div className="mt-6 space-y-5">
            <Campo
              label="Título"
              value={titulo}
              onChange={
                setTitulo
              }
              placeholder="Título do curso"
            />

            <Campo
              label="Descrição"
              value={
                descricao
              }
              onChange={
                setDescricao
              }
              placeholder="Descrição do curso"
              textarea
            />

            <Campo
              label="Link"
              value={link}
              onChange={
                setLink
              }
              placeholder="https://exemplo.com/curso"
            />

            <div className="flex items-center justify-between rounded-2xl border border-blue-100 bg-blue-50 px-4 py-4">
              <div>
                <p className="text-sm font-black text-blue-950">
                  Publicar imediatamente
                </p>

                <p className="mt-1 text-xs text-blue-700">
                  O curso poderá aparecer para os estudantes.
                </p>
              </div>

              <input
                type="checkbox"
                checked={
                  publicado
                }
                onChange={(
                  event
                ) =>
                  setPublicado(
                    event.target
                      .checked
                  )
                }
                className="h-5 w-5 accent-blue-600"
              />
            </div>

            <div className="flex justify-end gap-2 border-t border-slate-200 pt-5">
              <button
                type="button"
                onClick={
                  onClose
                }
                className="rounded-xl border border-slate-200 px-4 py-3 text-sm font-bold text-slate-600"
              >
                Cancelar
              </button>

              <button
                type="button"
                onClick={
                  continuar
                }
                className="rounded-xl bg-blue-600 px-5 py-3 text-sm font-black text-white hover:bg-blue-700"
              >
                Continuar
              </button>
            </div>
          </div>
        ) : (
          <div className="mt-6 space-y-5">
            {perguntas.map(
              (
                pergunta,
                index
              ) => (
                <div
                  key={
                    pergunta.id ||
                    `nova-${index}`
                  }
                  className="rounded-3xl border border-slate-200 bg-slate-50 p-5"
                >
                  <div className="flex items-center justify-between">
                    <div>
                      <p className="text-[11px] font-black uppercase tracking-[0.14em] text-blue-600">
                        Questão{" "}
                        {index + 1}
                      </p>

                      <p className="mt-1 text-sm font-black text-slate-900">
                        Pergunta e quatro opções
                      </p>
                    </div>

                    <span className="flex h-9 w-9 items-center justify-center rounded-xl bg-blue-100 text-sm font-black text-blue-700">
                      {index + 1}
                    </span>
                  </div>

                  <div className="mt-5 space-y-4">
                    <Campo
                      label="Pergunta"
                      value={
                        pergunta.question
                      }
                      onChange={(
                        valor
                      ) =>
                        atualizarPergunta(
                          index,
                          "question",
                          valor
                        )
                      }
                      placeholder="Escreva a pergunta."
                      textarea
                    />

                    <div className="grid gap-4 md:grid-cols-2">
                      {pergunta.options.map(
                        (
                          opcao,
                          opcaoIndex
                        ) => (
                          <div
                            key={
                              opcaoIndex
                            }
                          >
                            <div className="flex items-center justify-between">
                              <span className="text-xs font-black uppercase tracking-[0.1em] text-slate-500">
                                Opção{" "}
                                {opcaoIndex +
                                  1}
                              </span>

                              <label className="flex items-center gap-2 text-xs font-bold text-slate-500">
                                <input
                                  type="radio"
                                  name={`correct-${index}`}
                                  checked={
                                    Number(
                                      pergunta.correct_answer
                                    ) ===
                                    opcaoIndex
                                  }
                                  onChange={() =>
                                    atualizarPergunta(
                                      index,
                                      "correct_answer",
                                      opcaoIndex
                                    )
                                  }
                                  className="accent-blue-600"
                                />
                                correcta
                              </label>
                            </div>

                            <input
                              value={
                                opcao
                              }
                              onChange={(
                                event
                              ) =>
                                atualizarOpcao(
                                  index,
                                  opcaoIndex,
                                  event
                                    .target
                                    .value
                                )
                              }
                              placeholder={`Opção ${
                                opcaoIndex +
                                1
                              }`}
                              className="mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-semibold outline-none focus:border-blue-300 focus:ring-4 focus:ring-blue-50"
                            />
                          </div>
                        )
                      )}
                    </div>
                  </div>
                </div>
              )
            )}

            <div className="flex justify-between border-t border-slate-200 pt-5">
              <button
                type="button"
                onClick={() => {
                  setErro("");
                  setEtapa(1);
                }}
                className="rounded-xl border border-slate-200 px-4 py-3 text-sm font-bold text-slate-600"
              >
                Voltar
              </button>

              <button
                type="submit"
                disabled={
                  saving
                }
                className="inline-flex items-center gap-2 rounded-xl bg-blue-600 px-5 py-3 text-sm font-black text-white hover:bg-blue-700 disabled:opacity-60"
              >
                {saving ? (
                  <LoaderCircle
                    size={17}
                    className="animate-spin"
                  />
                ) : (
                  <Check
                    size={17}
                  />
                )}

                {saving
                  ? "A guardar..."
                  : editar
                    ? "Actualizar curso"
                    : "Criar curso"}
              </button>
            </div>
          </div>
        )}
      </form>
    </Modal>
  );
}

/* ============================================================
   MODAL DE PERGUNTAS
============================================================ */

function PerguntasModal({
  curso,
  onClose,
  onUpdated,
}) {
  const [perguntas, setPerguntas] =
    useState(
      normalizarPerguntas(
        curso.questions
      )
    );

  const [indice, setIndice] =
    useState(0);

  const [erro, setErro] =
    useState("");

  const [saving, setSaving] =
    useState(false);

  const pergunta =
    perguntas[indice];

  function atualizarCampo(
    campo,
    valor
  ) {
    setPerguntas((actual) =>
      actual.map(
        (
          item,
          index
        ) =>
          index === indice
            ? {
                ...item,
                [campo]:
                  valor,
              }
            : item
      )
    );
  }

  function atualizarOpcao(
    opcaoIndex,
    valor
  ) {
    setPerguntas((actual) =>
      actual.map(
        (
          item,
          index
        ) => {
          if (
            index !==
            indice
          ) {
            return item;
          }

          return {
            ...item,
            options:
              item.options.map(
                (
                  opcao,
                  indexOpcao
                ) =>
                  indexOpcao ===
                  opcaoIndex
                    ? valor
                    : opcao
              ),
          };
        }
      )
    );
  }

  async function guardarPergunta() {
    setErro("");

    if (
      !pergunta?.id
    ) {
      setErro(
        "Esta pergunta não possui um ID válido."
      );
      return;
    }

    if (
      !pergunta.question.trim()
    ) {
      setErro(
        "A pergunta é obrigatória."
      );
      return;
    }

    if (
      pergunta.options.some(
        (opcao) =>
          !String(
            opcao
          ).trim()
      )
    ) {
      setErro(
        "As quatro opções são obrigatórias."
      );
      return;
    }

    setSaving(true);

    try {
      const resposta =
        await fetch(
          `${API_BASE}/courses/${curso.id}/questions/${pergunta.id}`,
          {
            method: "PUT",
            headers: {
              "Content-Type":
                "application/json",
            },
            body: JSON.stringify({
              question:
                pergunta.question.trim(),
              options:
                pergunta.options.map(
                  (opcao) =>
                    opcao.trim()
                ),
              correct_answer:
                Number(
                  pergunta.correct_answer
                ),
            }),
          }
        );

      const dados =
        await resposta
          .json()
          .catch(() => null);

      if (!resposta.ok) {
        throw new Error(
          obterMensagemErro(
            dados,
            "Não foi possível guardar a pergunta."
          )
        );
      }

      setPerguntas(
        normalizarPerguntas(
          dados.questions
        )
      );

      onUpdated(
        dados,
        `Pergunta ${indice + 1} actualizada com sucesso.`
      );
    } catch (error) {
      setErro(
        error?.message ||
          "Não foi possível guardar a pergunta."
      );
    } finally {
      setSaving(false);
    }
  }

  return (
    <Modal
      wide
      title={`Perguntas · ${curso.title}`}
      subtitle="Cada curso mantém exactamente 10 perguntas."
      onClose={onClose}
    >
      <div className="grid gap-6 p-6 lg:grid-cols-[220px_1fr]">
        <aside className="rounded-2xl border border-slate-200 bg-slate-50 p-3">
          <p className="px-2 pb-3 text-[11px] font-black uppercase tracking-[0.12em] text-slate-400">
            Perguntas
          </p>

          <div className="grid grid-cols-5 gap-2 lg:grid-cols-1">
            {perguntas.map(
              (
                item,
                index
              ) => (
                <button
                  key={
                    item.id ||
                    `q-${index}`
                  }
                  type="button"
                  onClick={() => {
                    setErro("");
                    setIndice(
                      index
                    );
                  }}
                  className={`rounded-xl px-3 py-2 text-left text-xs font-black ${
                    indice ===
                    index
                      ? "bg-blue-600 text-white"
                      : "bg-white text-slate-600 hover:bg-blue-50"
                  }`}
                >
                  Pergunta{" "}
                  {index + 1}
                </button>
              )
            )}
          </div>
        </aside>

        <div className="rounded-2xl border border-slate-200 bg-white p-5">
          {erro ? (
            <div className="mb-5 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-700">
              {erro}
            </div>
          ) : null}

          <div className="flex items-center justify-between">
            <div>
              <p className="text-[11px] font-black uppercase tracking-[0.12em] text-blue-600">
                Pergunta{" "}
                {indice + 1}
              </p>

              <h3 className="mt-1 text-lg font-black text-slate-950">
                Editar pergunta
              </h3>
            </div>

            <FileQuestion
              size={24}
              className="text-blue-600"
            />
          </div>

          <div className="mt-5 space-y-5">
            <Campo
              label="Pergunta"
              value={
                pergunta?.question ||
                ""
              }
              onChange={(
                valor
              ) =>
                atualizarCampo(
                  "question",
                  valor
                )
              }
              placeholder="Escreva a pergunta."
              textarea
            />

            <div className="grid gap-4 md:grid-cols-2">
              {(
                pergunta?.options ||
                []
              ).map(
                (
                  opcao,
                  opcaoIndex
                ) => (
                  <div
                    key={
                      opcaoIndex
                    }
                  >
                    <div className="flex items-center justify-between">
                      <span className="text-xs font-black uppercase tracking-[0.1em] text-slate-500">
                        Opção{" "}
                        {opcaoIndex +
                          1}
                      </span>

                      <label className="flex items-center gap-2 text-xs font-bold text-slate-500">
                        <input
                          type="radio"
                          name={`correct-${curso.id}`}
                          checked={
                            Number(
                              pergunta.correct_answer
                            ) ===
                            opcaoIndex
                          }
                          onChange={() =>
                            atualizarCampo(
                              "correct_answer",
                              opcaoIndex
                            )
                          }
                          className="accent-blue-600"
                        />
                        correcta
                      </label>
                    </div>

                    <input
                      value={
                        opcao
                      }
                      onChange={(
                        event
                      ) =>
                        atualizarOpcao(
                          opcaoIndex,
                          event
                            .target
                            .value
                        )
                      }
                      className="mt-2 w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm font-semibold outline-none focus:border-blue-300 focus:ring-4 focus:ring-blue-50"
                    />
                  </div>
                )
              )}
            </div>

            <div className="flex flex-wrap justify-between gap-3 border-t border-slate-200 pt-5">
              <div className="flex gap-2">
                <button
                  type="button"
                  disabled={
                    indice === 0
                  }
                  onClick={() =>
                    setIndice(
                      (
                        valor
                      ) =>
                        Math.max(
                          0,
                          valor - 1
                        )
                    )
                  }
                  className="rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-bold text-slate-600 disabled:opacity-40"
                >
                  Anterior
                </button>

                <button
                  type="button"
                  disabled={
                    indice ===
                    TOTAL_PERGUNTAS -
                      1
                  }
                  onClick={() =>
                    setIndice(
                      (
                        valor
                      ) =>
                        Math.min(
                          TOTAL_PERGUNTAS -
                            1,
                          valor + 1
                        )
                    )
                  }
                  className="rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-bold text-slate-600 disabled:opacity-40"
                >
                  Próxima
                </button>
              </div>

              <button
                type="button"
                disabled={
                  saving
                }
                onClick={
                  guardarPergunta
                }
                className="inline-flex items-center gap-2 rounded-xl bg-blue-600 px-5 py-2.5 text-sm font-black text-white hover:bg-blue-700 disabled:opacity-60"
              >
                {saving ? (
                  <LoaderCircle
                    size={16}
                    className="animate-spin"
                  />
                ) : (
                  <Check
                    size={16}
                  />
                )}

                {saving
                  ? "A guardar..."
                  : "Guardar pergunta"}
              </button>
            </div>
          </div>
        </div>
      </div>
    </Modal>
  );
}

