/* ============================================================
   PÁGINA
============================================================ */

export default function AdminCoursesPage() {
  const [cursos, setCursos] =
    useState([]);

  const [pesquisa, setPesquisa] =
    useState("");

  const [loading, setLoading] =
    useState(true);

  const [modal, setModal] =
    useState(null);

  const [toast, setToast] =
    useState(null);

  function notificar(
    message,
    type = "success"
  ) {
    setToast({
      message,
      type,
    });
  }

  useEffect(() => {
    if (!toast) {
      return undefined;
    }

    const timer =
      setTimeout(
        () => setToast(null),
        4500
      );

    return () =>
      clearTimeout(timer);
  }, [toast]);

  async function carregarCursos() {
    setLoading(true);

    try {
      const resposta =
        await fetch(
          `${API_BASE}/courses`
        );

      const dados =
        await resposta
          .json()
          .catch(() => null);

      if (!resposta.ok) {
        throw new Error(
          obterMensagemErro(
            dados,
            "Não foi possível carregar os cursos."
          )
        );
      }

      setCursos(
        Array.isArray(dados)
          ? dados
          : []
      );
    } catch (error) {
      notificar(
        error?.message ||
          "Não foi possível carregar os cursos.",
        "error"
      );
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    carregarCursos();
  }, []);

  const filtrados =
    useMemo(() => {
      const termo =
        pesquisa
          .trim()
          .toLowerCase();

      if (!termo) {
        return cursos;
      }

      return cursos.filter(
        (curso) =>
          String(
            curso.title ||
              ""
          )
            .toLowerCase()
            .includes(
              termo
            ) ||
          String(
            curso.description ||
              ""
          )
            .toLowerCase()
            .includes(
              termo
            )
      );
    }, [
      cursos,
      pesquisa,
    ]);

  const total =
    cursos.length;

  const publicados =
    cursos.filter(
      (curso) =>
        curso.published !==
        false
    ).length;

  const rascunhos =
    total - publicados;

  async function guardarCurso(
    dados,
    mensagem
  ) {
    setCursos((actual) => {
      const existe =
        actual.some(
          (item) =>
            item.id ===
            dados.id
        );

      return existe
        ? actual.map(
            (item) =>
              item.id ===
              dados.id
                ? dados
                : item
          )
        : [...actual, dados];
    });

    setModal(null);
    notificar(
      mensagem
    );
  }

  async function alterarPublicacao(
    curso
  ) {
    try {
      const resposta =
        await fetch(
          `${API_BASE}/courses/${curso.id}/publish`,
          {
            method: "PATCH",
            headers: {
              "Content-Type":
                "application/json",
            },
            body: JSON.stringify(
              {
                published:
                  curso.published ===
                  false,
              }
            ),
          }
        );

      const dados =
        await resposta
          .json()
          .catch(() => null);

      if (!resposta.ok) {
        throw new Error(
          obterMensagemErro(
            dados,
            "Não foi possível alterar a publicação."
          )
        );
      }

      setCursos((actual) =>
        actual.map(
          (item) =>
            item.id ===
            curso.id
              ? dados
              : item
        )
      );

      notificar(
        dados.published
          ? "Curso publicado com sucesso."
          : "Curso retirado da publicação."
      );
    } catch (error) {
      notificar(
        error?.message ||
          "Não foi possível alterar o estado do curso.",
        "error"
      );
    }
  }

  async function eliminarCurso(
    curso
  ) {
    const confirmar =
      window.confirm(
        `Tem a certeza que pretende eliminar "${curso.title}"?`
      );

    if (!confirmar) {
      return;
    }

    try {
      const resposta =
        await fetch(
          `${API_BASE}/courses/${curso.id}?confirm=true`,
          {
            method: "DELETE",
          }
        );

      const dados =
        await resposta
          .json()
          .catch(() => null);

      if (!resposta.ok) {
        throw new Error(
          obterMensagemErro(
            dados,
            "Não foi possível eliminar o curso."
          )
        );
      }

      setCursos((actual) =>
        actual.filter(
          (item) =>
            item.id !==
            curso.id
        )
      );

      notificar(
        "Curso eliminado com sucesso."
      );
    } catch (error) {
      notificar(
        error?.message ||
          "Não foi possível eliminar o curso.",
        "error"
      );
    }
  }

  function abrirCurso(
    curso
  ) {
    const url =
      String(
        curso.link || ""
      ).trim();

    if (!url) {
      notificar(
        "Este curso ainda não possui um link.",
        "error"
      );
      return;
    }

    window.open(
      url,
      "_blank",
      "noopener,noreferrer"
    );
  }

  function actualizarDepoisPergunta(
    dados,
    mensagem
  ) {
    setCursos((actual) =>
      actual.map(
        (item) =>
          item.id ===
          dados.id
            ? dados
            : item
      )
    );

    notificar(
      mensagem
    );
  }

  return (
    <div className="space-y-6">
      {/* CABEÇALHO */}

      <header className="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <div className="flex items-center gap-2 text-blue-600">
            <ShieldCheck
              size={18}
            />

            <span className="text-xs font-black uppercase tracking-[0.16em]">
              Administração
            </span>
          </div>

          <h1 className="mt-1 text-3xl font-black tracking-tight text-slate-950">
            Cursos
          </h1>

          <p className="mt-2 max-w-2xl text-sm leading-6 text-slate-500">
            Gestão dos cursos de formação em cibersegurança do SICSI.
          </p>
        </div>

        <div className="flex flex-wrap gap-2">
          <button
            type="button"
            onClick={
              carregarCursos
            }
            disabled={
              loading
            }
            className="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-black text-slate-700 shadow-sm hover:border-blue-200 hover:text-blue-700 disabled:opacity-50"
          >
            <RefreshCw
              size={16}
              className={
                loading
                  ? "animate-spin"
                  : ""
              }
            />

            Actualizar
          </button>

          <button
            type="button"
            onClick={() =>
              setModal({
                type: "curso",
                curso: null,
              })
            }
            className="inline-flex items-center gap-2 rounded-xl bg-blue-600 px-5 py-3 text-sm font-black text-white shadow-lg shadow-blue-600/20 hover:bg-blue-700"
          >
            <Plus
              size={17}
            />

            Novo curso
          </button>
        </div>
      </header>

      {/* ESTATÍSTICAS */}

      <div className="grid gap-4 md:grid-cols-3">
        <div className="rounded-[24px] border border-slate-200 bg-white p-5 shadow-sm">
          <div className="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
            <BookOpen
              size={19}
            />
          </div>

          <p className="mt-4 text-sm font-semibold text-slate-500">
            Total de cursos
          </p>

          <p className="mt-1 text-3xl font-black text-slate-950">
            {total}
          </p>
        </div>

        <div className="rounded-[24px] border border-slate-200 bg-white p-5 shadow-sm">
          <div className="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600">
            <Eye
              size={19}
            />
          </div>

          <p className="mt-4 text-sm font-semibold text-slate-500">
            Publicados
          </p>

          <p className="mt-1 text-3xl font-black text-slate-950">
            {publicados}
          </p>
        </div>

        <div className="rounded-[24px] border border-slate-200 bg-white p-5 shadow-sm">
          <div className="flex h-10 w-10 items-center justify-center rounded-xl bg-amber-50 text-amber-600">
            <EyeOff
              size={19}
            />
          </div>

          <p className="mt-4 text-sm font-semibold text-slate-500">
            Não publicados
          </p>

          <p className="mt-1 text-3xl font-black text-slate-950">
            {rascunhos}
          </p>
        </div>
      </div>

      {/* PESQUISA */}

      <section className="rounded-[24px] border border-slate-200 bg-white p-4 shadow-sm">
        <div className="relative">
          <Search
            size={19}
            className="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"
          />

          <input
            value={
              pesquisa
            }
            onChange={(
              event
            ) =>
              setPesquisa(
                event.target
                  .value
              )
            }
            placeholder="Pesquisar cursos..."
            className="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 pl-11 text-sm font-semibold outline-none transition focus:border-blue-300 focus:bg-white focus:ring-4 focus:ring-blue-50"
          />
        </div>
      </section>

      {/* CURSOS */}

      {loading ? (
        <section className="flex min-h-[320px] items-center justify-center rounded-[28px] border border-slate-200 bg-white">
          <div className="flex items-center gap-3 text-sm font-bold text-slate-500">
            <LoaderCircle
              size={22}
              className="animate-spin text-blue-600"
            />

            A carregar cursos...
          </div>
        </section>
      ) : filtrados.length ===
        0 ? (
        <section className="flex min-h-[320px] flex-col items-center justify-center rounded-[28px] border border-dashed border-slate-300 bg-white px-6 text-center">
          <BookOpen
            size={45}
            className="text-slate-300"
          />

          <h2 className="mt-4 text-lg font-black text-slate-900">
            Nenhum curso encontrado
          </h2>

          <p className="mt-1 text-sm text-slate-500">
            Altere a pesquisa ou crie um novo curso.
          </p>
        </section>
      ) : (
        <section className="grid gap-6 md:grid-cols-2">
          {filtrados.map(
            (curso) => (
              <CourseCard
                key={
                  curso.id
                }
                curso={
                  curso
                }
                onEdit={(item) =>
                  setModal({
                    type: "curso",
                    curso: item,
                  })
                }
                onQuestions={(
                  item
                ) =>
                  setModal({
                    type: "perguntas",
                    curso: item,
                  })
                }
                onPublish={
                  alterarPublicacao
                }
                onDelete={
                  eliminarCurso
                }
                onOpen={
                  abrirCurso
                }
              />
            )
          )}
        </section>
      )}

      {/* MODAL CURSO */}

      {modal?.type ===
      "curso" ? (
        <CursoModal
          key={
            modal.curso?.id ||
            "novo"
          }
          curso={
            modal.curso
          }
          onClose={() =>
            setModal(null)
          }
          onSaved={
            guardarCurso
          }
        />
      ) : null}

      {/* MODAL PERGUNTAS */}

      {modal?.type ===
      "perguntas" ? (
        <PerguntasModal
          key={
            modal.curso.id
          }
          curso={
            cursos.find(
              (item) =>
                item.id ===
                modal.curso.id
            ) ||
            modal.curso
          }
          onClose={() =>
            setModal(null)
          }
          onUpdated={
            actualizarDepoisPergunta
          }
        />
      ) : null}

      {/* TOAST */}

      {toast ? (
        <div
          className={`fixed bottom-5 right-5 z-[80] max-w-md rounded-2xl px-5 py-3 text-sm font-bold text-white shadow-2xl ${
            toast.type ===
            "error"
              ? "bg-red-600"
              : "bg-slate-950"
          }`}
        >
          {toast.message}
        </div>
      ) : null}
    </div>
  );
}
