const API_BASE =
  "http://127.0.0.1:8000/api/course-admin";

const TOTAL_PERGUNTAS = 10;
const TOTAL_OPCOES = 4;

function perguntaVazia() {
  return {
    id: "",
    question: "",
    options: ["", "", "", ""],
    correct_answer: 0,
  };
}

function criarPerguntasVazias() {
  return Array.from(
    { length: TOTAL_PERGUNTAS },
    () => perguntaVazia()
  );
}

function normalizarPerguntas(perguntas) {
  const origem = Array.isArray(perguntas)
    ? perguntas
    : [];

  return Array.from(
    { length: TOTAL_PERGUNTAS },
    (_, index) => {
      const item = origem[index];

      if (!item) {
        return perguntaVazia();
      }

      const opcoes = Array.isArray(
        item.options
      )
        ? item.options.map((valor) =>
            String(valor ?? "")
          )
        : [];

      while (opcoes.length < TOTAL_OPCOES) {
        opcoes.push("");
      }

      return {
        id: String(item.id || ""),
        question: String(
          item.question || ""
        ),
        options: opcoes.slice(
          0,
          TOTAL_OPCOES
        ),
        correct_answer:
          Number.isInteger(
            Number(item.correct_answer)
          )
            ? Number(
                item.correct_answer
              )
            : 0,
      };
    }
  );
}

function obterMensagemErro(
  dados,
  fallback
) {
  if (
    typeof dados?.detail ===
    "string"
  ) {
    return dados.detail;
  }

  if (
    Array.isArray(
      dados?.detail
    )
  ) {
    return dados.detail
      .map(
        (item) =>
          item?.msg
      )
      .filter(Boolean)
      .join(" ");
  }

  return fallback;
}

