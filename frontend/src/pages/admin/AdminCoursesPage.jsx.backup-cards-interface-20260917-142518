} from "lucide-react";

const API_BASE = "http://127.0.0.1:8000/api/course-admin";

const TOTAL_PERGUNTAS = 10;
const TOTAL_OPCOES = 4;

function perguntaVazia() {
  return {
    id: "",
    question: "",
    options: ["", "", "", ""],
    correct_answer: 0,
  };
}

function perguntasVazias() {
  return Array.from(
    { length: TOTAL_PERGUNTAS },
    () => perguntaVazia()
  );
}

function normalizarPerguntas(lista) {
  const origem = Array.isArray(lista) ? lista : [];

  return Array.from(
    { length: TOTAL_PERGUNTAS },
    (_, index) => {
      const item = origem[index];

      if (!item) {
        return perguntaVazia();
      }

      const options = Array.isArray(item.options)
        ? item.options.map((x) => String(x ?? ""))
        : [];

      while (options.length < TOTAL_OPCOES) {
        options.push("");
      }

      return {
        id: String(item.id || ""),
        question: String(item.question || ""),
        options: options.slice(0, TOTAL_OPCOES),
        correct_answer: Number.isInteger(
          Number(item.correct_answer)
        )
          ? Number(item.correct_answer)
          : 0,
      };
    }
  );
}

function mensagemErro(data, fallback) {
  if (typeof data?.detail === "string") {
    return data.detail;
  }

  if (Array.isArray(data?.detail)) {
    return data.detail
      .map((item) => item?.msg)
      .filter(Boolean)
      .join(" ");
  }

  return fallback;
}

