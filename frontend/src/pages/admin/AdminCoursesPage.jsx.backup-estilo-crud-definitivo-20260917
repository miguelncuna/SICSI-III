function CursoModal({
  curso,
  onClose,
  onSaved,
}) {
  const editar =
    Boolean(curso);

  const [titulo, setTitulo] =
    useState(
      curso?.title || ""
    );

  const [descricao, setDescricao] =
    useState(
      curso?.description || ""
    );

  const [link, setLink] =
    useState(
      curso?.link || ""
    );

  const [publicado, setPublicado] =
    useState(
      curso?.published !== false
    );

  const [videos, setVideos] =
    useState(
      normalizarVideos(
        curso?.videos
      )
    );

  const [perguntas, setPerguntas] =
    useState(
      normalizarPerguntas(
        curso?.questions
      )
    );

  const [aba, setAba] =
    useState("dados");

  const [erro, setErro] =
    useState("");

  const [saving, setSaving] =
    useState(false);

  function atualizarVideo(
    index,
    campo,
    valor
  ) {
    setVideos((actual) =>
      actual.map(
        (video, i) =>
          i === index
            ? {
                ...video,
                [campo]:
                  valor,
              }
            : video
      )
    );
  }

  function adicionarVideo() {
    setVideos((actual) => [
      ...actual,
      videoVazio(),
    ]);

    setAba("videos");
    setErro("");
  }

  function removerVideo(
    index
  ) {
    setVideos((actual) =>
      actual.filter(
        (_, i) =>
          i !== index
      )
    );
  }

  function atualizarPergunta(
    index,
    campo,
    valor
  ) {
    setPerguntas((actual) =>
      actual.map(
        (item, i) =>
          i === index
            ? {
                ...item,
                [campo]:
                  valor,
              }
            : item
      )
    );
  }

  function atualizarOpcao(
    perguntaIndex,
    opcaoIndex,
    valor
  ) {
    setPerguntas((actual) =>
      actual.map(
        (item, i) => {
          if (
            i !==
            perguntaIndex
          ) {
            return item;
          }

          return {
            ...item,
            options:
              item.options.map(
                (
                  opcao,
                  oi
                ) =>
                  oi ===
                  opcaoIndex
                    ? valor
                    : opcao
              ),
          };
        }
      )
    );
  }

  function validarCurso() {
    if (!titulo.trim()) {
      return "O título do curso é obrigatório.";
    }

    if (!descricao.trim()) {
      return "A descrição do curso é obrigatória.";
    }

    if (!link.trim()) {
      return "O link do curso é obrigatório.";
    }

    if (
      !/^https?:\/\//i.test(
        link.trim()
      )
    ) {
      return "O link do curso deve começar por http:// ou https://.";
    }

    return "";
  }

  function validarVideos() {
    for (
      let i = 0;
      i < videos.length;
      i += 1
    ) {
      const video =
        videos[i];

      if (!video.title.trim()) {
        return `O título do vídeo ${i + 1} é obrigatório.`;
      }

      if (!video.description.trim()) {
        return `A descrição do vídeo ${i + 1} é obrigatória.`;
      }

      if (!video.link.trim()) {
        return `O link do vídeo ${i + 1} é obrigatório.`;
      }

      if (
        !/^https?:\/\//i.test(
          video.link.trim()
        )
      ) {
        return `O link do vídeo ${i + 1} deve começar por http:// ou https://.`;
      }
    }

    return "";
  }

  function validarPerguntas() {
    if (
      perguntas.length !==
      TOTAL_PERGUNTAS
    ) {
      return "O curso deve possuir exactamente 10 perguntas.";
    }

    for (
      let i = 0;
      i < TOTAL_PERGUNTAS;
      i += 1
    ) {
      const pergunta =
        perguntas[i];

      if (
        !pergunta.question.trim()
      ) {
        return `A pergunta ${i + 1} está vazia.`;
      }

      if (
        pergunta.options.length !==
        TOTAL_OPCOES
      ) {
        return `A pergunta ${i + 1} deve possuir 4 opções.`;
      }

      for (
        let j = 0;
        j < TOTAL_OPCOES;
        j += 1
      ) {
        if (
          !String(
            pergunta.options[j] ||
              ""
          ).trim()
        ) {
          return `A opção ${j + 1} da pergunta ${i + 1} está vazia.`;
        }
      }

      if (
        Number(
          pergunta.correct_answer
        ) < 0 ||
        Number(
          pergunta.correct_answer
        ) > 3
      ) {
        return `Seleccione a resposta correcta da pergunta ${i + 1}.`;
      }
    }

    return "";
  }

  function validarETestaAba(
    destino
  ) {
    const cursoErro =
      validarCurso();

    if (cursoErro) {
      setErro(cursoErro);
      setAba("dados");
      return;
    }

    if (destino === "videos") {
      const videoErro =
        validarVideos();

      if (videoErro) {
        setErro(videoErro);
        setAba("videos");
        return;
      }
    }

    setErro("");
    setAba(destino);
  }

  async function guardar(event) {
    event.preventDefault();

    const erroCurso =
      validarCurso();

    if (erroCurso) {
      setErro(erroCurso);
      setAba("dados");
      return;
    }

    const erroVideos =
      validarVideos();

    if (erroVideos) {
      setErro(
        erroVideos
      );
      setAba("videos");
      return;
    }

    const erroPerguntas =
      validarPerguntas();

    if (erroPerguntas) {
      setErro(
        erroPerguntas
      );
      setAba("perguntas");
      return;
    }

    setSaving(true);
    setErro("");

    try {
      const payload = {
        title:
          titulo.trim(),
        description:
          descricao.trim(),
        link:
          link.trim(),
        published:
          publicado,
        videos:
          videos.map(
            (video) => ({
              title:
                video.title.trim(),
              description:
                video.description.trim(),
              link:
                video.link.trim(),
            })
          ),
        questions:
          perguntas.map(
            (pergunta) => ({
              question:
                pergunta.question.trim(),
              options:
                pergunta.options.map(
                  (opcao) =>
                    textoDaOpcao(opcao).trim()
                ),
              correct_answer:
                Number(
                  pergunta.correct_answer
                ),
            })
          ),
      };

      const resposta =
        await fetch(
          editar
            ? `${API_BASE}/courses/${curso.id}`
            : `${API_BASE}/courses`,
          {
            method: editar
              ? "PUT"
              : "POST",
            headers: {
              "Content-Type":
                "application/json",
            },
            body:
              JSON.stringify(
                payload
              ),
          }
        );

      const dados =
        await resposta
          .json()
          .catch(
            () => null
          );

      if (!resposta.ok) {
        throw new Error(
          erroAPI(
            dados,
            "Não foi possível guardar o curso."
          )
        );
      }

      onSaved(
        dados,
        editar
          ? "Curso actualizado com sucesso."
          : "Curso criado com sucesso."
      );
    } catch (error) {
      setErro(
        error?.message ||
          "Não foi possível guardar o curso."
      );
    } finally {
      setSaving(false);
    }
  }

  return (
    <Modal
      title={
        editar
          ? "Editar curso"
          : "Criar novo curso"
      }
      subtitle="Organize os dados, vídeos e a avaliação do curso."
      onClose={onClose}
    >
      <form
        onSubmit={guardar}
        className="p-5 sm:p-6"
      >
        <div className="grid gap-2 rounded-xl bg-slate-100 p-1 md:grid-cols-3">
          {[
            [
              "dados",
              "Dados do curso",
            ],
            [
              "videos",
              `Vídeos (${videos.length})`,
            ],
            [
              "perguntas",
              "10 perguntas",
            ],
          ].map(
            ([valor, texto]) => (
              <button
                key={valor}
                type="button"
                onClick={() =>
                  validarETestaAba(
                    valor
                  )
                }
                className={`rounded-lg px-3 py-2.5 text-xs font-black transition ${
                  aba === valor
                    ? "bg-white text-blue-700 shadow-sm"
                    : "text-slate-500 hover:text-slate-700"
                }`}
              >
                {texto}
              </button>
            )
          )}
        </div>

        {erro ? (
          <div className="mt-5 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-700">
            {erro}
          </div>
        ) : null}

        {aba === "dados" ? (
          <div className="mt-5 space-y-4">
            <div className="rounded-3xl border border-blue-100 bg-gradient-to-br from-blue-50 to-white p-5">
              <div className="flex items-center gap-3">
                <div className="flex h-11 w-11 items-center justify-center rounded-2xl bg-blue-600 text-white shadow-lg shadow-blue-600/20">
                  <BookOpen
                    size={21}
                  />
                </div>

                <div>
                  <p className="text-xs font-black uppercase tracking-wider text-blue-600">
                    Configuração
                  </p>

                  <p className="text-sm font-black text-slate-900">
                    Informações principais
                  </p>
                </div>
              </div>
            </div>

            <Campo
              label="Título"
              value={titulo}
              onChange={
                setTitulo
              }
              placeholder="Ex.: Fundamentos de Segurança Digital"
            />

            <Campo
              label="Descrição"
              value={
                descricao
              }
              onChange={
                setDescricao
              }
              placeholder="Descreva o objectivo e conteúdo do curso."
              textarea
            />

            <Campo
              label="Link do curso"
              value={link}
              onChange={
                setLink
              }
              placeholder="https://..."
            />

            <div className="flex items-center justify-between rounded-2xl border border-slate-200 bg-slate-50 p-4">
              <div>
                <p className="text-sm font-black text-slate-900">
                  Publicar curso
                </p>

                <p className="mt-1 text-xs text-slate-500">
                  Disponível na área do estudante.
                </p>
              </div>

              <button
                type="button"
                onClick={() =>
                  setPublicado(
                    (valor) =>
                      !valor
                  )
                }
                className={`relative h-7 w-12 rounded-full transition ${
                  publicado
                    ? "bg-blue-600"
                    : "bg-slate-300"
                }`}
              >
                <span
                  className={`absolute top-1 h-5 w-5 rounded-full bg-white shadow transition ${
                    publicado
                      ? "left-6"
                      : "left-1"
                  }`}
                />
              </button>
            </div>
          </div>
        ) : null}

        {aba === "videos" ? (
          <div className="mt-5 space-y-4">
            <div className="flex flex-col gap-4 rounded-3xl bg-gradient-to-br from-slate-950 via-blue-950 to-blue-700 p-6 text-white sm:flex-row sm:items-center sm:justify-between">
              <div>
                <div className="flex items-center gap-2 text-blue-200">
                  <Film size={18} />

                  <span className="text-xs font-black uppercase tracking-wider">
                    Conteúdo multimédia
                  </span>
                </div>

                <h3 className="mt-2 text-xl font-black">
                  Vídeos do curso
                </h3>

                <p className="mt-1 max-w-xl text-sm text-blue-100">
                  Adicione quantos vídeos forem necessários. Cada vídeo possui título, descrição e link.
                </p>
              </div>

              <button
                type="button"
                onClick={
                  adicionarVideo
                }
                className="inline-flex items-center justify-center gap-2 rounded-xl bg-white px-4 py-3 text-sm font-black text-blue-700 shadow-lg transition hover:-translate-y-0.5"
              >
                <Plus
                  size={17}
                />
                Adicionar vídeo
              </button>
            </div>

            {videos.length ===
            0 ? (
              <div className="rounded-3xl border border-dashed border-slate-300 bg-slate-50 p-10 text-center">
                <Film
                  size={38}
                  className="mx-auto text-slate-300"
                />

                <h3 className="mt-4 text-lg font-black text-slate-900">
                  Ainda não existem vídeos
                </h3>

                <p className="mt-1 text-sm text-slate-500">
                  Comece por adicionar o primeiro vídeo do curso.
                </p>

                <button
                  type="button"
                  onClick={
                    adicionarVideo
                  }
                  className="mt-5 inline-flex items-center gap-2 rounded-xl bg-blue-600 px-5 py-3 text-sm font-black text-white"
                >
                  <Plus
                    size={17}
                  />
                  Adicionar primeiro vídeo
                </button>
              </div>
            ) : null}

            {videos.map(
              (
                video,
                index
              ) => (
                <div
                  key={
                    video.id ||
                    `video-${index}`
                  }
                  className="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm"
                >
                  <div className="flex items-center justify-between gap-3">
                    <div className="flex items-center gap-3">
                      <div className="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
                        <Film
                          size={18}
                        />
                      </div>

                      <div>
                        <p className="text-[10px] font-black uppercase tracking-[0.13em] text-blue-600">
                          Vídeo{" "}
                          {index + 1}
                        </p>

                        <p className="text-sm font-black text-slate-900">
                          Conteúdo do curso
                        </p>
                      </div>
                    </div>

                    <button
                      type="button"
                      onClick={() =>
                        removerVideo(
                          index
                        )
                      }
                      className="rounded-xl p-2 text-red-400 transition hover:bg-red-50 hover:text-red-600"
                      title="Remover vídeo"
                    >
                      <Trash2
                        size={17}
                      />
                    </button>
                  </div>

                  <div className="mt-5 grid gap-5">
                    <Campo
                      label="Título do vídeo"
                      value={
                        video.title
                      }
                      onChange={(
                        valor
                      ) =>
                        atualizarVideo(
                          index,
                          "title",
                          valor
                        )
                      }
                      placeholder="Ex.: Introdução à Segurança Digital"
                    />

                    <Campo
                      label="Descrição do vídeo"
                      value={
                        video.description
                      }
                      onChange={(
                        valor
                      ) =>
                        atualizarVideo(
                          index,
                          "description",
                          valor
                        )
                      }
                      placeholder="Explique brevemente o conteúdo do vídeo."
                      textarea
                    />

                    <Campo
                      label="Link do vídeo"
                      value={
                        video.link
                      }
                      onChange={(
                        valor
                      ) =>
                        atualizarVideo(
                          index,
                          "link",
                          valor
                        )
                      }
                      placeholder="https://..."
                    />
                  </div>
                </div>
              )
            )}
          </div>
        ) : null}

