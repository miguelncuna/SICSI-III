function PerguntasModal({
  curso,
  onClose,
  onUpdated,
}) {
  const [perguntas, setPerguntas] =
    useState(
      normalizarPerguntas(
        curso.questions
      )
    );

  const [indice, setIndice] =
    useState(0);

  const [erro, setErro] =
    useState("");

  const [saving, setSaving] =
    useState(false);

  const pergunta =
    perguntas[indice];

  function atualizarCampo(
    campo,
    valor
  ) {
    setPerguntas((actual) =>
      actual.map(
        (item, index) =>
          index === indice
            ? {
                ...item,
                [campo]:
                  valor,
              }
            : item
      )
    );
  }

  function atualizarOpcao(
    opcaoIndex,
    valor
  ) {
    setPerguntas((actual) =>
      actual.map(
        (item, index) =>
          index === indice
            ? {
                ...item,
                options:
                  item.options.map(
                    (
                      opcao,
                      oi
                    ) =>
                      oi ===
                      opcaoIndex
                        ? valor
                        : opcao
                  ),
              }
            : item
      )
    );
  }

  async function guardar() {
    setErro("");

    if (!pergunta?.id) {
      setErro(
        "A pergunta não possui um ID válido."
      );
      return;
    }

    if (!pergunta.question.trim()) {
      setErro(
        "A pergunta é obrigatória."
      );
      return;
    }

    if (
      pergunta.options.some(
        (opcao) =>
          !String(
            opcao
          ).trim()
      )
    ) {
      setErro(
        "Todas as opções são obrigatórias."
      );
      return;
    }

    setSaving(true);

    try {
      const resposta =
        await fetch(
          `${API_BASE}/courses/${curso.id}/questions/${pergunta.id}`,
          {
            method: "PUT",
            headers: {
              "Content-Type":
                "application/json",
            },
            body: JSON.stringify({
              question:
                pergunta.question.trim(),
              options:
                pergunta.options.map(
                  (opcao) =>
                    opcao.trim()
                ),
              correct_answer:
                Number(
                  pergunta.correct_answer
                ),
            }),
          }
        );

      const dados =
        await resposta
          .json()
          .catch(
            () => null
          );

      if (!resposta.ok) {
        throw new Error(
          erroAPI(
            dados,
            "Não foi possível guardar a pergunta."
          )
        );
      }

      setPerguntas(
        normalizarPerguntas(
          dados.questions
        )
      );

      onUpdated(
        dados,
        `Pergunta ${indice + 1} actualizada com sucesso.`
      );
    } catch (error) {
      setErro(
        error?.message ||
          "Não foi possível guardar a pergunta."
      );
    } finally {
      setSaving(false);
    }
  }

  return (
    <Modal
      title={`Perguntas · ${curso.title}`}
      subtitle="10 perguntas, 4 opções por pergunta."
      onClose={onClose}
    >
      <div className="grid gap-6 p-6 lg:grid-cols-[215px_1fr]">
        <aside className="rounded-2xl border border-slate-200 bg-slate-50 p-3">
          <p className="px-2 pb-3 text-[10px] font-black uppercase tracking-wider text-slate-400">
            Navegação
          </p>

          <div className="grid grid-cols-5 gap-2 lg:grid-cols-1">
            {perguntas.map(
              (
                item,
                index
              ) => (
                <button
                  key={
                    item.id ||
                    index
                  }
                  type="button"
                  onClick={() =>
                    setIndice(
                      index
                    )
                  }
                  className={`rounded-xl px-3 py-2 text-left text-xs font-black ${
                    indice ===
                    index
                      ? "bg-blue-600 text-white"
                      : "bg-white text-slate-600 hover:bg-blue-50"
                  }`}
                >
                  Pergunta{" "}
                  {index + 1}
                </button>
              )
            )}
          </div>
        </aside>

        <div className="rounded-2xl border border-slate-200 bg-white p-5">
          {erro ? (
            <div className="mb-5 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-700">
              {erro}
            </div>
          ) : null}

          <Campo
            label="Pergunta"
            value={
              pergunta?.question ||
              ""
            }
            onChange={(
              valor
            ) =>
              atualizarCampo(
                "question",
                valor
              )
            }
            placeholder="Escreva a pergunta."
            textarea
          />

          <div className="mt-5 grid gap-4 md:grid-cols-2">
            {(
              pergunta?.options ||
              []
            ).map(
              (
                opcao,
                opcaoIndex
              ) => (
                <div
                  key={
                    opcaoIndex
                  }
                >
                  <div className="flex items-center justify-between">
                    <span className="text-[10px] font-black uppercase tracking-wider text-slate-500">
                      Opção{" "}
                      {opcaoIndex +
                        1}
                    </span>

                    <label className="flex items-center gap-2 text-xs font-bold text-slate-500">
                      <input
                        type="radio"
                        name={`edit-${curso.id}`}
                        checked={
                          Number(
                            pergunta.correct_answer
                          ) ===
                          opcaoIndex
                        }
                        onChange={() =>
                          atualizarCampo(
                            "correct_answer",
                            opcaoIndex
                          )
                        }
                        className="accent-blue-600"
                      />

                      correcta
                    </label>
                  </div>

                  <input
                    value={opcao}
                    onChange={(
                      event
                    ) =>
                      atualizarOpcao(
                        opcaoIndex,
                        event
                          .target
                          .value
                      )
                    }
                    className="mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-semibold !text-slate-900 placeholder:text-slate-400 outline-none focus:border-blue-400 focus:ring-4 focus:ring-blue-500/10"
                    style={{
                      color:
                        "#0f172a",
                      WebkitTextFillColor:
                        "#0f172a",
                    }}
                  />
                </div>
              )
            )}
          </div>

          <div className="mt-6 flex flex-wrap justify-between gap-3 border-t border-slate-200 pt-5">
            <div className="flex gap-2">
              <button
                type="button"
                disabled={
                  indice === 0
                }
                onClick={() =>
                  setIndice(
                    (valor) =>
                      Math.max(
                        0,
                        valor - 1
                      )
                  )
                }
                className="inline-flex items-center gap-2 rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-bold text-slate-600 disabled:opacity-40"
              >
                <ChevronLeft
                  size={15}
                />
                Anterior
              </button>

              <button
                type="button"
                disabled={
                  indice ===
                  TOTAL_PERGUNTAS -
                    1
                }
                onClick={() =>
                  setIndice(
                    (valor) =>
                      Math.min(
                        TOTAL_PERGUNTAS -
                          1,
                        valor + 1
                      )
                  )
                }
                className="inline-flex items-center gap-2 rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-bold text-slate-600 disabled:opacity-40"
              >
                Próxima
                <ChevronRight
                  size={15}
                />
              </button>
            </div>

            <button
              type="button"
              onClick={
                guardar
              }
              disabled={
                saving
              }
              className="inline-flex items-center gap-2 rounded-xl bg-blue-600 px-5 py-2.5 text-sm font-black text-white hover:bg-blue-700 disabled:opacity-60"
            >
              {saving ? (
                <LoaderCircle
                  size={16}
                  className="animate-spin"
                />
              ) : (
                <Check
                  size={16}
                />
              )}

              {saving
                ? "A guardar..."
                : "Guardar pergunta"}
            </button>
          </div>
        </div>
      </div>
    </Modal>
  );
}

