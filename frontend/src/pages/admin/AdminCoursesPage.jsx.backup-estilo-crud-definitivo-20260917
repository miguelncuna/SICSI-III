export default function AdminCoursesPage() {
  const [cursos, setCursos] =
    useState([]);

  const [pesquisa, setPesquisa] =
    useState("");

  const [loading, setLoading] =
    useState(true);

  const [modal, setModal] =
    useState(null);

  const [toast, setToast] =
    useState(null);

  function notificar(
    message,
    type = "success"
  ) {
    setToast({
      message,
      type,
    });
  }

  async function carregarCursos() {
    setLoading(true);

    try {
      const resposta =
        await fetch(
          `${API_BASE}/courses`
        );

      const dados =
        await resposta
          .json()
          .catch(
            () => null
          );

      if (!resposta.ok) {
        throw new Error(
          erroAPI(
            dados,
            "Não foi possível carregar os cursos."
          )
        );
      }

      setCursos(
        Array.isArray(dados)
          ? dados
          : []
      );
    } catch (error) {
      notificar(
        error?.message ||
          "Não foi possível carregar os cursos.",
        "error"
      );
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    carregarCursos();
  }, []);

  useEffect(() => {
    if (!toast) {
      return undefined;
    }

    const timer =
      setTimeout(
        () =>
          setToast(
            null
          ),
        4500
      );

    return () =>
      clearTimeout(timer);
  }, [toast]);

  const filtrados =
    useMemo(() => {
      const termo =
        pesquisa
          .trim()
          .toLowerCase();

      if (!termo) {
        return cursos;
      }

      return cursos.filter(
        (curso) =>
          String(
            curso.title ||
              ""
          )
            .toLowerCase()
            .includes(
              termo
            ) ||
          String(
            curso.description ||
              ""
          )
            .toLowerCase()
            .includes(
              termo
            )
      );
    }, [
      cursos,
      pesquisa,
    ]);

  const total =
    cursos.length;

  const publicados =
    cursos.filter(
      (curso) =>
        curso.published !==
        false
    ).length;

  const rascunhos =
    total - publicados;

  async function guardarCurso(
    dados,
    mensagem
  ) {
    setCursos((actual) => {
      const existe =
        actual.some(
          (item) =>
            item.id ===
            dados.id
        );

      return existe
        ? actual.map(
            (item) =>
              item.id ===
              dados.id
                ? dados
                : item
          )
        : [
            ...actual,
            dados,
          ];
    });

    setModal(null);
    notificar(
      mensagem
    );
  }

  async function alterarPublicacao(
    curso
  ) {
    try {
      const resposta =
        await fetch(
          `${API_BASE}/courses/${curso.id}/publish`,
          {
            method: "PATCH",
            headers: {
              "Content-Type":
                "application/json",
            },
            body: JSON.stringify({
              published:
                curso.published ===
                false,
            }),
          }
        );

      const dados =
        await resposta
          .json()
          .catch(
            () => null
          );

      if (!resposta.ok) {
        throw new Error(
          erroAPI(
            dados,
            "Não foi possível alterar a publicação."
          )
        );
      }

      setCursos((actual) =>
        actual.map(
          (item) =>
            item.id ===
            curso.id
              ? dados
              : item
        )
      );

      notificar(
        dados.published
          ? "Curso publicado com sucesso."
          : "Curso retirado da publicação."
      );
    } catch (error) {
      notificar(
        error?.message ||
          "Não foi possível alterar a publicação.",
        "error"
      );
    }
  }

  async function eliminarCurso(
    curso
  ) {
    const confirmar =
      window.confirm(
        `Tem a certeza que deseja eliminar "${curso.title}"?\n\nEsta operação é permanente.`
      );

    if (!confirmar) {
      return;
    }

    try {
      const resposta =
        await fetch(
          `${API_BASE}/courses/${curso.id}?confirm=true`,
          {
            method: "DELETE",
          }
        );

      const dados =
        await resposta
          .json()
          .catch(
            () => null
          );

      if (!resposta.ok) {
        throw new Error(
          erroAPI(
            dados,
            "Não foi possível eliminar o curso."
          )
        );
      }

      setCursos((actual) =>
        actual.filter(
          (item) =>
            item.id !==
            curso.id
        )
      );

      notificar(
        "Curso eliminado com sucesso."
      );
    } catch (error) {
      notificar(
        error?.message ||
          "Não foi possível eliminar o curso.",
        "error"
      );
    }
  }

  function abrirCurso(
    curso
  ) {
    const url =
      String(
        curso.link || ""
      ).trim();

    if (!url) {
      notificar(
        "Este curso não possui um link.",
        "error"
      );
      return;
    }

    window.open(
      url,
      "_blank",
      "noopener,noreferrer"
    );
  }

  function actualizarDepoisPergunta(
    dados,
    mensagem
  ) {
    setCursos((actual) =>
      actual.map(
        (item) =>
          item.id ===
          dados.id
            ? dados
            : item
      )
    );

    notificar(
      mensagem
    );
  }

  return (
    <div className="space-y-6">
      <section className="relative overflow-hidden rounded-[30px] bg-gradient-to-br from-blue-700 via-blue-600 to-indigo-700 p-6 text-white shadow-2xl shadow-blue-600/20 lg:p-8">
        <div className="absolute -right-20 -top-20 h-64 w-64 rounded-full bg-white/10 blur-3xl" />
        <div className="absolute -bottom-24 left-1/3 h-64 w-64 rounded-full bg-cyan-300/10 blur-3xl" />

        <div className="relative grid gap-6 xl:grid-cols-[1.4fr_1fr_auto] xl:items-center">
          <div>
            <div className="flex items-center gap-2 text-blue-100">
              <ShieldCheck
                size={18}
              />

              <span className="text-[11px] font-black uppercase tracking-[0.18em]">
                Cursos
              </span>
            </div>

            <h1 className="mt-2 text-3xl font-black tracking-tight lg:text-4xl">
              Gestão de Cursos
            </h1>

            <p className="mt-2 max-w-xl text-sm leading-6 text-blue-100 lg:text-base">
              Crie, organize e administre a formação de cibersegurança do SICSI III.
            </p>
          </div>

          <div className="grid grid-cols-3 gap-3">
            <div className="rounded-2xl border border-white/10 bg-white/10 p-4 backdrop-blur">
              <BookOpen
                size={18}
              />

              <p className="mt-2 text-2xl font-black">
                {total}
              </p>

              <p className="text-[10px] font-bold uppercase tracking-wider text-blue-100">
                Cursos
              </p>
            </div>

            <div className="rounded-2xl border border-white/10 bg-white/10 p-4 backdrop-blur">
              <CheckCircle2
                size={18}
              />

              <p className="mt-2 text-2xl font-black">
                {publicados}
              </p>

              <p className="text-[10px] font-bold uppercase tracking-wider text-blue-100">
                Publicados
              </p>
            </div>

            <div className="rounded-2xl border border-white/10 bg-white/10 p-4 backdrop-blur">
              <EyeOff
                size={18}
              />

              <p className="mt-2 text-2xl font-black">
                {rascunhos}
              </p>

              <p className="text-[10px] font-bold uppercase tracking-wider text-blue-100">
                Rascunhos
              </p>
            </div>
          </div>

          <button
            type="button"
            onClick={() =>
              setModal({
                type: "curso",
                curso: null,
              })
            }
            className="flex min-w-[190px] items-center justify-between gap-4 rounded-2xl bg-white px-5 py-4 text-left text-slate-900 shadow-xl transition hover:-translate-y-1"
          >
            <span>
              <span className="block text-[10px] font-black uppercase tracking-wider text-blue-600">
                Criar
              </span>

              <span className="mt-1 block text-sm font-black">
                Novo curso
              </span>

              <span className="mt-1 block text-[11px] text-slate-400">
                Curso + vídeos + avaliação
              </span>
            </span>

            <span className="flex h-11 w-11 items-center justify-center rounded-xl bg-blue-600 text-white">
              <Plus
                size={20}
              />
            </span>
          </button>
        </div>
      </section>

      <section className="flex flex-col gap-3 lg:flex-row">
        <div className="relative flex-1">
          <Search
            size={18}
            className="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"
          />

          <input
            value={
              pesquisa
            }
            onChange={(
              event
            ) =>
              setPesquisa(
                event.target
                  .value
              )
            }
            placeholder="Pesquisar cursos..."
            className="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3.5 pl-11 text-sm font-semibold !text-slate-900 placeholder:text-slate-400 shadow-sm outline-none focus:border-blue-300 focus:ring-4 focus:ring-blue-500/10"
            style={{
              color:
                "#0f172a",
              WebkitTextFillColor:
                "#0f172a",
            }}
          />
        </div>

        <button
          type="button"
          onClick={
            carregarCursos
          }
          disabled={
            loading
          }
          className="inline-flex items-center justify-center gap-2 rounded-2xl border border-slate-200 bg-white px-5 py-3.5 text-sm font-black text-slate-700 shadow-sm hover:border-blue-200 hover:text-blue-700 disabled:opacity-50"
        >
          <RefreshCw
            size={17}
            className={
              loading
                ? "animate-spin"
                : ""
            }
          />
          Actualizar
        </button>
      </section>

      {loading ? (
        <section className="flex min-h-[360px] items-center justify-center rounded-[30px] border border-slate-200 bg-white">
          <div className="flex items-center gap-3 text-sm font-bold text-slate-500">
            <LoaderCircle
              size={22}
              className="animate-spin text-blue-600"
            />
            A carregar cursos...
          </div>
        </section>
      ) : filtrados.length ===
        0 ? (
        <section className="flex min-h-[360px] flex-col items-center justify-center rounded-[30px] border border-dashed border-slate-300 bg-white text-center">
          <BookOpen
            size={44}
            className="text-slate-300"
          />

          <h2 className="mt-4 text-lg font-black text-slate-900">
            Nenhum curso encontrado
          </h2>

          <p className="mt-1 text-sm text-slate-500">
            Tente outra pesquisa.
          </p>
        </section>
      ) : (
        <section className="grid gap-5 md:grid-cols-2 xl:grid-cols-4">
          {filtrados
            .map(
              (
                curso,
                index
              ) => (
                <CursoCard
                  key={
                    curso.id
                  }
                  curso={
                    curso
                  }
                  indice={
                    index
                  }
                  onEdit={(
                    item
                  ) =>
                    setModal({
                      type: "curso",
                      curso: item,
                    })
                  }
                  onQuestions={(
                    item
                  ) =>
                    setModal({
                      type: "perguntas",
                      curso: item,
                    })
                  }
                  onPublish={
                    alterarPublicacao
                  }
                  onDelete={
                    eliminarCurso
                  }
                  onOpen={
                    abrirCurso
                  }
                />
              )
            )}
        </section>
      )}

      {modal?.type ===
      "curso" ? (
        <CursoModal
          key={
            modal.curso?.id ||
            "novo"
          }
          curso={
            modal.curso
          }
          onClose={() =>
            setModal(null)
          }
          onSaved={
            guardarCurso
          }
        />
      ) : null}

      {modal?.type ===
      "perguntas" ? (
        <PerguntasModal
          key={
            modal.curso.id
          }
          curso={
            cursos.find(
              (item) =>
                item.id ===
                modal.curso.id
            ) ||
            modal.curso
          }
          onClose={() =>
            setModal(null)
          }
          onUpdated={
            actualizarDepoisPergunta
          }
        />
      ) : null}

      {toast ? (
        <div
          className={`fixed bottom-5 right-5 z-[120] max-w-md rounded-2xl px-5 py-3 text-sm font-bold text-white shadow-2xl ${
            toast.type ===
            "error"
              ? "bg-red-600"
              : "bg-slate-950"
          }`}
        >
          {toast.message}
        </div>
      ) : null}
    </div>
  );
}
