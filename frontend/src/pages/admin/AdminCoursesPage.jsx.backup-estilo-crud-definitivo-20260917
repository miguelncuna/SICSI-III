const API_BASE =
  "http://127.0.0.1:8000/api/course-admin";

const TOTAL_PERGUNTAS = 10;
const TOTAL_OPCOES = 4;

const CURSOS_VISUAIS = [
  "from-blue-950 via-blue-800 to-cyan-500",
  "from-indigo-950 via-violet-800 to-fuchsia-500",
  "from-red-950 via-rose-800 to-orange-500",
  "from-emerald-950 via-green-800 to-teal-500",
];

function perguntaVazia() {
  return {
    id: "",
    question: "",
    options: ["", "", "", ""],
    correct_answer: 0,
  };
}

function videoVazio() {
  return {
    id: "",
    title: "",
    description: "",
    link: "",
  };
}

function perguntasVazias() {
  return Array.from(
    { length: TOTAL_PERGUNTAS },
    () => perguntaVazia()
  );
}

function textoDaOpcao(opcao) {
  if (
    opcao &&
    typeof opcao === "object"
  ) {
    return String(
      opcao.text ??
        opcao.label ??
        opcao.title ??
        opcao.value ??
        opcao.name ??
        ""
    );
  }

  return String(
    opcao ?? ""
  );
}

function criarPergunta() {
  return perguntaVazia();
}

function normalizarPerguntas(perguntas) {
  const origem =
    Array.isArray(perguntas)
      ? perguntas
      : [];

  return Array.from(
    {
      length:
        TOTAL_PERGUNTAS,
    },
    (_, index) => {
      const item =
        origem[index];

      if (!item) {
        return criarPergunta();
      }

      const options =
        Array.isArray(
          item.options
        )
          ? item.options.map(
              (opcao) =>
                textoDaOpcao(
                  opcao
                )
            )
          : [];

      while (
        options.length <
        TOTAL_OPCOES
      ) {
        options.push("");
      }

      return {
        id: String(
          item.id || ""
        ),
        question: String(
          item.question ||
            ""
        ),
        options:
          options.slice(
            0,
            TOTAL_OPCOES
          ),
        correct_answer:
          Number.isInteger(
            Number(
              item.correct_answer
            )
          )
            ? Number(
                item.correct_answer
              )
            : 0,
      };
    }
  );
}
function normalizarVideos(
  lista
) {
  return Array.isArray(
    lista
  )
    ? lista.map((video) => ({
        id: String(
          video?.id || ""
        ),
        title: String(
          video?.title || ""
        ),
        description:
          String(
            video?.description ||
              ""
          ),
        link: String(
          video?.link || ""
        ),
      }))
    : [];
}

function erroAPI(
  dados,
  fallback
) {
  if (
    typeof dados?.detail ===
    "string"
  ) {
    return dados.detail;
  }

  if (
    Array.isArray(
      dados?.detail
    )
  ) {
    return dados.detail
      .map(
        (item) =>
          item?.msg
      )
      .filter(Boolean)
      .join(" ");
  }

  return fallback;
}

function visualCurso(index) {
  return (
    CURSOS_VISUAIS[
      index % CURSOS_VISUAIS.length
    ]
  );
}

