import { useEffect, useMemo, useState } from "react";
import {
  Award,
  Download,
  Eye,
  Search,
} from "lucide-react";

const API = "http://127.0.0.1:8000/api";

async function getCertificates() {
  const response = await fetch(`${API}/certificates`);
  const data = await response.json().catch(() => []);

  if (!response.ok) {
    throw new Error(
      typeof data.detail === "string"
        ? data.detail
        : "Não foi possível carregar os certificados."
    );
  }

  return data;
}

function formatDate(value) {
  if (!value) return "—";

  try {
    return new Date(value).toLocaleDateString("pt-PT");
  } catch {
    return value;
  }
}

export default function AdminCertificatesPage() {
  const [certificates, setCertificates] = useState([]);
  const [search, setSearch] = useState("");
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");

  async function load() {
    setLoading(true);
    setError("");

    try {
      const data = await getCertificates();
      setCertificates(Array.isArray(data) ? data : []);
    } catch (err) {
      setError(err.message);
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    load();
  }, []);

  const filtered = useMemo(() => {
    const query = search.trim().toLowerCase();

    if (!query) return certificates;

    return certificates.filter((item) =>
      [
        item.student_name,
        item.course_title,
        item.certificate_code,
      ]
        .map((value) =>
          String(value || "").toLowerCase()
        )
        .some((value) => value.includes(query))
    );
  }, [certificates, search]);

  function viewCertificate(certificate) {
    window.open(
      `${API}/certificates/${certificate.id}/pdf`,
      "_blank",
      "noopener,noreferrer"
    );
  }

  async function downloadCertificate(certificate) {
    try {
      const response = await fetch(
        `${API}/certificates/${certificate.id}/pdf`
      );

      if (!response.ok) {
        throw new Error(
          "Não foi possível descarregar o certificado."
        );
      }

      const blob = await response.blob();
      const url = URL.createObjectURL(blob);

      const link = document.createElement("a");
      link.href = url;
      link.download =
        `CERTIFICADO-SICSI-III-${certificate.student_name || "estudante"}.pdf`;

      document.body.appendChild(link);
      link.click();
      link.remove();

      URL.revokeObjectURL(url);
    } catch (err) {
      setError(err.message);
    }
  }

  return (
    <main className="min-h-[calc(100vh-64px)] p-5 sm:p-8">
      <div className="mx-auto max-w-[1500px]">
        <p className="text-xs font-black uppercase tracking-[0.18em] text-blue-600">
          Administração
        </p>

        <h1 className="mt-2 text-3xl font-black tracking-tight text-slate-950">
          Certificados
        </h1>

        <p className="mt-2 max-w-2xl text-sm leading-6 text-slate-500">
          Consulte os certificados emitidos pelo SICSI III.
        </p>

        {error && (
          <div className="mt-6 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-700">
            {error}
          </div>
        )}

        <section className="mt-7 overflow-hidden rounded-[28px] border border-slate-200 bg-white shadow-sm">
          <div className="border-b border-slate-100 p-4">
            <div className="relative">
              <Search
                size={17}
                className="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"
              />

              <input
                value={search}
                onChange={(event) =>
                  setSearch(event.target.value)
                }
                placeholder="Pesquisar por estudante, curso ou código..."
                className="h-11 w-full rounded-xl border border-slate-200 bg-slate-50 pl-10 pr-4 text-sm font-semibold outline-none focus:border-blue-400 focus:bg-white"
              />
            </div>
          </div>

          {loading ? (
            <div className="p-8 text-sm font-semibold text-slate-400">
              A carregar certificados...
            </div>
          ) : filtered.length === 0 ? (
            <div className="p-10 text-center">
              <Award
                className="mx-auto text-slate-300"
                size={38}
              />

              <p className="mt-3 text-sm font-black text-slate-700">
                Nenhum certificado encontrado
              </p>
            </div>
          ) : (
            <div className="overflow-x-auto">
              <table className="min-w-[900px] w-full">
                <thead>
                  <tr className="border-b border-slate-100 text-left text-[11px] font-black uppercase tracking-wider text-slate-400">
                    <th className="px-5 py-4">Estudante</th>
                    <th className="px-5 py-4">Curso</th>
                    <th className="px-5 py-4">Código</th>
                    <th className="px-5 py-4">Emitido</th>
                    <th className="px-5 py-4 text-right">
                      Acções
                    </th>
                  </tr>
                </thead>

                <tbody>
                  {filtered.map((item) => (
                    <tr
                      key={item.id}
                      className="border-b border-slate-100 last:border-0 hover:bg-slate-50"
                    >
                      <td className="px-5 py-4 text-sm font-black text-slate-900">
                        {item.student_name || "Estudante"}
                      </td>

                      <td className="px-5 py-4 text-sm font-semibold text-slate-600">
                        {item.course_title || "Curso"}
                      </td>

                      <td className="px-5 py-4 font-mono text-xs font-semibold text-slate-500">
                        {item.certificate_code || "—"}
                      </td>

                      <td className="px-5 py-4 text-xs font-semibold text-slate-500">
                        {formatDate(
                          item.issued_at ||
                            item.created_at
                        )}
                      </td>

                      <td className="px-5 py-4">
                        <div className="flex justify-end gap-2">
                          <button
                            type="button"
                            onClick={() =>
                              viewCertificate(item)
                            }
                            className="inline-flex items-center gap-2 rounded-xl bg-blue-50 px-3.5 py-2 text-xs font-black text-blue-700 hover:bg-blue-100"
                          >
                            <Eye size={14} />
                            Ver
                          </button>

                          <button
                            type="button"
                            onClick={() =>
                              downloadCertificate(item)
                            }
                            className="inline-flex items-center gap-2 rounded-xl bg-emerald-50 px-3.5 py-2 text-xs font-black text-emerald-700 hover:bg-emerald-100"
                          >
                            <Download size={14} />
                            Baixar
                          </button>
                        </div>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </section>
      </div>
    </main>
  );
}
