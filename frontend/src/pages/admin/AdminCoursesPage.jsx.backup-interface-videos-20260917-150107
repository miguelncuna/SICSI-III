} from "lucide-react";

const API_BASE =
  "http://127.0.0.1:8000/api/course-admin";

const TOTAL_PERGUNTAS = 10;
const TOTAL_OPCOES = 4;

const CURSOS_VISUAIS = [
  {
    match: "fundamentos",
    classe:
      "from-sky-950 via-blue-800 to-cyan-500",
    badge: "🔐",
  },
  {
    match: "contas",
    classe:
      "from-violet-950 via-indigo-800 to-fuchsia-500",
    badge: "👤",
  },
  {
    match: "phishing",
    classe:
      "from-red-950 via-rose-800 to-orange-500",
    badge: "🎣",
  },
  {
    match: "engenharia",
    classe:
      "from-emerald-950 via-green-800 to-teal-500",
    badge: "🕵️",
  },
];

function criarPergunta() {
  return {
    id: "",
    question: "",
    options: ["", "", "", ""],
    correct_answer: 0,
  };
}

function criarPerguntas() {
  return Array.from(
    { length: TOTAL_PERGUNTAS },
    () => criarPergunta()
  );
}

function normalizarPerguntas(lista) {
  const origem = Array.isArray(lista)
    ? lista
    : [];

  return Array.from(
    { length: TOTAL_PERGUNTAS },
    (_, index) => {
      const item = origem[index];

      if (!item) {
        return criarPergunta();
      }

      let options = Array.isArray(item.options)
        ? item.options.map((valor) =>
            String(valor ?? "")
          )
        : [];

      while (options.length < TOTAL_OPCOES) {
        options.push("");
      }

      return {
        id: String(item.id || ""),
        question: String(
          item.question || ""
        ),
        options: options.slice(
          0,
          TOTAL_OPCOES
        ),
        correct_answer:
          Number.isInteger(
            Number(item.correct_answer)
          )
            ? Number(
                item.correct_answer
              )
            : 0,
      };
    }
  );
}

function erroDaAPI(
  dados,
  fallback
) {
  if (
    typeof dados?.detail ===
    "string"
  ) {
    return dados.detail;
  }

  if (
    Array.isArray(
      dados?.detail
    )
  ) {
    return dados.detail
      .map(
        (item) =>
          item?.msg
      )
      .filter(Boolean)
      .join(" ");
  }

  return fallback;
}

function visualDoCurso(titulo) {
  const nome = String(
    titulo || ""
  ).toLowerCase();

  return (
    CURSOS_VISUAIS.find(
      (item) =>
        nome.includes(item.match)
    ) ||
    {
      classe:
        "from-slate-950 via-blue-900 to-blue-500",
      badge: "🛡️",
    }
  );
}

