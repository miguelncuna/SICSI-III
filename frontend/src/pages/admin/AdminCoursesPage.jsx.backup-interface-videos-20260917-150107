                  "question",
                  valor
                )
              }
              placeholder="Escreva a pergunta."
              textarea
            />

            <div className="grid gap-4 md:grid-cols-2">
              {(
                pergunta?.options ||
                []
              ).map(
                (
                  opcao,
                  opcaoIndex
                ) => (
                  <div
                    key={
                      opcaoIndex
                    }
                  >
                    <div className="flex items-center justify-between">
                      <span className="text-xs font-black uppercase tracking-[0.1em] text-slate-500">
                        Opção{" "}
                        {opcaoIndex +
                          1}
                      </span>

                      <label className="flex items-center gap-2 text-xs font-bold text-slate-500">
                        <input
                          type="radio"
                          name={`correct-edit-${curso.id}`}
                          checked={
                            Number(
                              pergunta.correct_answer
                            ) ===
                            opcaoIndex
                          }
                          onChange={() =>
                            atualizarCampo(
                              "correct_answer",
                              opcaoIndex
                            )
                          }
                          className="accent-blue-600"
                        />
                        correcta
                      </label>
                    </div>

                    <input
                      value={
                        opcao
                      }
                      onChange={(
                        event
                      ) =>
                        atualizarOpcao(
                          opcaoIndex,
                          event
                            .target
                            .value
                        )
                      }
                      className="mt-2 w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm font-semibold outline-none focus:border-blue-300 focus:ring-4 focus:ring-blue-50"
                    />
                  </div>
                )
              )}
            </div>

            <div className="flex flex-wrap items-center justify-between gap-3 border-t border-slate-200 pt-5">
              <div className="flex gap-2">
                <button
                  type="button"
                  disabled={
                    indice === 0
                  }
                  onClick={() =>
                    setIndice(
                      (valor) =>
                        Math.max(
                          0,
                          valor - 1
                        )
                    )
                  }
                  className="rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-bold text-slate-600 disabled:opacity-40"
                >
                  Anterior
                </button>

                <button
                  type="button"
                  disabled={
                    indice ===
                    TOTAL_PERGUNTAS -
                      1
                  }
                  onClick={() =>
                    setIndice(
                      (valor) =>
                        Math.min(
                          TOTAL_PERGUNTAS -
                            1,
                          valor + 1
                        )
                    )
                  }
                  className="rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-bold text-slate-600 disabled:opacity-40"
                >
                  Próxima
                </button>
              </div>

              <button
                type="button"
                disabled={
                  saving
                }
                onClick={
                  guardarPergunta
                }
                className="inline-flex items-center gap-2 rounded-xl bg-blue-600 px-5 py-2.5 text-sm font-black text-white hover:bg-blue-700 disabled:opacity-60"
              >
                {saving ? (
                  <LoaderCircle
                    size={16}
                    className="animate-spin"
                  />
                ) : (
                  <Check size={16} />
                )}

                {saving
                  ? "A guardar..."
                  : "Guardar pergunta"}
              </button>
            </div>
          </div>
        </div>
      </div>
    </Modal>
  );
}

