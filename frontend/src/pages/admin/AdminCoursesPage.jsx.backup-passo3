export default function AdminCoursesPage() {
  const [cursos, setCursos] = useState([]);
  const [loading, setLoading] =
    useState(true);
  const [saving, setSaving] =
    useState(false);

  const [erro, setErro] = useState("");
  const [sucesso, setSucesso] =
    useState("");

  const [pesquisa, setPesquisa] =
    useState("");
  const [filtro, setFiltro] =
    useState("todos");

  const [cursoModal, setCursoModal] =
    useState(false);
  const [testeModal, setTesteModal] =
    useState(false);

  const [cursoActual, setCursoActual] =
    useState(null);

  const [formulario, setFormulario] =
    useState(CURSO_VAZIO);

  const [perguntas, setPerguntas] =
    useState(perguntasVazias());

  const [cursoEliminar, setCursoEliminar] =
    useState(null);

  async function carregarCursos() {
    setLoading(true);

    try {
      const resposta = await fetch(
        `${API_BASE}/admin/courses`
      );

      if (!resposta.ok) {
        throw new Error(
          "Não foi possível carregar os cursos."
        );
      }

      const dados = await resposta.json();

      setCursos(
        normalizarCursos(dados)
      );

      setErro("");
    } catch (error) {
      setErro(
        error?.message ||
          "Erro ao carregar os cursos."
      );
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    carregarCursos();
  }, []);

  useEffect(() => {
    if (!sucesso) return;

    const timer = window.setTimeout(
      () => setSucesso(""),
      3500
    );

    return () =>
      window.clearTimeout(timer);
  }, [sucesso]);

  function abrirNovoCurso() {
    setCursoActual(null);
    setFormulario(CURSO_VAZIO);
    setPerguntas(perguntasVazias());
    setCursoModal(true);
    setErro("");
  }

  function abrirEditarCurso(curso) {
    setCursoActual(curso);

    setFormulario({
      title: curso.title || "",
      description:
        curso.description || "",
      level: curso.level || "Básico",
      published: Boolean(
        curso.published
      ),
      image_url:
        curso.image_url || "",
      link:
        curso.link || "",
    });

    setCursoModal(true);
    setErro("");
  }

  function abrirTeste(curso) {
    setCursoActual(curso || null);

    if (curso?.questions) {
      setPerguntas(
        normalizarPerguntas(
          curso.questions
        )
      );
    }

    setTesteModal(true);
    setErro("");
  }
  function fecharCursoModal() {
    if (saving) return;

    setCursoModal(false);
  }

  function fecharTesteModal() {
    if (saving) return;

    setTesteModal(false);

    if (!cursoActual?.id) {
      setCursoModal(true);
    }
  }
  async function guardarCurso(event) {
    event?.preventDefault?.();

    const titulo =
      formulario.title.trim();

    const descricao =
      formulario.description.trim();

    const fotografia =
      String(formulario.image_url || "").trim();

    const linkCurso =
      String(formulario.link || "").trim();

    if (!titulo) {
      setErro("Indique o nome do curso.");
      return;
    }

    if (!descricao) {
      setErro("Indique a descrição do curso.");
      return;
    }

    if (!fotografia) {
      setErro("Indique a fotografia do curso.");
      return;
    }

    if (!/^https?:\/\//i.test(fotografia)) {
      setErro(
        "A fotografia deve começar por http:// ou https://."
      );
      return;
    }

    if (!linkCurso) {
      setErro("Indique o link do curso.");
      return;
    }

    if (!/^https?:\/\//i.test(linkCurso)) {
      setErro(
        "O link do curso deve começar por http:// ou https://."
      );
      return;
    }

    const editar =
      Boolean(cursoActual?.id);

    if (!editar) {
      const erroTeste =
        validarTeste();

      if (erroTeste) {
        setErro(erroTeste);
        return;
      }
    }

    setSaving(true);
    setErro("");

    try {
      const url = editar
        ? `${API_BASE}/admin/courses/${cursoActual.id}`
        : `${API_BASE}/admin/courses`;

      const payload = {
        title: titulo,
        description: descricao,
        published:
          Boolean(formulario.published),
        image_url: fotografia,
        link: linkCurso,
      };

      if (!editar) {
        payload.questions =
          perguntas.map((pergunta) => ({
            question:
              pergunta.question.trim(),
            options:
              pergunta.options.map(
                (opcao) => opcao.trim()
              ),
            correct_answer:
              Number(
                pergunta.correct_answer
              ),
            explanation:
              pergunta.explanation.trim(),
          }));
      }

      const resposta =
        await fetch(url, {
          method: editar
            ? "PUT"
            : "POST",
          headers: {
            "Content-Type":
              "application/json",
          },
          body: JSON.stringify(
            payload
          ),
        });

      const dados =
        await resposta
          .json()
          .catch(() => null);

      if (!resposta.ok) {
        throw new Error(
          dados?.detail ||
            "Não foi possível guardar o curso."
        );
      }

      await carregarCursos();

      setCursoActual(
        normalizarCursos([dados])[0]
      );

      setCursoModal(false);
      setTesteModal(false);

      if (!editar) {
        setPerguntas(
          perguntasVazias()
        );

        setSucesso(
          "Curso criado com sucesso, incluindo as 10 perguntas."
        );
      } else {
        setSucesso(
          "Curso actualizado com sucesso."
        );
      }

    } catch (error) {
      setErro(
        error?.message ||
          "Não foi possível guardar o curso."
      );
    } finally {
      setSaving(false);
    }
  }

  function validarTeste() {
    for (
      let index = 0;
      index < perguntas.length;
      index += 1
    ) {
      const pergunta =
        perguntas[index];

      if (!pergunta.question.trim()) {
        return `Preencha a pergunta ${
          pergunta.numero
        }.`;
      }

      if (
        pergunta.options.length !==
        OPCOES_POR_PERGUNTA
      ) {
        return `A pergunta ${
          pergunta.numero
        } precisa de quatro opções.`;
      }

      for (
        let opcaoIndex = 0;
        opcaoIndex <
        OPCOES_POR_PERGUNTA;
        opcaoIndex += 1
      ) {
        if (
          !pergunta.options[
            opcaoIndex
          ]?.trim()
        ) {
          return `Preencha a opção ${
            OPCOES_LETRAS[
              opcaoIndex
            ]
          } da pergunta ${
            pergunta.numero
          }.`;
        }
      }

      if (
        !Number.isInteger(
          Number(
            pergunta.correct_answer
          )
        ) ||
        Number(
          pergunta.correct_answer
        ) < 0 ||
        Number(
          pergunta.correct_answer
        ) >=
          OPCOES_POR_PERGUNTA
      ) {
        return `Marque a resposta certa da pergunta ${
          pergunta.numero
        }.`;
      }

      if (!pergunta.explanation.trim()) {
        return `Preencha a explicação da pergunta ${
          pergunta.numero
        }.`;
      }
    }

    return "";
  }

  async function guardarTeste() {
    const erroValidacao =
      validarTeste();

    if (erroValidacao) {
      setErro(erroValidacao);
      return;
    }

    if (!cursoActual?.id) {
      setTesteModal(false);
      setCursoModal(true);
      setErro("");
      setSucesso(
        "As 10 perguntas foram preenchidas. Pode agora criar o curso."
      );
      return;
    }

    setSaving(true);
    setErro("");

    try {
      const existentes =
        Array.isArray(
          cursoActual.questions
        )
          ? cursoActual.questions
          : [];

      const guardadas = [];

      for (
        let index = 0;
        index < TOTAL_PERGUNTAS;
        index += 1
      ) {
        const pergunta =
          perguntas[index];

        const payload = {
          question:
            pergunta.question.trim(),

          options:
            pergunta.options.map(
              (opcao) => opcao.trim()
            ),

          correct_answer:
            Number(
              pergunta.correct_answer
            ),

          explanation:
            pergunta.explanation.trim(),
        };

        const idExistente =
          pergunta.id ||
          existentes[index]?.id;

        let resposta;

        if (idExistente) {
          resposta = await fetch(
            `${API_BASE}/admin/courses/${cursoActual.id}/questions/${idExistente}`,
            {
              method: "PUT",
              headers: {
                "Content-Type":
                  "application/json",
              },
              body: JSON.stringify(
                payload
              ),
            }
          );
        } else {
          resposta = await fetch(
            `${API_BASE}/admin/courses/${cursoActual.id}/questions`,
            {
              method: "POST",
              headers: {
                "Content-Type":
                  "application/json",
              },
              body: JSON.stringify(
                payload
              ),
            }
          );
        }

        const dados =
          await resposta
            .json()
            .catch(() => null);

        if (!resposta.ok) {
          throw new Error(
            dados?.detail ||
              `Não foi possível guardar a pergunta ${
                index + 1
              }.`
          );
        }

        guardadas.push(dados);
      }

      setCursoActual(
        (atual) => ({
          ...atual,
          questions:
            guardadas,
          questions_count:
            guardadas.length,
        })
      );

      setPerguntas(
        normalizarPerguntas(
          guardadas
        )
      );

      await carregarCursos();

      setSucesso(
        "As 10 perguntas foram guardadas com sucesso."
      );
    } catch (error) {
      setErro(
        error?.message ||
          "Não foi possível guardar o teste."
      );
    } finally {
      setSaving(false);
    }
  }

  async function alternarPublicacao(curso) {
    setSaving(true);
    setErro("");

    try {
      const resposta = await fetch(
        `${API_BASE}/admin/courses/${curso.id}`,
        {
          method: "PUT",
          headers: {
            "Content-Type":
              "application/json",
          },
          body: JSON.stringify({
            title: curso.title,
            description:
              curso.description,
            published:
              !curso.published,
          }),
        }
      );

      const dados =
        await resposta
          .json()
          .catch(() => null);

      if (!resposta.ok) {
        throw new Error(
          dados?.detail ||
            "Não foi possível alterar a publicação."
        );
      }

      await carregarCursos();

      setSucesso(
        curso.published
          ? "Curso ocultado."
          : "Curso publicado."
      );
    } catch (error) {
      setErro(
        error?.message ||
          "Não foi possível alterar a publicação."
      );
    } finally {
      setSaving(false);
    }
  }

  async function eliminarCurso() {
    if (!cursoEliminar) return;

    setSaving(true);
    setErro("");

    try {
      const resposta = await fetch(
        `${API_BASE}/admin/courses/${cursoEliminar.id}`,
        {
          method: "DELETE",
        }
      );

      const dados =
        await resposta
          .json()
          .catch(() => null);

      if (!resposta.ok) {
        throw new Error(
          dados?.detail ||
            "Não foi possível eliminar o curso."
        );
      }

      setCursoEliminar(null);

      await carregarCursos();

      setSucesso(
        "Curso eliminado com sucesso."
      );
    } catch (error) {
      setErro(
        error?.message ||
          "Não foi possível eliminar o curso."
      );
    } finally {
      setSaving(false);
    }
  }

  async function copiarLink(link) {
    if (!link) return;

    try {
      await navigator.clipboard.writeText(
        link
      );

      setSucesso(
        "Endereço do curso copiado."
      );
    } catch {
      setErro(
        "Não foi possível copiar o endereço."
      );
    }
  }

  const cursosFiltrados =
    useMemo(() => {
      const termo =
        pesquisa
          .trim()
          .toLowerCase();

      return cursos.filter(
        (curso) => {
          const correspondePesquisa =
            !termo ||
            curso.title
              .toLowerCase()
              .includes(termo) ||
            curso.description
              .toLowerCase()
              .includes(termo);

          const correspondeFiltro =
            filtro === "todos" ||
            (filtro === "publicados" &&
              curso.published) ||
            (filtro === "rascunhos" &&
              !curso.published);

          return (
            correspondePesquisa &&
            correspondeFiltro
          );
        }
      );
    }, [
      cursos,
      pesquisa,
      filtro,
    ]);

  const totalAulas =
    cursos.reduce(
      (total, curso) =>
        total +
        (Number(
          curso.lessons_count
        ) ||
          curso.lessons.length ||
          0),
      0
    );

  const totalQuestoes =
    cursos.reduce(
      (total, curso) =>
        total +
        (Number(
          curso.questions_count
        ) ||
          curso.questions.length ||
          0),
      0
    );

  const publicados =
    cursos.filter(
      (curso) =>
        curso.published
    ).length;

  return (
    <section className="w-full min-w-0 space-y-6 overflow-visible">
      <header className="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div className="min-w-0">
          <p className="text-[10px] font-black uppercase tracking-[0.2em] text-blue-600">
            Administração
          </p>

          <h1 className="mt-2 text-3xl font-black tracking-tight text-slate-950 sm:text-4xl">
            Cursos
          </h1>

          <p className="mt-2 max-w-2xl text-sm leading-6 text-slate-500">
            Crie, edite e organize os cursos disponibilizados aos estudantes do SICSI III.
          </p>
        </div>

        <button
          type="button"
          onClick={abrirNovoCurso}
          className="inline-flex shrink-0 items-center justify-center gap-2 rounded-2xl bg-blue-600 px-5 py-3.5 text-sm font-bold text-white shadow-lg shadow-blue-600/20 transition hover:bg-blue-700"
        >
          <Plus className="h-5 w-5" />
          Novo curso
        </button>
      </header>

      {erro && (
        <div className="flex items-start gap-3 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
          <AlertTriangle className="mt-0.5 h-4 w-4 shrink-0" />

          <span className="min-w-0 flex-1 leading-6">
            {erro}
          </span>

          <button
            type="button"
            onClick={() => setErro("")}
            className="text-red-400 hover:text-red-700"
          >
            <X className="h-4 w-4" />
          </button>
        </div>
      )}

      {sucesso && (
        <div className="flex items-center gap-3 rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-700">
          <div className="flex h-7 w-7 items-center justify-center rounded-full bg-emerald-100">
            <Check className="h-4 w-4" />
          </div>

          {sucesso}
        </div>
      )}

      <div className="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <StatCard
          icon={BookOpen}
          titulo="Cursos"
          valor={cursos.length}
          descricao="Total registado"
          classe="bg-blue-50 text-blue-600"
        />

        <StatCard
          icon={Eye}
          titulo="Publicados"
          valor={publicados}
          descricao="Disponíveis aos estudantes"
          classe="bg-emerald-50 text-emerald-600"
        />

        <StatCard
          icon={Layers3}
          titulo="Aulas"
          valor={totalAulas}
          descricao="Conteúdos de aprendizagem"
          classe="bg-violet-50 text-violet-600"
        />

        <StatCard
          icon={ClipboardCheck}
          titulo="Questões"
          valor={totalQuestoes}
          descricao="Questões dos testes"
          classe="bg-amber-50 text-amber-600"
        />
      </div>

      <section className="w-full min-w-0 overflow-visible">
        <div className="flex flex-col gap-4 rounded-3xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6 lg:flex-row lg:items-center lg:justify-between">
          <div className="flex min-w-0 items-center gap-3">
            <div className="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
              <GraduationCap className="h-5 w-5" />
            </div>

            <div className="min-w-0">
              <h2 className="truncate text-lg font-black text-slate-950">
                Cursos disponíveis
              </h2>

              <p className="text-xs text-slate-400">
                Lista completa de cursos e respectivos detalhes.
              </p>
            </div>
          </div>

          <div className="flex w-full min-w-0 flex-col gap-3 sm:flex-row lg:w-auto">
            <div className="relative min-w-0 flex-1 sm:w-72 lg:flex-none">
              <Search className="pointer-events-none absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" />

              <input
                type="search"
                value={pesquisa}
                onChange={(event) =>
                  setPesquisa(
                    event.target.value
                  )
                }
                placeholder="Pesquisar cursos..."
                className="w-full rounded-2xl border border-slate-200 bg-slate-50 py-3 pl-11 pr-4 text-sm font-medium text-slate-900 caret-blue-600 outline-none transition placeholder:text-slate-400 focus:border-blue-300 focus:bg-white focus:ring-4 focus:ring-blue-100"
              />
            </div>

            <DropdownEstado
              value={filtro}
              onChange={setFiltro}
            />
          </div>
        </div>

        <div className="mt-4 flex items-center justify-between px-1">
          <p className="text-[11px] font-semibold text-slate-400">
            {cursosFiltrados.length} curso(s) apresentado(s)
          </p>

          <p className="text-[11px] font-semibold text-slate-400">
            {cursos.length} no total
          </p>
        </div>

        {loading ? (
          <div className="mt-4 flex min-h-[300px] items-center justify-center rounded-3xl border border-slate-200 bg-white">
            <div className="text-center">
              <LoaderCircle className="mx-auto h-8 w-8 animate-spin text-blue-600" />

              <p className="mt-4 text-sm font-semibold text-slate-600">
                A carregar os cursos...
              </p>
            </div>
          </div>
        ) : cursosFiltrados.length === 0 ? (
          <div className="mt-4 rounded-3xl border border-dashed border-slate-300 bg-white px-6 py-16 text-center">
            <div className="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-blue-50 text-blue-600">
              <BookOpen className="h-6 w-6" />
            </div>

            <h3 className="mt-4 text-lg font-black text-slate-950">
              Nenhum curso encontrado
            </h3>

            <p className="mt-2 text-sm text-slate-500">
              Ajuste a pesquisa ou o filtro seleccionado.
            </p>
          </div>
        ) : (
          <div className="mt-2 w-full min-w-0">
            {cursosFiltrados.map(
              (curso, index) => (
                <CourseItem
                  key={
                    curso.id ||
                    `curso-${index}`
                  }
                  curso={curso}
                  numero={cursos.indexOf(
                    curso
                  ) + 1}
                  onEdit={
                    abrirEditarCurso
                  }
                  onTeste={abrirTeste}
                  onTogglePublish={
                    alternarPublicacao
                  }
                  onDelete={
                    setCursoEliminar
                  }
                  onCopy={copiarLink}
                />
              )
            )}
          </div>
        )}
      </section>

      <section className="rounded-3xl border border-blue-100 bg-gradient-to-r from-blue-50 via-white to-indigo-50 p-5 sm:p-6">
        <div className="flex items-start gap-4">
          <div className="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-blue-600 text-white shadow-lg shadow-blue-600/20">
            <ShieldCheck className="h-5 w-5" />
          </div>

          <div>
            <p className="text-[9px] font-black uppercase tracking-[0.18em] text-blue-600">
              Formação SICSI III
            </p>

            <h3 className="mt-1 text-base font-black text-slate-950">
              Cada curso tem o seu próprio endereço e teste final.
            </h3>

            <p className="mt-1 text-sm leading-6 text-slate-500">
              O curso é aberto através do seu endereço e o teste pode ser configurado directamente na administração.
            </p>
          </div>
        </div>
      </section>

      <ModalCurso
        aberto={cursoModal}
        curso={cursoActual}
        formulario={formulario}
        setFormulario={setFormulario}
        saving={saving}
        onClose={fecharCursoModal}
        onSubmit={guardarCurso}
        onAbrirTeste={() => {
          setCursoModal(false);
          abrirTeste(cursoActual);
        }}
      />

      <ModalTeste
        aberto={testeModal}
        curso={cursoActual}
        perguntas={perguntas}
        setPerguntas={setPerguntas}
        saving={saving}
        onClose={fecharTesteModal}
        onSave={guardarTeste}
      />

      {cursoEliminar && (
        <div className="fixed inset-0 z-[140] flex items-center justify-center bg-slate-950/55 px-4 backdrop-blur-sm">
          <div className="w-full max-w-md rounded-[28px] bg-white p-6 shadow-2xl">
            <div className="flex h-11 w-11 items-center justify-center rounded-2xl bg-red-50 text-red-600">
              <Trash2 className="h-5 w-5" />
            </div>

            <h2 className="mt-5 text-xl font-black text-slate-950">
              Eliminar curso?
            </h2>

            <p className="mt-2 text-sm leading-6 text-slate-500">
              O curso{" "}
              <strong className="text-slate-700">
                {cursoEliminar.title}
              </strong>{" "}
              será removido do sistema.
            </p>

            <div className="mt-6 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
              <button
                type="button"
                onClick={() =>
                  setCursoEliminar(null)
                }
                disabled={saving}
                className="rounded-xl border border-slate-200 px-4 py-2.5 text-xs font-bold text-slate-600 hover:bg-slate-50"
              >
                Cancelar
              </button>

              <button
                type="button"
                onClick={eliminarCurso}
                disabled={saving}
                className="inline-flex items-center justify-center gap-2 rounded-xl bg-red-600 px-4 py-2.5 text-xs font-bold text-white hover:bg-red-700 disabled:opacity-60"
              >
                {saving ? (
                  <LoaderCircle className="h-4 w-4 animate-spin" />
                ) : (
                  <Trash2 className="h-4 w-4" />
                )}

                Eliminar
              </button>
            </div>
          </div>
        </div>
      )}
    </section>
  );
}
