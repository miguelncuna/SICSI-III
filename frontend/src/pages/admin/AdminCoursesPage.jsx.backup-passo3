const API_BASE = "http://127.0.0.1:8000/api";

const TOTAL_PERGUNTAS = 10;
const OPCOES_POR_PERGUNTA = 4;

const OPCOES_LETRAS = ["A", "B", "C", "D"];

const CURSO_VAZIO = {
  title: "",
  description: "",
  level: "Básico",
  published: true,
  image_url: "",
  link: "",
};

function novaPergunta(numero) {
  return {
    id: null,
    numero,
    question: "",
    options: ["", "", "", ""],
    correct_answer: 0,
    explanation: "",
  };
}

function perguntasVazias() {
  return Array.from(
    { length: TOTAL_PERGUNTAS },
    (_, index) => novaPergunta(index + 1)
  );
}

function obterLinkCurso(id) {
  if (!id) return "";
  return `${window.location.origin}/admin/cursos/${id}/visualizar`;
}

function normalizarCursos(data) {
  if (!Array.isArray(data)) return [];

  return data.map((curso) => ({
    ...curso,
    id: String(curso?.id || ""),
    title: String(curso?.title || ""),
    description: String(curso?.description || ""),
    level: curso?.level || "Básico",
    published: Boolean(curso?.published),
    image_url: String(curso?.image_url || ""),
    link: String(curso?.link || ""),
    lessons: Array.isArray(curso?.lessons)
      ? curso.lessons
      : [],
    questions: Array.isArray(curso?.questions)
      ? curso.questions
      : [],
    lessons_count:
      Number(curso?.lessons_count) ||
      (Array.isArray(curso?.lessons)
        ? curso.lessons.length
        : 0),
    questions_count:
      Number(curso?.questions_count) ||
      (Array.isArray(curso?.questions)
        ? curso.questions.length
        : 0),
  }));
}

function normalizarPerguntas(perguntas) {
  const origem = Array.isArray(perguntas)
    ? perguntas
    : [];

  return Array.from(
    { length: TOTAL_PERGUNTAS },
    (_, index) => {
      const pergunta = origem[index];

      if (!pergunta) {
        return novaPergunta(index + 1);
      }

      const opcoes = Array.isArray(
        pergunta.options
      )
        ? pergunta.options.slice(
            0,
            OPCOES_POR_PERGUNTA
          )
        : [];

      while (
        opcoes.length <
        OPCOES_POR_PERGUNTA
      ) {
        opcoes.push("");
      }

      let resposta = Number(
        pergunta.correct_answer
      );

      if (
        !Number.isInteger(resposta) ||
        resposta < 0 ||
        resposta >= OPCOES_POR_PERGUNTA
      ) {
        resposta = 0;
      }

      return {
        id: pergunta.id || null,
        numero: index + 1,
        question:
          pergunta.question || "",
        options: opcoes.map((opcao) =>
          typeof opcao === "string"
            ? opcao
            : opcao?.text || ""
        ),
        correct_answer: resposta,
        explanation:
          pergunta.explanation || "",
      };
    }
  );
}

