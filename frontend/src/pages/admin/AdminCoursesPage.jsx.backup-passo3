function DropdownEstado({
  value,
  onChange,
}) {
  const [aberto, setAberto] = useState(false);

  const opcoes = [
    {
      value: "todos",
      label: "Todos os cursos",
    },
    {
      value: "publicados",
      label: "Publicados",
    },
    {
      value: "rascunhos",
      label: "Rascunhos",
    },
  ];

  const selecionado =
    opcoes.find(
      (item) => item.value === value
    ) || opcoes[0];

  useEffect(() => {
    function fechar(event) {
      if (
        !event.target.closest(
          "[data-dropdown-estado]"
        )
      ) {
        setAberto(false);
      }
    }

    document.addEventListener(
      "mousedown",
      fechar
    );

    return () => {
      document.removeEventListener(
        "mousedown",
        fechar
      );
    };
  }, []);

  return (
    <div
      data-dropdown-estado
      className="relative w-full sm:w-52"
    >
      <button
        type="button"
        onClick={() =>
          setAberto((atual) => !atual)
        }
        className={`flex h-11 w-full items-center justify-between rounded-2xl border bg-white px-4 text-sm font-semibold transition ${
          aberto
            ? "border-blue-300 bg-blue-50/40 text-slate-900 ring-4 ring-blue-100"
            : "border-slate-200 text-slate-700 hover:border-blue-200 hover:bg-slate-50"
        }`}
      >
        <span>{selecionado.label}</span>

        <ChevronDown
          className={`h-4 w-4 text-slate-400 transition-transform ${
            aberto
              ? "rotate-180 text-blue-600"
              : ""
          }`}
        />
      </button>

      {aberto && (
        <div className="absolute left-0 right-0 top-[calc(100%+8px)] z-[90] overflow-hidden rounded-2xl border border-slate-200 bg-white p-1.5 shadow-2xl shadow-slate-900/10">
          {opcoes.map((opcao) => {
            const ativo =
              opcao.value === value;

            return (
              <button
                key={opcao.value}
                type="button"
                onClick={() => {
                  onChange(opcao.value);
                  setAberto(false);
                }}
                className={`flex w-full items-center justify-between rounded-xl px-3.5 py-3 text-left text-sm font-semibold transition ${
                  ativo
                    ? "bg-blue-600 text-white"
                    : "text-slate-600 hover:bg-blue-50 hover:text-blue-700"
                }`}
              >
                <span>{opcao.label}</span>

                {ativo && (
                  <Check className="h-4 w-4" />
                )}
              </button>
            );
          })}
        </div>
      )}
    </div>
  );
}

