function QrVisual() {
  const cells = useMemo(() => {
    const result = [];

    for (let row = 0; row < 21; row += 1) {
      for (let col = 0; col < 21; col += 1) {
        let filled =
          ((row * 17 + col * 31 + row * col * 7) % 11) < 5;

        const finder = (r, c) => {
          const inside =
            row >= r &&
            row < r + 7 &&
            col >= c &&
            col < c + 7;

          if (!inside) return null;

          const edge =
            row === r ||
            row === r + 6 ||
            col === c ||
            col === c + 6;

          const centre =
            row >= r + 2 &&
            row <= r + 4 &&
            col >= c + 2 &&
            col <= c + 4;

          return edge || centre;
        };

        const a = finder(0, 0);
        const b = finder(0, 14);
        const c = finder(14, 0);

        if (a !== null) filled = a;
        if (b !== null) filled = b;
        if (c !== null) filled = c;

        result.push({
          key: `${row}-${col}`,
          filled,
        });
      }
    }

    return result;
  }, []);

  return (
    <div className="grid grid-cols-[repeat(21,minmax(0,1fr))] gap-[2px] rounded-2xl bg-white p-3 shadow-inner">
      {cells.map((cell) => (
        <span
          key={cell.key}
          className={`aspect-square rounded-[1px] ${
            cell.filled ? "bg-slate-950" : "bg-white"
          }`}
        />
      ))}
    </div>
  );
}

export default function AdvancedQuishingPage() {
  const navigate = useNavigate();
  const { user } = useAuth();

  const [simulation, setSimulation] = useState(null);
  const [loading, setLoading] = useState(true);
  const [step, setStep] = useState("email");
  const [message, setMessage] = useState("");
  const [email, setEmail] = useState("");
  const [submitting, setSubmitting] = useState(false);

  useEffect(() => {
    let active = true;

    simulationService
      .get("phishing-02")
      .then((data) => {
        if (active) {
          setSimulation(data);
        }
      })
      .catch((error) => {
        if (active) {
          setMessage(
            error?.message ||
              "Não foi possível carregar a experiência."
          );
        }
      })
      .finally(() => {
        if (active) {
          setLoading(false);
        }
      });

    return () => {
      active = false;
    };
  }, []);

  async function act(
    action,
    stepId,
    interactionType,
    details = {}
  ) {
    try {
      setSubmitting(true);
      setMessage("");

      const result = await simulationService.evaluate(
        "phishing-02",
        action,
        user?.id,
        stepId,
        interactionType,
        details
      );

      if (result?.completed) {
        navigate(
          "/student/simulacoes/phishing-02/resultado"
        );
        return;
      }

      if (action === "open_link") {
        if (step === "email") {
          setStep("mobile");
        } else if (step === "mobile") {
          setStep("login");
        }
      }

      if (action === "inspect" || action === "inspect_url") {
        setMessage(
          "A informação foi analisada e o percurso permanece disponível."
        );
      }

      if (action === "leave_page") {
        setStep("safe_exit");
        setMessage(
          "O ambiente permanece disponível para que possa concluir a experiência."
        );
      }
    } catch (error) {
      setMessage(
        error?.message ||
          "Não foi possível registar esta decisão."
      );
    } finally {
      setSubmitting(false);
    }
  }

  async function submitCredentials(event) {
    event.preventDefault();

    try {
      setSubmitting(true);
      setMessage("");

      const result = await simulationService.evaluate(
        "phishing-02",
        "credentials",
        user?.id,
        "step_03",
        "credentials",
        {
          email_value: email,
        }
      );

      if (result?.completed) {
        navigate(
          "/student/simulacoes/phishing-02/resultado"
        );
        return;
      }

      setStep("consequence");
    } catch (error) {
      setMessage(
        error?.message ||
          "Não foi possível concluir a acção."
      );
    } finally {
      setSubmitting(false);
    }
  }

  function finish() {
    act(
      "finish",
      "step_04",
      "finish"
    );
  }

  if (loading) {
    return (
      <div className="flex min-h-[70vh] items-center justify-center">
        <div className="text-center">
          <div className="mx-auto h-10 w-10 animate-spin rounded-full border-4 border-blue-600 border-t-transparent" />
          <p className="mt-4 text-sm text-slate-500">
            A preparar a experiência...
          </p>
        </div>
      </div>
    );
  }

  if (!simulation) {
    return (
      <div className="mx-auto max-w-2xl p-8 text-center">
        <ShieldAlert className="mx-auto h-10 w-10 text-red-500" />
        <h1 className="mt-5 text-2xl font-black text-slate-950">
          Experiência indisponível
        </h1>
        <p className="mt-2 text-sm text-slate-500">
          {message ||
            "Não foi possível carregar o Phishing 02."}
        </p>
      </div>
    );
  }

  const mobile = simulation.mobile || {};
  const login = simulation.login || {};

  return (
    <div className="min-h-screen bg-slate-50 px-4 py-6 sm:px-6 lg:px-8">
