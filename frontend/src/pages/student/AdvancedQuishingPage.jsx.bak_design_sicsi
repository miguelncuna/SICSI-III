                      onClick={() =>
                        act(
                          "open_link",
                          "step_01",
                          "link"
                        )
                      }
                      className="inline-flex items-center justify-center gap-2 rounded-xl bg-blue-600 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-blue-600/20 transition hover:bg-blue-700 disabled:opacity-50"
                    >
                      <ScanLine className="h-4 w-4" />
                      {simulation.link_text}
                    </button>
                  </div>
                </div>
              </div>
            )}

            {step === "mobile" && (
              <div className="bg-slate-100 p-6 sm:p-8">
                <div className="mx-auto max-w-md overflow-hidden rounded-[2rem] border-8 border-slate-900 bg-white shadow-2xl">
                  <div className="flex items-center justify-between bg-slate-950 px-5 py-3 text-xs text-white">
                    <span>09:41</span>
                    <span>Portal</span>
                    <span>5G</span>
                  </div>

                  <div className="p-6">

                    <div className="rounded-2xl bg-blue-600 p-5 text-white">
                      <p className="text-xs font-black uppercase tracking-[0.16em] text-blue-100">
                        {mobile.banner}
