                  </div>
                </div>
              </div>
            )}

            {step === "login" && (
              <div className="bg-slate-100 p-6 sm:p-8">
                <div className="mx-auto max-w-md overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-2xl">

                  <div className="bg-slate-950 px-6 py-5 text-white">
                    <div className="flex items-center gap-3">
                      <ShieldCheck className="h-6 w-6 text-blue-400" />
                      <div>
                        <p className="font-black">
                          {login.title}
                        </p>
                        <p className="text-xs text-slate-400">
                          Acesso institucional simulado
                        </p>
                      </div>
                    </div>
                  </div>

                  <form
                    onSubmit={submitCredentials}
                    className="p-6"
                  >
                    <p className="text-sm leading-6 text-slate-600">
                      {login.helper}
                    </p>

                    <div className="mt-6">
                      <label
                        htmlFor="quishing-email"
                        className="text-xs font-black uppercase tracking-[0.14em] text-slate-500"
                      >
                        Endereço de correio electrónico
                      </label>

                      <input
                        id="quishing-email"
                        name="email"
                        type="email"
                        value={email}
                        onChange={(event) =>
                          setEmail(event.target.value)
                        }
                        autoComplete="off"
                        className="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-100"
                      />
                    </div>

                    <div className="mt-5">
                      <label
                        htmlFor="quishing-password"
                        className="text-xs font-black uppercase tracking-[0.14em] text-slate-500"
                      >
                        Palavra-passe
                      </label>

                      <input
                        id="quishing-password"
                        name="password"
                        type="password"
                        autoComplete="off"
                        className="mt-2 w-full rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-100"
                      />
                    </div>

                    <button
                      type="submit"
                      disabled={submitting}
                      className="mt-6 w-full rounded-xl bg-blue-600 px-4 py-3 font-bold text-white transition hover:bg-blue-700 disabled:opacity-50"
                    >
                      {login.submit_label}
                    </button>
                  </form>

                  <div className="border-t border-slate-200 bg-slate-50 px-6 py-4">
                    <p className="text-xs leading-5 text-slate-500">
                      O ambiente apresentado faz parte de uma experiência educativa controlada.
                    </p>
                  </div>
                </div>

                <div className="mx-auto mt-4 max-w-md">
                  <div className="flex flex-col gap-3 sm:flex-row">
                    <button
                      type="button"
                      disabled={submitting}
                      onClick={() =>
                        act(
                          "inspect_url",
                          "step_03",
                          "inspect_url"
                        )
                      }
                      className="flex-1 rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-700"
                    >
                      Verificar endereço
                    </button>

                    <button
                      type="button"
                      disabled={submitting}
                      onClick={() =>
                        act(
                          "leave_page",
                          "step_03",
                          "leave_page"
                        )
                      }
                      className="flex-1 rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-700"
                    >
                      Sair
                    </button>
                  </div>
                </div>
              </div>
            )}

            {step === "safe_exit" && (
              <div className="p-8 sm:p-10">
                <div className="rounded-3xl border border-emerald-200 bg-emerald-50 p-7">
                  <ShieldCheck className="h-9 w-9 text-emerald-600" />

