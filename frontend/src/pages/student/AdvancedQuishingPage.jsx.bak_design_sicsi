                      </h2>

                      <p className="mt-2 text-sm leading-6 text-blue-100">
                        {mobile.message}
                      </p>
                    </div>

                    <div className="mt-6 rounded-2xl border border-slate-200 bg-slate-50 p-4">
                      <p className="text-[10px] font-black uppercase tracking-[0.16em] text-slate-400">
                        Endereço actual
                      </p>

                      <p className="mt-2 break-all text-xs font-bold text-slate-700">
                        {mobile.browser_url}
                      </p>
                    </div>

                    <div className="mt-6 flex flex-col gap-3">
                      <button
                        type="button"
                        disabled={submitting}
                        onClick={() =>
                          act(
                            "inspect_url",
                            "step_02",
                            "inspect_url"
                          )
                        }
                        className="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-700"
                      >
                        <ExternalLink className="h-4 w-4" />
                        Verificar o endereço
                      </button>

                      <button
                        type="button"
                        disabled={submitting}
                        onClick={() =>
                          act(
                            "open_link",
                            "step_02",
                            "link"
                          )
                        }
                        className="inline-flex items-center justify-center gap-2 rounded-xl bg-blue-600 px-4 py-3 text-sm font-bold text-white"
                      >
                        Continuar
                        <ArrowRight className="h-4 w-4" />
                      </button>

                      <button
                        type="button"
                        disabled={submitting}
                        onClick={() =>
                          act(
                            "leave_page",
                            "step_02",
                            "leave_page"
                          )
                        }
                        className="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 px-4 py-3 text-sm font-bold text-slate-600"
                      >
                        <LogOut className="h-4 w-4" />
                        Sair da página
                      </button>

                      <button
                        type="button"
                        disabled={submitting}
                        onClick={() =>
                          act(
                            "report",
                            "step_02",
                            "report"
                          )
                        }
                        className="rounded-xl border border-blue-200 bg-blue-50 px-4 py-3 text-sm font-bold text-blue-700"
                      >
