function getAccountEmail(user) {
  return user?.email || user?.username || user?.login || ACCOUNT_FALLBACK;
}

function formatTime(value = Date.now()) {
  try {
    return new Intl.DateTimeFormat("pt-PT", {
      hour: "2-digit",
      minute: "2-digit",
    }).format(new Date(value));
  } catch {
    return "--:--";
  }
}

function formatDate(value = Date.now()) {
  try {
    return new Intl.DateTimeFormat("pt-PT", {
      day: "2-digit",
      month: "2-digit",
      year: "numeric",
      hour: "2-digit",
      minute: "2-digit",
    }).format(new Date(value));
  } catch {
    return "--/--/---- --:--";
  }
}

function pdfText(value = "") {
  return String(value)
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^\x20-\x7E]/g, "");
}

function safeParseEvents() {
  try {
    const raw = localStorage.getItem("sicsi_simulation_events") || "[]";
    const parsed = JSON.parse(raw);
    return Array.isArray(parsed) ? parsed : [];
  } catch {
    return [];
  }
}

function getCurrentSessionEvents() {
  try {
    const session = getCurrentSimulation();

    if (!session?.session_id) {
      return [];
    }

    return safeParseEvents().filter(
      (event) => event.session_id === session.session_id
    );
  } catch {
    return [];
  }
}

