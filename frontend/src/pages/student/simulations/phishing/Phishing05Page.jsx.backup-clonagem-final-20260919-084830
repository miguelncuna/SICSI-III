function buildSimulationSummary(events) {
  const bySimulation = [1, 2, 3, 4, 5].map((number) => {
    const simulationId = `phishing-0${number}`;

    const simulationEvents = events.filter(
      (event) => event.simulation_id === simulationId
    );

    const safe = simulationEvents.filter((event) =>
      String(event.action || "").startsWith("decision_safe")
    ).length;

    const risk = simulationEvents.filter((event) =>
      String(event.action || "").startsWith("decision_risk")
    ).length;

    const critical = simulationEvents.filter((event) =>
      [
        "submit_academic_credentials",
        "submit_mfa_challenge",
        "confirm_payment",
        "share_external",
        "share_document",
        "download",
        "password_entered",
        "mfa_code_entered",
        "decision_risk",
      ].some((pattern) =>
        String(event.action || "").includes(pattern)
      )
    ).length;

    let result = "Sem decisão crítica registada";

    if (risk > 0) {
      result = "Foram registadas decisões de risco.";
    } else if (safe > 0) {
      result = "Foram registadas decisões seguras.";
    } else if (critical > 0) {
      result = "Foram registadas interacções críticas.";
    }

    const descriptions = {
      1: "Análise de comunicação e identificação de sinais suspeitos.",
      2: "Verificação de identidade e resposta a tentativa de obtenção de acesso.",
      3: "Avaliação de solicitação sensível e controlo da decisão.",
      4: "Análise de documento e acções associadas ao conteúdo.",
      5: "Detecção de identidade clonada, validação independente e resposta ao incidente.",
    };

    return {
      number,
      result,
      description: descriptions[number],
      safe,
      risk,
    };
  });

  return bySimulation;
}

function downloadGeneralReport() {
  const events = safeParseEvents();
  const summary = buildSimulationSummary(events);

  const doc = new jsPDF({
    orientation: "portrait",
    unit: "mm",
    format: "a4",
  });

  const margin = 16;
  const pageWidth = 210;
  const usableWidth = pageWidth - margin * 2;

  let y = 20;

  function ensureSpace(height = 15) {
    if (y + height > 278) {
      doc.addPage();
      y = 20;
    }
  }

  function heading(text, size = 16) {
    ensureSpace(15);
    doc.setFont("helvetica", "bold");
    doc.setFontSize(size);
    doc.setTextColor(15, 23, 42);
    doc.text(pdfText(text), margin, y);
    y += 9;
  }

  function paragraph(text, size = 9.2) {
    const lines = doc.splitTextToSize(
      pdfText(text),
      usableWidth
    );

    ensureSpace(lines.length * 4.5 + 4);

    doc.setFont("helvetica", "normal");
    doc.setFontSize(size);
    doc.setTextColor(71, 85, 105);
    doc.text(lines, margin, y);
    y += lines.length * 4.5 + 5;
  }

  function smallLabel(text) {
    ensureSpace(8);
    doc.setFont("helvetica", "bold");
    doc.setFontSize(7.5);
    doc.setTextColor(100, 116, 139);
    doc.text(pdfText(text).toUpperCase(), margin, y);
    y += 5;
  }

  doc.setFillColor(15, 23, 42);
  doc.roundedRect(margin, y, usableWidth, 31, 5, 5, "F");

  doc.setTextColor(255, 255, 255);
  doc.setFont("helvetica", "bold");
  doc.setFontSize(10);
  doc.text("SICSI · RELATORIO DE CONSCIENTIZACAO", margin + 8, y + 10);

  doc.setFontSize(17);
  doc.text("Percurso das Simulacoes", margin + 8, y + 19);

  doc.setFont("helvetica", "normal");
  doc.setFontSize(8);
  doc.text(
    pdfText(`Gerado em ${formatDate()}`),
    margin + 8,
    y + 26
  );

  y += 40;

  heading("Resumo do percurso", 15);

  paragraph(
    "Este documento sintetiza as decisoes relevantes e os principais feedbacks encontrados ao longo das cinco experiencias de phishing do SICSI. O objetivo nao e reproduzir todos os cliques, mas apresentar os comportamentos e pontos de aprendizagem observados."
  );

  summary.forEach((item) => {
    ensureSpace(33);

    doc.setDrawColor(226, 232, 240);
    doc.roundedRect(margin, y, usableWidth, 27, 4, 4);

    doc.setFont("helvetica", "bold");
    doc.setFontSize(10);
    doc.setTextColor(15, 23, 42);
    doc.text(
      pdfText(`Simulacao 0${item.number}`),
      margin + 6,
      y + 7
    );

    doc.setFont("helvetica", "normal");
    doc.setFontSize(8.2);
    doc.setTextColor(71, 85, 105);

    const lines = doc.splitTextToSize(
      pdfText(item.description),
      usableWidth - 12
    );

    doc.text(lines, margin + 6, y + 13);

    doc.setFont("helvetica", "bold");
    doc.setFontSize(8);
    doc.setTextColor(
      item.risk > 0 ? 185 : 22,
      item.risk > 0 ? 28 : 101,
      item.risk > 0 ? 28 : 52
    );

    doc.text(
      pdfText(item.result),
      margin + 6,
      y + 22
    );

    y += 32;
  });

  heading("Sintese final", 15);

  const totalSafe = summary.reduce(
    (total, item) => total + item.safe,
    0
  );

  const totalRisk = summary.reduce(
    (total, item) => total + item.risk,
    0
  );

  paragraph(
    `Ao longo do percurso foram identificadas ${totalSafe} decisao(oes) segura(s) e ${totalRisk} decisao(oes) de risco. A leitura do resultado deve privilegiar os momentos de verificacao, a validacao independente da identidade e a resposta rapida perante sinais de fraude.`
  );

  smallLabel("Principais pontos de aprendizagem");

  paragraph(
    "Verificar a origem da comunicacao antes de confiar na identidade apresentada; desconfiar de contas novas ou identificadores semelhantes; confirmar solicitacoes sensiveis atraves de um canal independente; verificar cuidadosamente dominios externos; interromper e denunciar a tentativa quando houver sinais consistentes de fraude."
  );

  smallLabel("Observacao de privacidade");

  paragraph(
    "O relatorio nao apresenta palavras-passe, codigos MFA, tokens ou outros segredos. A sintese utiliza apenas informacao comportamental relevante para a experiencia de aprendizagem."
  );

  ensureSpace(20);

  doc.setFont("helvetica", "bold");
  doc.setFontSize(8);
  doc.setTextColor(148, 163, 184);
  doc.text(
    pdfText("SICSI · Sistema de Conscientizacao em Seguranca da Informacao"),
    margin,
    286
  );

  doc.save(
    `SICSI_Relatorio_Percurso_${new Date()
      .toISOString()
      .slice(0, 10)}.pdf`
  );
}

export default function Phishing05Page() {
  const navigate = useNavigate();
  const { user } = useAuth();

  const accountEmail = getAccountEmail(user);

  const [state, setState] = useState(STATES.MESSAGE);
  const [feedback, setFeedback] = useState(null);
  const [responseResult, setResponseResult] = useState(null);
  const [events, setEvents] = useState([]);
  const [startedAt, setStartedAt] = useState(Date.now());
  const [elapsed, setElapsed] = useState(0);
  const [sessionReady, setSessionReady] = useState(false);

  useEffect(() => {
    const current = getCurrentSimulation();

    if (
      current &&
      current.simulation_id === SIMULATION.id &&
      !current.completed
    ) {
      setStartedAt(
        current.started_at
          ? new Date(current.started_at).getTime()
          : Date.now()
      );
    } else {
      const session = startSimulation({
        area: SIMULATION.area,
        simulationId: SIMULATION.id,
        simulationNumber: SIMULATION.number,
        initialState: STATES.MESSAGE,
      });

      setStartedAt(
        session?.started_at
          ? new Date(session.started_at).getTime()
          : Date.now()
      );

      registerAction({
        action: "simulation_started",
        nextState: STATES.MESSAGE,
        interactionType: "system",
        metadata: {
          simulation_id: SIMULATION.id,
          simulation_number: SIMULATION.number,
          title: SIMULATION.title,
        },
      });
    }

    setSessionReady(true);
  }, []);

  useEffect(() => {
    if (!sessionReady) {
      return undefined;
    }

    const timer = window.setInterval(() => {
      setElapsed(Date.now() - startedAt);
    }, 1000);

    return () => window.clearInterval(timer);
  }, [sessionReady, startedAt]);

  useEffect(() => {
    try {
      const currentEvents = getCurrentSessionEvents();
      setEvents(currentEvents);
    } catch {
      setEvents([]);
    }
  }, [state, feedback, responseResult]);

  function track(
    action,
    nextState,
    interactionType = "interaction",
    metadata = {}
  ) {
    const result = registerAction({
      action,
      nextState,
      interactionType,
      metadata,
    });

    if (result?.event) {
      setEvents((current) => [...current, result.event]);
    }

    return result;
  }

  function go(nextState, action, metadata = {}) {
    track(action, nextState, "navigation", metadata);
    setState(nextState);
  }

  function openProfile() {
    go(STATES.PROFILE, "open_cloned_profile");
  }

  function openDetails() {
    go(STATES.DETAILS, "inspect_message_details");
  }

  function openEvidence() {
    track(
      "inspect_identity_evidence",
      STATES.EVIDENCE,
      "interaction",
      {
        evidence_count: 4,
      }
    );

    setState(STATES.EVIDENCE);
  }

  function openRequest() {
    go(STATES.REQUEST, "open_sensitive_request");
  }

  function openIdentityCheck() {
    track(
      "verify_identity_independent_channel",
      STATES.IDENTITY_CHECK,
      "verification",
      {
        channel: "known_contact",
      }
    );

    setState(STATES.IDENTITY_CHECK);
  }

  function completeIdentityCheck() {
    track(
      "identity_confirmed_false",
      STATES.REQUEST,
      "verification",
      {
        independent_verification: true,
      }
    );

    setState(STATES.REQUEST);
  }

  function inspectPhishingAddress() {
    track(
      "inspect_external_domain",
      STATES.PHISHING_PAGE,
      "interaction",
      {
        domain: "secure-sicsi-verification.com",
        trusted: false,
      }
    );

    setState(STATES.PHISHING_PAGE);
  }

  function openPhishingPage() {
    track(
      "open_cloned_verification_page",
      STATES.PHISHING_PAGE,
      "navigation",
      {
        external_domain: true,
      }
    );

    setState(STATES.PHISHING_PAGE);
  }

  function continueOnPhishingPage() {
    const result = track(
      "decision_risk_continue_external_verification",
      STATES.FEEDBACK,
      "decision",
      {
        decision: "continue",
        domain_verified: false,
        identity_verified: false,
      }
    );

    setFeedback({
      safe: false,
      title: "A tentativa de fraude avançou",
      description:
        "A decisão permitiu continuar numa página externa que tentava validar uma identidade sem confirmação institucional.",
      action:
        "A informação seria entregue fora do canal confiável e o atacante poderia continuar a exploração da identidade clonada.",
      risk: "Personificação digital + recolha indevida de informação",
      lesson:
        "Um domínio convincente não substitui a validação independente da origem.",
    });

    setState(STATES.FEEDBACK);

    return result;
  }

  function exitPhishingPage() {
    track(
      "decision_safe_exit_external_page",
      STATES.FEEDBACK,
      "decision",
      {
        decision: "exit",
        domain_verified: false,
      }
    );

    setFeedback({
      safe: true,
      title: "A tentativa foi interrompida",
      description:
        "A decisão encerrou a interacção antes da partilha de informação com a página não verificada.",
      action:
        "O domínio foi tratado como suspeito e a recolha de dados não avançou.",
      risk: "Exposição de identidade digital evitada",
      lesson:
        "Interromper a interacção quando o contexto não pode ser validado reduz a superfície do ataque.",
    });

    setState(STATES.FEEDBACK);
  }

  function reportFromMessage() {
    track(
      "decision_safe_report_cloned_identity",
      STATES.FEEDBACK,
      "report",
      {
        decision: "report",
        source: "message",
      }
    );

    setFeedback({
      safe: true,
      title: "A identidade suspeita foi denunciada",
      description:
        "A tentativa foi interrompida no primeiro contacto, antes de qualquer envio de informação.",
      action:
        "A comunicação deixou de ser tratada como uma solicitação legítima e foi encaminhada para denúncia.",
      risk: "Engenharia de confiança interrompida",
      lesson:
        "Quando existem sinais consistentes de personificação, denunciar cedo evita que a fraude evolua.",
    });

    setState(STATES.FEEDBACK);
  }

  function continueFromFeedback() {
    track(
      feedback?.safe
        ? "feedback_safe_acknowledged"
        : "feedback_risk_acknowledged",
      STATES.RESPONSE,
      "navigation",
      {
        feedback_type: feedback?.safe ? "safe" : "risk",
      }
    );

    setFeedback(null);
    setState(STATES.RESPONSE);
  }

  function reportAffectedContacts() {
    track(
      "decision_safe_warn_affected_contacts",
      STATES.RESPONSE_PROCESSING,
      "response",
      {
        response: "warn_contacts",
      }
    );

    setResponseResult({
      actionTitle: "Contactos avisados",
      actionDescription:
        "A resposta comunicou o risco para reduzir a probabilidade de outras pessoas confiarem na identidade clonada.",
    });

    setState(STATES.RESPONSE_PROCESSING);

    window.setTimeout(() => {
      setState(STATES.RESPONSE_RESULT);
    }, 700);
  }

  function blockAndReport() {
    track(
      "decision_safe_block_and_report_identity",
      STATES.RESPONSE_PROCESSING,
      "response",
      {
        response: "block_and_report",
      }
    );

    setResponseResult({
      actionTitle: "Identidade bloqueada e denunciada",
      actionDescription:
        "A tentativa foi interrompida e o contacto suspeito foi encaminhado para denúncia.",
    });

    setState(STATES.RESPONSE_PROCESSING);

    window.setTimeout(() => {
      setState(STATES.RESPONSE_RESULT);
    }, 700);
  }

  function secureIdentity() {
    track(
      "decision_safe_secure_digital_identity",
      STATES.RESPONSE_PROCESSING,
      "response",
      {
        response: "secure_identity",
      }
    );

    setResponseResult({
      actionTitle: "Identidade digital protegida",
      actionDescription:
        "A resposta priorizou a protecção da identidade e a revisão de mecanismos de acesso.",
    });

    setState(STATES.RESPONSE_PROCESSING);

    window.setTimeout(() => {
      setState(STATES.RESPONSE_RESULT);
    }, 700);
  }

  function continueFromResponse() {
    track(
      "decision_safe_incident_response_completed",
      STATES.FINAL,
      "navigation",
      {
        response_completed: true,
      }
    );

    completeSimulation();
    setState(STATES.FINAL);
  }

  function downloadReport() {
    track(
      "download_general_report",
      STATES.FINAL,
      "download",
      {
        format: "pdf",
        scope: "phishing_01_to_05",
      }
    );

    downloadGeneralReport();
  }

  function finishSimulation() {
    track(
      "finish_phishing_journey",
      STATES.FINAL,
      "navigation",
      {
        destination: "/student/simulacoes",
      }
    );

    completeSimulation();
    completeSimulationSession();

    navigate("/student/simulacoes");
  }

  function returnToMessage() {
    track(
      "return_to_message",
      STATES.MESSAGE,
      "navigation"
    );

    setFeedback(null);
    setState(STATES.MESSAGE);
  }

  function returnToRequest() {
    track(
      "return_to_request",
      STATES.REQUEST,
      "navigation"
    );

    setState(STATES.REQUEST);
  }

  function getDecisionCounts() {
    const currentEvents = [
      ...events,
      ...getCurrentSessionEvents(),
    ];

    const uniqueBySequence = Array.from(
      new Map(
        currentEvents.map((event, index) => [
          `${event.sequence || ""}-${event.timestamp || ""}-${index}`,
          event,
        ])
      ).values()
    );

    const safeCount = uniqueBySequence.filter((event) =>
      String(event.action || "").startsWith("decision_safe")
    ).length;

    const riskCount = uniqueBySequence.filter((event) =>
      String(event.action || "").startsWith("decision_risk")
    ).length;

    return {
      safeCount,
      riskCount,
    };
  }

  function render() {
    if (state === STATES.MESSAGE) {
      return (
        <MessageView
          account={accountEmail}
          onProfile={openProfile}
          onDetails={openDetails}
          onRequest={openRequest}
          onReport={reportFromMessage}
        />
      );
    }

    if (state === STATES.PROFILE) {
      return (
        <ProfileView
          onBack={returnToMessage}
          onEvidence={openEvidence}
          onRequest={openRequest}
        />
      );
    }

    if (state === STATES.DETAILS) {
      return (
        <DetailsView
          onBack={returnToMessage}
          onProfile={openProfile}
          onRequest={openRequest}
        />
      );
    }

    if (state === STATES.EVIDENCE) {
      return (
        <EvidenceView
          onBack={returnToMessage}
          onIdentityCheck={openIdentityCheck}
          onRequest={openRequest}
        />
      );
    }

    if (state === STATES.REQUEST) {
      return (
        <RequestView
          onBack={returnToMessage}
          onIdentityCheck={openIdentityCheck}
          onOpenLink={openPhishingPage}
          onReport={reportFromMessage}
        />
      );
    }

    if (state === STATES.IDENTITY_CHECK) {
      return (
        <IdentityCheckView
          onBack={returnToRequest}
          onConfirm={completeIdentityCheck}
        />
      );
    }

    if (state === STATES.PHISHING_PAGE) {
      return (
        <PhishingPageView
          onBack={returnToRequest}
          onInspect={() => {
            track(
              "inspect_external_domain_again",
              STATES.PHISHING_PAGE,
              "interaction",
              {
                domain: "secure-sicsi-verification.com",
              }
            );
          }}
          onContinue={continueOnPhishingPage}
          onExit={exitPhishingPage}
        />
      );
    }

    if (state === STATES.FEEDBACK && feedback) {
      return (
        <FeedbackView
          safe={feedback.safe}
          title={feedback.title}
          description={feedback.description}
          action={feedback.action}
          risk={feedback.risk}
          lesson={feedback.lesson}
          onContinue={continueFromFeedback}
        />
      );
    }

    if (state === STATES.RESPONSE) {
      return (
        <ResponseView
          onBack={returnToMessage}
          onReport={reportAffectedContacts}
          onBlock={blockAndReport}
          onSecure={secureIdentity}
        />
      );
    }

    if (state === STATES.RESPONSE_PROCESSING) {
      return <ProcessingView />;
    }

    if (state === STATES.RESPONSE_RESULT && responseResult) {
      return (
        <ResponseResultView
          actionTitle={responseResult.actionTitle}
          actionDescription={responseResult.actionDescription}
          onContinue={continueFromResponse}
        />
      );
    }

    if (state === STATES.FINAL) {
      const counts = getDecisionCounts();

      return (
        <FinalView
          safeCount={counts.safeCount}
          riskCount={counts.riskCount}
          onDownload={downloadReport}
          onFinish={finishSimulation}
        />
      );
    }

    return (
      <MessageView
        account={accountEmail}
        onProfile={openProfile}
        onDetails={openDetails}
        onRequest={openRequest}
        onReport={reportFromMessage}
      />
    );
  }

  if (!sessionReady) {
    return (
      <Shell title="A preparar">
        <main className="flex min-h-[calc(100vh-4rem)] items-center justify-center px-4">
          <div className="text-center">
            <Shield
              size={28}
              className="mx-auto animate-pulse text-blue-700"
            />

            <div className="mt-4 text-sm font-semibold text-slate-500">
              A preparar a experiência...
            </div>
          </div>
        </main>
      </Shell>
    );
  }

  return render();
}