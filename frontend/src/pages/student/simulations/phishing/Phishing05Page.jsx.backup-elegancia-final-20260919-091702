function readPhishingEvents() {
  try {
    const raw = JSON.parse(localStorage.getItem("sicsi_simulation_events") || "[]");
    return Array.isArray(raw)
      ? raw.filter((event) => String(event?.simulation_id || "").startsWith("phishing-"))
      : [];
  } catch {
    return [];
  }
}

function getSimulationLabel(simulationId) {
  const labels = {
    "phishing-01": "Simulação 01 — Actualização de dados académicos",
    "phishing-02": "Simulação 02 — Verificação urgente da conta",
    "phishing-03": "Simulação 03 — Pagamento",
    "phishing-04": "Simulação 04 — Documento partilhado",
    "phishing-05": "Simulação 05 — Identidade digital clonada",
  };
  return labels[simulationId] || simulationId;
}

function getFeedbackText(event) {
  const metadata = event?.metadata || {};
  const candidates = [
    metadata.feedback,
    metadata.feedback_text,
    metadata.feedbackText,
    metadata.feedback_message,
    metadata.message,
    event?.feedback,
  ];
  const value = candidates.find((candidate) => typeof candidate === "string" && candidate.trim());
  return value ? value.trim() : "";
}

function inferFeedbackOutcome(event) {
  const metadata = event?.metadata || {};
  if (typeof metadata.safe === "boolean") return metadata.safe ? "positive" : "negative";

  const explicit = String(metadata.feedback_type || metadata.outcome || metadata.result || event?.outcome || "").toLowerCase();
  if (/positive|positivo|safe|segur|success|correct|sucesso|successo|secure/.test(explicit)) return "positive";
  if (/negative|negativo|risk|risco|danger|unsafe|fail|falha|expos/.test(explicit)) return "negative";

  const feedback = getFeedbackText(event).toLowerCase();
  if (!feedback) return "neutral";
  if (/reduziu|protegeu|interrompeu|evitou|bloqueou|denunciou|cancelou|saiu|seguro|segura|boa decisão|boa pratica|confirmou.*canal|não foi partilh|nao foi partilh/.test(feedback)) return "positive";
  if (/risco|compromet|expos|autoriz|permitiu|perdeu o controlo|partilhou|partilhado|fraude.*avanç|fraude.*avanc|perig|ameaça.*avanç|ameaca.*avanc/.test(feedback)) return "negative";

  return "neutral";
}

function collectDecisionSummaries(events) {
  const orderedIds = ["phishing-01", "phishing-02", "phishing-03", "phishing-04", "phishing-05"];
  const grouped = Object.fromEntries(orderedIds.map((id) => [id, { id, title: getSimulationLabel(id), positive: [], negative: [] }]));

  events.forEach((event) => {
    const id = event?.simulation_id;
    if (!grouped[id]) return;

    const feedback = getFeedbackText(event);
    const outcome = inferFeedbackOutcome(event);
    if (!feedback || (outcome !== "positive" && outcome !== "negative")) return;

    const item = {
      label: event?.metadata?.decision_label || event?.metadata?.decisionLabel || event?.action || "Decisão registada",
      feedback,
    };
    grouped[id][outcome].push(item);
  });

  return orderedIds.map((id) => grouped[id]);
}

function downloadJourneyPdf(accountEmail, accountName) {
  const doc = new jsPDF();
  const events = readPhishingEvents();
  const summaries = collectDecisionSummaries(events);
  let y = 18;

  const addLine = (text, size = 10, bold = false, x = 16) => {
    doc.setFontSize(size);
    doc.setFont("helvetica", bold ? "bold" : "normal");
    const lines = doc.splitTextToSize(String(text), 178);
    if (y + lines.length * (size <= 9 ? 4.5 : 5.5) > 272) {
      doc.addPage();
      y = 18;
    }
    doc.text(lines, x, y);
    y += lines.length * (size <= 9 ? 4.5 : 5.5) + 2;
  };

  addLine("RELATÓRIO DA MINHA EXPERIÊNCIA EM PHISHING", 15, true);
  addLine("SICSI · Síntese de todos os feedbacks positivos e negativos", 10, false);
  addLine(`Participante: ${accountName}`, 9);
  addLine(`Conta: ${accountEmail}`, 9);
  y += 4;

  summaries.forEach((simulation) => {
    addLine(simulation.title, 11, true);

    if (simulation.positive.length) {
      addLine("FEEDBACKS POSITIVOS", 9, true);
      simulation.positive.forEach((item) => {
        addLine(`+ ${item.label}`, 9, true);
        addLine(item.feedback, 8.5, false, 20);
      });
    } else {
      addLine("Feedbacks positivos: nenhum registado.", 8.5, false);
    }

    y += 1;

    if (simulation.negative.length) {
      addLine("FEEDBACKS NEGATIVOS", 9, true);
      simulation.negative.forEach((item) => {
        addLine(`− ${item.label}`, 9, true);
        addLine(item.feedback, 8.5, false, 20);
      });
    } else {
      addLine("Feedbacks negativos: nenhum registado.", 8.5, false);
    }

    y += 4;
  });

  addLine("NOTA", 11, true);
  addLine("O relatório reúne todos os feedbacks positivos e negativos que estejam registados nos eventos das cinco simulações. Não reproduz palavras-passe, códigos MFA ou conteúdos sensíveis.", 9);

  doc.save("SICSI_Relatorio_Da_Minha_Experiencia_Phishing.pdf");
}

