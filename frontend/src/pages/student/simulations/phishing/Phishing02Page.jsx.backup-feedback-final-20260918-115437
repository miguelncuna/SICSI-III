  function renderMainContent() {
    switch (state) {
      case STATES.TICKET:
        return renderTicket();

      case STATES.CHAT:
        return renderChat();

      case STATES.IDENTITY:
        return renderIdentity();

      case STATES.DOWNLOAD:
        return renderDownload();

      case STATES.INSTALL:
        return renderInstall();

      case STATES.REMOTE_ACCESS:
        return renderRemoteAccess();

      case STATES.REMOTE_REFUSED:
        return renderRemoteRefused();

      case STATES.CREDENTIALS:
        return renderCredentials();

      case STATES.MFA:
        return renderMfa();

      case STATES.SAFE_VERIFICATION:
        return renderSafeVerification();

      case STATES.SAFE_OUTCOME:
        return renderSafeOutcome();

      case STATES.CREDENTIAL_OUTCOME:
        return renderCredentialOutcome();

      case STATES.RECOVERY:
        return renderRecovery();

      case STATES.EXIT_FEEDBACK:
        return renderExitFeedback();

      case STATES.COMPLETED:
        return renderCompleted();

      case STATES.INBOX:
      default:
        return renderInbox();
    }
  }

  const isCompleted = state === STATES.COMPLETED;
  const isExitFeedback = state === STATES.EXIT_FEEDBACK;

  return (
    <main className="min-h-screen bg-slate-50 text-slate-900">
      {renderHeader()}

      <div className="mx-auto w-full max-w-6xl px-4 py-6 sm:px-6 sm:py-8 lg:px-8">
        {!isCompleted && !isExitFeedback && renderTopBack()}

        {renderMainContent()}
      </div>
    </main>
  );
}

