  INBOX: "support_inbox",
  TICKET: "support_ticket",
  CHAT: "support_chat",
  IDENTITY: "identity_verification",
  DOWNLOAD: "support_download",
  INSTALL: "support_install",
  REMOTE_ACCESS: "remote_access",
  CREDENTIALS: "credential_request",
  MFA: "mfa_request",
  SAFE_VERIFICATION: "safe_verification",
  SAFE_OUTCOME: "safe_outcome",
  REMOTE_REFUSED: "remote_refused",
  CREDENTIAL_OUTCOME: "credential_outcome",
  RECOVERY: "recovery",
  EXIT_FEEDBACK: "exit_feedback",
  COMPLETED: "completed",
};

function createInitialSession() {
  const current = getCurrentSimulation();

  if (
    current &&
    current.simulation_id === SIMULATION.id &&
    !current.completed
  ) {
    return current;
  }

  const session = startSimulation({
    area: SIMULATION.area,
    simulationId: SIMULATION.id,
    simulationNumber: SIMULATION.number,
    initialState: STATES.INBOX,
  });

  registerAction({
    action: "simulation_started",
    nextState: STATES.INBOX,
    interactionType: "system",
    metadata: {
      simulation_id: SIMULATION.id,
      simulation_number: SIMULATION.number,
    },
  });

  return getCurrentSimulation() || session;
}

export default function Phishing02Page() {
  const navigate = useNavigate();
  const { user } = useAuth();

  const [session, setSession] = useState(() => createInitialSession());
  const [state, setState] = useState(
    () => createInitialSession()?.current_state || STATES.INBOX
  );

  const [elapsedSeconds, setElapsedSeconds] = useState(0);
  const [message, setMessage] = useState("");
  const [ticketStatus, setTicketStatus] = useState("Aberto");
  const [downloaded, setDownloaded] = useState(false);
  const [installed, setInstalled] = useState(false);
  const [remoteAccepted, setRemoteAccepted] = useState(false);

  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");
  const [mfaCode, setMfaCode] = useState("");
  const [mfaRequested, setMfaRequested] = useState(false);

  const accountEmail =
    user?.email ||
    user?.username ||
    user?.login ||
    "";

  useEffect(() => {
    const startedAt = Date.parse(session?.started_at || "");

    if (!Number.isFinite(startedAt)) {
      return undefined;
    }

    const interval = window.setInterval(() => {
      setElapsedSeconds(
        Math.max(0, Math.floor((Date.now() - startedAt) / 1000))
      );
    }, 1000);

    return () => window.clearInterval(interval);
  }, [session]);

  useEffect(() => {
    if (accountEmail && !email) {
      setEmail(accountEmail);
    }
  }, [accountEmail, email]);

  const formattedTime = useMemo(() => {
    const minutes = String(Math.floor(elapsedSeconds / 60)).padStart(2, "0");
    const seconds = String(elapsedSeconds % 60).padStart(2, "0");

    return `${minutes}:${seconds}`;
  }, [elapsedSeconds]);

  function goTo(
    nextState,
    action,
    metadata = {},
    interactionType = "button"
  ) {
    const result = registerAction({
      action,
      nextState,
      interactionType,
      metadata,
    });

    if (result.session) {
      setSession(result.session);
      setState(result.session.current_state);
      return;
    }

    setState(nextState);
  }

  function handleBack() {
    registerAction({
      action: "navigate_back",
      nextState: null,
      interactionType: "navigation",
      metadata: {
        navigation_method: "browser_history",
      },
    });

    navigate(-1);
  }

  function handleOpenTicket() {
    setTicketStatus("Em atendimento");

    goTo(
      STATES.TICKET,
      "open_support_ticket",
      {
        ticket_id: "SUP-2026-0914-4821",
        source: "academic_portal",
      }
    );
  }

  function handleStartChat() {
    goTo(
      STATES.CHAT,
      "start_support_chat",
      {
        channel: "institutional_support",
      }
    );
  }

  function handleSendMessage() {
    const trimmed = message.trim();

    if (!trimmed) {
      return;
    }

    registerAction({
      action: "send_support_message",
      nextState: STATES.CHAT,
      interactionType: "message",
      metadata: {
        message_length: trimmed.length,
        message_category: "support_request",
      },
    });

    setMessage("");
  }

  function handleContinueIdentity() {
    goTo(
      STATES.IDENTITY,
      "open_identity_verification",
      {
        requested_by: "support_agent",
      }
    );
  }

  function handleVerifyIdentity() {
    goTo(
      STATES.DOWNLOAD,
      "continue_identity_verification",
      {
        verification_method: "institutional_account",
        account_present: Boolean(accountEmail),
      }
    );
  }

  function handleDownload() {
    setDownloaded(true);

    goTo(
      STATES.INSTALL,
      "download_support_tool",
      {
        file_name: "SICSI_Support_Assist.exe",
        file_type: "application",
        download_completed: true,
      }
    );
  }

  function handleInstall() {
    setInstalled(true);

    goTo(
      STATES.REMOTE_ACCESS,
      "run_support_tool",
      {
        application: "SICSI Support Assist",
        installation_completed: true,
      }
    );
  }

  function handleRemoteAccess(accepted) {
    setRemoteAccepted(accepted);

    if (accepted) {
      goTo(
        STATES.CREDENTIALS,
        "accept_remote_support",
        {
          remote_access: true,
          permission_scope: "device_support",
        }
      );

      return;
    }

    goTo(
      STATES.REMOTE_REFUSED,
      "refuse_remote_support",
      {
        remote_access: false,
      }
    );
  }

  function handleContinueAfterRemoteRefusal() {
    goTo(
      STATES.SAFE_VERIFICATION,
      "continue_after_remote_refusal",
      {
        alternative_support: true,
      }
    );
  }

  function handleCredentialSubmit(event) {
    event.preventDefault();

    if (!email.trim()) {
      return;
    }

    goTo(
      STATES.MFA,
      "submit_support_credentials",
      {
        email_entered: true,
        password_entered: Boolean(password),
        password_content: "[REDACTED]",
      },
      "form_submit"
    );

    setPassword("");
    setMfaRequested(false);
  }

  function handleRequestMfa() {
    setMfaRequested(true);

    registerAction({
      action: "request_mfa_code",
      nextState: STATES.MFA,
      interactionType: "button",
      metadata: {
        mfa_requested: true,
      },
    });
  }

  function handleSubmitMfa(event) {
    event.preventDefault();

    if (!mfaCode.trim()) {
      return;
    }

    goTo(
      STATES.CREDENTIAL_OUTCOME,
      "submit_mfa_code",
      {
        mfa_code_entered: true,
        mfa_code_content: "[REDACTED]",
