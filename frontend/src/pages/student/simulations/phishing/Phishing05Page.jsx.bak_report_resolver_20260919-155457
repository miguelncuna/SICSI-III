function readPhishingEvents() {
  try {
    const raw = localStorage.getItem("sicsi_simulation_events") || "[]";
    const parsed = JSON.parse(raw);

    if (!Array.isArray(parsed)) {
      return [];
    }

    return parsed
      .filter((event) =>
        String(event?.simulation_id || "").startsWith("phishing-")
      )
      .sort((a, b) => {
        const aTime = new Date(a?.timestamp || 0).getTime();
        const bTime = new Date(b?.timestamp || 0).getTime();

        return aTime - bTime;
      });
  } catch {
    return [];
  }
}

function getSimulationLabel(simulationId) {
  const labels = {
    "phishing-01": "Actualização de dados académicos",
    "phishing-02": "Verificação urgente da conta",
    "phishing-03": "Pagamento",
    "phishing-04": "Documento partilhado",
    "phishing-05": "Identidade digital clonada",
  };

  return labels[simulationId] || "Experiência de segurança";
}

function getFeedbackText(event) {
  const metadata = event?.metadata || {};

  const candidates = [
    metadata.feedback,
    metadata.feedback_text,
    metadata.feedbackText,
    metadata.feedback_message,
    event?.feedback,
  ];

  const value = candidates.find(
    (candidate) =>
      typeof candidate === "string" &&
      candidate.trim()
  );

  return value ? value.trim() : "";
}

function getEventTime(event) {
  const timestamp = new Date(
    event?.timestamp || 0
  ).getTime();

  if (Number.isFinite(timestamp) && timestamp > 0) {
    return timestamp;
  }

  return Number(event?.sequence || 0);
}

function getLatestFeedbackForSimulation(
  events,
  simulationId
) {
  const simulationEvents =
    events
      .filter(
        (event) =>
          String(
            event?.simulation_id || ""
          ) === simulationId
      )
      .sort(
        (a, b) =>
          getEventTime(a) -
          getEventTime(b)
      );

  if (
    simulationEvents.length === 0
  ) {
    return {
      simulationId,
      title:
        getSimulationLabel(
          simulationId
        ),
      feedback: "",
      safe: null,
      timestamp: null,
    };
  }

  /*
   * ----------------------------------------------------------
   * Sessão mais recente desta simulação.
   * ----------------------------------------------------------
   */
  const sessions =
    Array.from(
      new Set(
        simulationEvents
          .map(
            (event) =>
              event?.session_id
          )
          .filter(Boolean)
      )
    );

  let latestSessionId =
    sessions[
      sessions.length - 1
    ];

  if (
    sessions.length > 1
  ) {
    latestSessionId =
      sessions
        .map(
          (sessionId) => ({
            sessionId,
            lastEvent:
              simulationEvents
                .filter(
                  (event) =>
                    event?.session_id ===
                    sessionId
                )
                .sort(
                  (a, b) =>
                    getEventTime(b) -
                    getEventTime(a)
                )[0],
          })
        )
        .sort(
          (a, b) =>
            getEventTime(
              b.lastEvent
            ) -
            getEventTime(
              a.lastEvent
            )
        )[0]
        ?.sessionId;
  }

  const latestSessionEvents =
    latestSessionId
      ? simulationEvents.filter(
          (event) =>
            event?.session_id ===
            latestSessionId
        )
      : simulationEvents;

  /*
   * ----------------------------------------------------------
   * 1. Feedback explícito de decisão.
   * ----------------------------------------------------------
   */
  const decisionFeedbacks =
    latestSessionEvents.filter(
      (event) =>
        event?.interaction_type ===
          "decision" &&
        event?.metadata
          ?.report_relevant ===
          true &&
        Boolean(
          getFeedbackText(event)
        )
    );

  /*
   * ----------------------------------------------------------
   * 2. Qualquer feedback explicitamente marcado
   *    como relevante para o relatório.
   * ----------------------------------------------------------
   */
  const relevantFeedbacks =
    latestSessionEvents.filter(
      (event) =>
        event?.metadata
          ?.report_relevant ===
          true &&
        Boolean(
          getFeedbackText(event)
        )
    );

  /*
   * ----------------------------------------------------------
   * Selecção do evento que alimenta o relatório.
   *
   * A Simulação 04 possui dois eventos relevantes:
   * - authentication_service_response -> resultado real da experiência
   * - leave_simulation -> saída/interrupção
   *
   * Para a 04, o resultado da autenticação deve ter prioridade,
   * mesmo quando existir posteriormente um evento de saída.
   * ----------------------------------------------------------
   */
  let selectedEvent = null;

  if (simulationId === "phishing-04") {
    /*
     * SIMULAÇÃO 04 — RESULTADO REAL
     *
     * Procurar o evento real da experiência em TODOS os
     * eventos disponíveis, não apenas na sessão actualmente
     * seleccionada.
     *
     * O relatório deve apresentar exactamente o feedback
     * produzido pela Simulação 04.
     */
    const authenticationEvents =
      simulationEvents
        .filter(
          (event) =>
            event?.action ===
              "authentication_service_response"
        )
        .sort(
          (a, b) =>
            getEventTime(a) -
            getEventTime(b)
        );

    if (authenticationEvents.length > 0) {
      selectedEvent =
        authenticationEvents[
          authenticationEvents.length - 1
        ];
    }
  }

  if (!selectedEvent) {
    selectedEvent =
      decisionFeedbacks.length > 0
        ? decisionFeedbacks[
            decisionFeedbacks.length - 1
          ]
        : relevantFeedbacks.length > 0
          ? relevantFeedbacks[
              relevantFeedbacks.length - 1
            ]
          : null;
  }

  /*
   * ----------------------------------------------------------
   * 3. Fallback REAL e controlado para a Simulação 04.
   *
   * Estes dois eventos correspondem directamente aos
   * resultados apresentados pela interface da 04.
   * ----------------------------------------------------------
   */
  if (
    !selectedEvent &&
    simulationId ===
      "phishing-04"
  ) {
    const fallbackEvents =
      latestSessionEvents.filter(
        (event) =>
          event?.action ===
            "authentication_service_response" ||
          event?.action ===
            "leave_simulation"
      );

    if (
      fallbackEvents.length > 0
    ) {
      selectedEvent =
        fallbackEvents[
          fallbackEvents.length - 1
        ];
    }
  }

  /*
   * ----------------------------------------------------------
   * 4. Último recurso:
   *    procurar qualquer evento da sessão que já possua
   *    feedback textual explícito.
   * ----------------------------------------------------------
   */
  if (!selectedEvent) {
    const textualFeedbackEvents =
      latestSessionEvents.filter(
        (event) =>
          Boolean(
            getFeedbackText(event)
          )
      );

    if (
      textualFeedbackEvents.length > 0
    ) {
      selectedEvent =
        textualFeedbackEvents[
          textualFeedbackEvents.length - 1
        ];
    }
  }

  if (!selectedEvent) {
    return {
      simulationId,
      title:
        getSimulationLabel(
          simulationId
        ),
      feedback: "",
      safe: null,
      timestamp: null,
    };
  }

  const metadata =
    selectedEvent?.metadata ||
    {};

  let feedback =
    getFeedbackText(
      selectedEvent
    );

  let safe =
    typeof metadata.safe ===
    "boolean"
      ? metadata.safe
      : null;


  return {
    simulationId,
    title:
      getSimulationLabel(
        simulationId
      ),
    feedback,
    safe,
    timestamp:
      selectedEvent?.timestamp ||
      null,
  };
}
function getReportDate(value) {
  const date = value
    ? new Date(value)
    : new Date();

  if (Number.isNaN(date.getTime())) {
    return "—";
  }

  return date.toLocaleDateString(
    "pt-PT",
    {
      day: "2-digit",
      month: "long",
      year: "numeric",
    }
  );
}

