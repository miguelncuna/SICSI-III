    } else {
      const session = startSimulation({
        area: SIMULATION.area,
        simulationId: SIMULATION.id,
        simulationNumber: SIMULATION.number,
        initialState: STATES.MESSAGE,
      });
      setStartedAt(session?.started_at ? new Date(session.started_at).getTime() : Date.now());
      registerAction({
        action: "simulation_started",
        nextState: STATES.MESSAGE,
        interactionType: "system",
        metadata: { simulation_id: SIMULATION.id, simulation_number: SIMULATION.number, title: SIMULATION.title },
      });
