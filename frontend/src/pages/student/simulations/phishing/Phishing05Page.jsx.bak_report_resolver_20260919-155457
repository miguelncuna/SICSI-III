      action: "provide_identity_information_to_phishing_page",
      decisionLabel: "Prosseguiu com a verificação numa página externa",
      feedback: "A informação foi encaminhada no cenário para uma página associada ao domínio suspeito. Uma clonagem de identidade pode ser utilizada como porta de entrada para recolher informação adicional.",
    });
  }

  function exitPhishingPage() {
    recordFeedback({
      safe: true,
      action: "exit_identity_verification_page",
      decisionLabel: "Saiu da página de verificação externa",
      feedback: "A ligação foi interrompida antes da partilha de informação. Sair quando o domínio não corresponde ao serviço esperado reduz imediatamente a exposição.",
    });
  }

  function continueFromFeedback() {
    track("continue_to_attack_chain", STATES.ATTACK_CHAIN, "navigation", {
      report_relevant: false,
      previous_decision: feedbackContext?.decisionLabel,
    });
    setState(STATES.ATTACK_CHAIN);
  }

  function continueToResponse() {
    track("continue_to_incident_response", STATES.RESPONSE, "navigation", { report_relevant: false });
    setState(STATES.RESPONSE);
  }

  function finalSecureResponse() {
    const feedback = "A identidade suspeita foi denunciada, o contacto foi interrompido e a resposta concentrou-se em reduzir a exposição sem perder as evidências do incidente.";
    track("protect_and_end_suspicious_contact", STATES.RESPONSE_FEEDBACK, "decision", { safe: true, report_relevant: true, decision_label: "Protegeu a conta e encerrou o contacto suspeito", feedback, simulation_id: SIMULATION.id });
    setDecisions((current) => [...current, { safe: true, decisionLabel: "Protegeu a conta e encerrou o contacto suspeito", feedback }]);
    setFeedbackContext({ safe: true, decisionLabel: "Protegeu a conta e encerrou o contacto suspeito", feedback });
    setState(STATES.RESPONSE_FEEDBACK);
  }

  function reportAffected() {
    const feedback = "A denúncia e o alerta aos afectados reduzem a possibilidade de a identidade clonada continuar a ser utilizada para novas tentativas.";
    track("report_and_alert_affected_users", STATES.RESPONSE_FEEDBACK, "decision", { safe: true, report_relevant: true, decision_label: "Denunciou a identidade e alertou os afectados", feedback, simulation_id: SIMULATION.id });
    setDecisions((current) => [...current, { safe: true, decisionLabel: "Denunciou a identidade e alertou os afectados", feedback }]);
    setFeedbackContext({ safe: true, decisionLabel: "Denunciou a identidade e alertou os afectados", feedback });
    setState(STATES.RESPONSE_FEEDBACK);
  }

  function ignoreIncident() {
    const feedback = "Ignorar a identidade clonada deixa o perfil activo e permite que a mesma estratégia seja utilizada novamente contra outras pessoas.";
    track("ignore_cloned_identity_incident", STATES.RESPONSE_FEEDBACK, "decision", { safe: false, report_relevant: true, decision_label: "Ignorou o incidente e continuou normalmente", feedback, simulation_id: SIMULATION.id });
    setDecisions((current) => [...current, { safe: false, decisionLabel: "Ignorou o incidente e continuou normalmente", feedback }]);
    setFeedbackContext({ safe: false, decisionLabel: "Ignorou o incidente e continuou normalmente", feedback });
    setState(STATES.RESPONSE_FEEDBACK);
  }

  

  function downloadReport() {
    track("download_phishing_journey_report", STATES.RESPONSE_FEEDBACK, "download", { report_relevant: false, format: "pdf" });
    downloadJourneyPdf(accountEmail, accountName);
  }

  function finishSimulation() {
    track("complete_phishing_05", STATES.RESPONSE_FEEDBACK, "navigation", { report_relevant: true, safe: feedbackContext?.safe, decision_label: feedbackContext?.decisionLabel, feedback: feedbackContext?.feedback || "Experiência concluída." });
    completeSimulation();
    completeSimulationSession();
    const session = getCurrentSimulation();
    if (session?.session_id) clearSessionEvents(session.session_id);
    navigate("/student/simulacoes");
  }

  function render() {
    if (state === STATES.MESSAGE) {
      return <MessageView account={accountEmail} accountName={accountName} onDetails={openDetails} onProfile={openProfile} onOpenLink={openLink} onReport={reportCommunication} />;
    }
    if (state === STATES.DETAILS) {
      return <DetailsView accountName={accountName} clonedEmail={clonedEmail} replyEmail={replyEmail} onBack={() => setState(STATES.MESSAGE)} onProfile={openProfile} onConversation={openConversation} onLink={openLink} onReport={reportCommunication} />;
    }
    if (state === STATES.PROFILE) {
      return <ProfileView accountName={accountName} identityHandle={identityHandle} onBack={() => setState(STATES.MESSAGE)} onVerify={verifyIdentity} onConversation={openConversation} onReport={reportCommunication} onLink={openLink} />;
    }
    if (state === STATES.CONVERSATION) {
      return <ConversationView accountName={accountName} onBack={() => setState(STATES.MESSAGE)} onVerify={verifyIdentity} onSend={sendDocument} onLink={openLink} onReport={reportCommunication} />;
    }
    if (state === STATES.VERIFICATION) {
      return <VerificationView onBack={() => setState(STATES.PROFILE)} onConfirm={confirmIdentity} onCancel={() => setState(STATES.PROFILE)} />;
    }
    if (state === STATES.LINK) {
      return <LinkView onBack={() => setState(STATES.MESSAGE)} onOpen={openPhishingPage} />;
    }
    if (state === STATES.PHISHING_PAGE) {
      return <PhishingPageView accountName={accountName} verificationEmail={clonedEmail} onBack={() => setState(STATES.LINK)} onProvideInfo={provideInfo} onExit={exitPhishingPage} />;
    }
    if (state === STATES.FEEDBACK) {
      return <FeedbackView
  safe={feedbackContext?.safe !== false}
  decisionLabel={feedbackContext?.decisionLabel || "Decisão registada"}
  feedback={feedbackContext?.feedback || "Interacção registada."}
  onContinue={continueFromFeedback}
  onDownloadReport={downloadReport}
  onFinish={finishSimulation}
  showFinalActions
/>;
    }
    if (state === STATES.ATTACK_CHAIN) {
      return <AttackChainView onBack={() => setState(STATES.FEEDBACK)} onContinue={continueToResponse} />;
    }
    if (state === STATES.RESPONSE) {
      return <ResponseView onBack={() => setState(STATES.ATTACK_CHAIN)} onSecure={finalSecureResponse} onReport={reportAffected} onIgnore={ignoreIncident} />;
    }
    if (state === STATES.RESPONSE_FEEDBACK) {
      return <ResponseFeedbackView
  safe={feedbackContext?.safe !== false}
  title={feedbackContext?.decisionLabel || "Resposta registada"}
  description={feedbackContext?.feedback || "Resposta registada."}
  onDownloadReport={downloadReport}
  onFinish={finishSimulation}
/>;
    }
    return <MessageView account={accountEmail} accountName={accountName} onDetails={openDetails} onProfile={openProfile} onOpenLink={openLink} onReport={reportCommunication} />;
  }

  if (!sessionReady) {
    return (
      <Shell title="Phishing 05">
        <main className="flex min-h-[calc(100vh-4rem)] items-center justify-center px-4">
          <div className="text-center">
            <div className="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-blue-50 text-blue-700 animate-pulse"><Shield size={22} /></div>
            <div className="mt-4 text-sm font-semibold text-slate-500">A preparar a experiência...</div>
          </div>
        </main>
      </Shell>
    );
  }

  return render();
}






















