function getAccountEmail(user) {
  return user?.email || user?.username || user?.login || "estudante@sicsi.edu";
}

function getAccountName(user) {
  return (
    user?.name ||
    user?.full_name ||
    user?.fullName ||
    user?.displayName ||
    user?.username ||
    (user?.email ? String(user.email).split("@")[0] : "") ||
    "Titular da conta"
  );
}

function getIdentityHandle(name) {
  const normalized = String(name || "titular.da.conta")
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, ".")
    .replace(/^\.|\.$/g, "")
    .replace(/\.{2,}/g, ".");
  return `@${normalized || "titular.da.conta"}`;
}

function formatDuration(milliseconds) {
  const totalSeconds = Math.max(0, Math.floor(milliseconds / 1000));
  const minutes = Math.floor(totalSeconds / 60);
  const seconds = totalSeconds % 60;
  return `${String(minutes).padStart(2, "0")}:${String(seconds).padStart(2, "0")}`;
}

