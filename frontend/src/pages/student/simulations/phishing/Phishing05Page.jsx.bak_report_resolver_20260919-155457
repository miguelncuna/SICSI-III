 */
const palavrasFeedback =
  feedbackTexto
    .split(" ")
    .filter(Boolean);

let linhaActual = "";

palavrasFeedback.forEach(
  (palavra) => {

    const candidata =
      linhaActual
        ? `${linhaActual} ${palavra}`
        : palavra;

    if (
      doc.getTextWidth(
        candidata
      ) <= feedbackTextWidth
    ) {

      linhaActual =
        candidata;

      return;
    }

    /*
     * Guardar linha completa.
     */
    if (linhaActual) {

      feedbackLines.push(
        linhaActual
      );

      linhaActual =
        "";
    }

    /*
     * Palavra cabe sozinha.
     */
    if (
      doc.getTextWidth(
        palavra
      ) <= feedbackTextWidth
    ) {

      linhaActual =
        palavra;

      return;
    }

    /*
     * Palavra excepcionalmente longa:
     * dividir por caracteres.
     */
    let fragmento = "";

    Array.from(
      palavra
    ).forEach(
      (caracter) => {

        const tentativa =
          fragmento +
          caracter;

        if (
          doc.getTextWidth(
            tentativa
          ) <= feedbackTextWidth
        ) {

          fragmento =
            tentativa;

        }
        else {

          if (fragmento) {

            feedbackLines.push(
              fragmento
            );
          }

          fragmento =
            caracter;
        }
      }
    );

    linhaActual =
      fragmento;
  }
);

