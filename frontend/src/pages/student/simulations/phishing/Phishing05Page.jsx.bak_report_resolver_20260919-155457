      {
        align: "right",
      }
    );
  }

  function drawPageHeader(
  simulation,
  pageNumber
) {

  /*
   * ============================================================
   * HEADER SICSI III
   * ============================================================
   *
   * Uma única superfície visual.
   *
   * Gradiente:
   * #1E40AF -> #2563EB
   *
   * Sem:
   * - caixa por trás;
   * - borda;
   * - faixas;
   * - segunda camada.
   */

  const headerX =
    margin;

  const headerY =
    12;

  const headerWidth =
    contentWidth;

  const headerHeight =
    34;

  /*
   * ============================================================
   * GERAR O GRADIENTE NUM CANVAS TRANSPARENTE
   * ============================================================
   *
   * O próprio canvas possui os cantos arredondados.
   * Portanto, o PDF recebe apenas UMA imagem.
   */

  const headerCanvas =
    document.createElement(
      "canvas"
    );

  headerCanvas.width =
    1600;

  headerCanvas.height =
    280;

  const headerContext =
    headerCanvas.getContext(
      "2d"
    );

  /*
   * Fundo totalmente transparente.
   */
  headerContext.clearRect(
    0,
    0,
    headerCanvas.width,
    headerCanvas.height
  );

  /*
   * Gradiente horizontal de duas cores SICSI.
   */
  const headerGradient =
    headerContext.createLinearGradient(
      0,
      0,
      headerCanvas.width,
      0
    );

  headerGradient.addColorStop(
    0,
    "rgb(30, 64, 175)"
  );

  headerGradient.addColorStop(
    1,
    "rgb(37, 99, 235)"
  );

  /*
   * Cantos arredondados.
   */
  const radius =
    34;

  headerContext.beginPath();

  headerContext.moveTo(
    radius,
    0
  );

  headerContext.lineTo(
    headerCanvas.width -
      radius,
    0
  );

  headerContext.quadraticCurveTo(
    headerCanvas.width,
    0,
    headerCanvas.width,
    radius
  );

  headerContext.lineTo(
    headerCanvas.width,
    headerCanvas.height -
      radius
  );

  headerContext.quadraticCurveTo(
    headerCanvas.width,
    headerCanvas.height,
    headerCanvas.width -
      radius,
    headerCanvas.height
  );

  headerContext.lineTo(
    radius,
    headerCanvas.height
  );

  headerContext.quadraticCurveTo(
    0,
    headerCanvas.height,
    0,
    headerCanvas.height -
      radius
  );

  headerContext.lineTo(
    0,
    radius
  );

  headerContext.quadraticCurveTo(
    0,
    0,
    radius,
    0
  );

  headerContext.closePath();

  /*
   * O gradiente fica limitado ao
   * formato arredondado.
   */
  headerContext.save();

  headerContext.clip();

  headerContext.fillStyle =
    headerGradient;

  headerContext.fillRect(
    0,
    0,
    headerCanvas.width,
    headerCanvas.height
  );

  headerContext.restore();

  /*
   * Um pequeno brilho diagonal, muito subtil.
   * Continua dentro da mesma camada.
   */
  const shineGradient =
    headerContext.createLinearGradient(
      0,
      0,
      headerCanvas.width,
      headerCanvas.height
    );

  shineGradient.addColorStop(
    0,
    "rgba(255,255,255,0.10)"
  );

  shineGradient.addColorStop(
    0.45,
    "rgba(255,255,255,0)"
  );

  shineGradient.addColorStop(
    1,
