      );
    }
    if (state === STATES.ACCESS_REQUEST) {
      return (
        <RequestAccessView
          account={accountEmail}
          onBack={returnToDocument}
          onContinue={continueIdentityCheck}
        />
      );
    }

    if (state === STATES.IDENTITY_CHECK) {
      return (
        <IdentityCheckView
          account={accountEmail}
          onBack={() => {
            registerNavigation(
              "return_to_access_request",
              STATES.ACCESS_REQUEST
            );

            setState(STATES.ACCESS_REQUEST);
          }}
          onContinue={continueIdentityCheck}
        />
      );
    }

    if (state === STATES.AUTHENTICATION) {
      return (
        <AuthenticationView
          account={accountEmail}
          onBack={() => {
            registerNavigation(
              "return_to_identity_check",
              STATES.IDENTITY_CHECK
            );

            setState(STATES.IDENTITY_CHECK);
          }}
          onSubmit={submitAuthentication}
        />
      );
    }

    if (state === STATES.AUTH_PROCESSING) {
      return (
        <AuthenticationProcessingView
          onContinue={authenticationProcessed}
        />
      );
    }

    if (state === STATES.AUTH_RESULT) {
      return (
        <AuthenticationResultView
          onBack={() => {
            registerNavigation(
              "return_to_authentication",
              STATES.AUTHENTICATION
            );

            setState(STATES.AUTHENTICATION);
          }}
          onReturn={returnFromAuthentication}
        />
      );
    }

    if (state === STATES.DOWNLOAD_PROCESSING) {
      return (
        <DownloadProcessingView
          onContinue={downloadProcessed}
        />
      );
    }

    if (state === STATES.DOWNLOAD_RESULT) {
      return (
        <DownloadResultView
          format={selectedDownloadFormat}
          onBack={returnToDocument}
          onNext={nextSimulation}
        />
      );
    }

    if (state === STATES.DOWNLOAD_READY) {
      return (
        <DownloadReadyView
          onBack={returnToDocument}
          onOpenFile={reopenDownloadedDocument}
        />
      );
    }

    if (state === STATES.ATTACHMENT_RESULT) {
      return (
        <AttachmentResultView
          onBack={() => {
            registerNavigation(
              "return_to_document_after_attachment",
              STATES.DOCUMENT_VIEWER
            );

            setState(STATES.DOCUMENT_VIEWER);
          }}
          onNext={nextSimulation}
        />
      );
    }

    if (state === STATES.SAFE_EXIT) {
      return (
        <SafeExitView
          onBack={returnToDocument}
          onNext={nextSimulation}
        />
      );
    }

    if (state === STATES.COMPLETED) {
      return (
        <CompletedView
          onFinish={finishSimulation}
          onNext={nextSimulation}
        />
      );
    }

    return (
      <DocumentHome
        onOpenDocument={openDocument}
        onShared={() =>
          registerNavigation(
            "open_shared_documents",
            STATES.HOME
          )
        }
        onSearch={openSearch}
        searchOpen={searchOpen}
      />
    );
  }

  return (
    <AppShell
      account={accountEmail}
      onBack={cancelSimulation}
      onHome={goHome}
      onSearch={openSearch}
      searchOpen={searchOpen}
    >
      {renderState()}

      {state !== STATES.HOME &&
      state !== STATES.COMPLETED &&
      state !== STATES.SAFE_EXIT &&
       state !== STATES.SHARE_RESULT &&
      state !== STATES.AUTHENTICATION &&
      state !== STATES.AUTH_PROCESSING &&
      state !== STATES.AUTH_RESULT &&
      state !== STATES.IDENTITY_CHECK &&
      state !== STATES.ACCESS_REQUEST &&
      state !== STATES.DOWNLOAD_PROCESSING &&
      state !== STATES.DOWNLOAD_READY ? (
        <div className="sticky bottom-0 z-30 border-t border-slate-200 bg-white/95 px-4 py-3 backdrop-blur-xl md:px-8">
          <div className="mx-auto flex max-w-7xl items-center justify-between gap-3">
            <div className="hidden items-center gap-2 text-xs text-slate-400 sm:flex">
              <PanelRight size={15} />
              <span>Documento partilhado · Sessão activa</span>
            </div>

            <div className="ml-auto flex items-center gap-2">
              <button
                type="button"
                onClick={cancelSimulation}
                className="inline-flex items-center gap-2 rounded-xl px-3 py-2.5 text-xs font-semibold text-slate-500 transition hover:bg-slate-100 hover:text-slate-800"
              >
                <X size={16} />
                Sair
              </button>
              <button
                type="button"
                onClick={reportSimulation}
                className="inline-flex items-center justify-center gap-2 rounded-xl border border-red-200 bg-red-50 px-4 py-2.5 text-sm font-bold text-red-700 transition hover:bg-red-100"
              >
                <ShieldAlert className="h-4 w-4" />
                Denunciar
              </button>

              <button
                type="button"
                onClick={() => {
                  registerNavigation(
                    "continue_simulation_from_current_state",
                    STATES.DOCUMENT_VIEWER,
                    {
                      source_state: state,
                    }
                  );

                  setState(STATES.DOCUMENT_VIEWER);
                }}
                className="inline-flex items-center gap-2 rounded-xl bg-blue-700 px-4 py-2.5 text-xs font-bold text-white shadow-sm transition hover:bg-blue-800"
              >
                <ArrowRight size={16} />
                Continuar
              </button>
            </div>
          </div>
        </div>
      ) : null}
    </AppShell>
  );
}


