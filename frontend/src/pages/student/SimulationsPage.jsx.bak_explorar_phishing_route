const futureCategories = [
  {
    id: "engenharia-social",
    number: "02",
    title: "Engenharia Social",
    description:
      "Reconheça manipulação, pressão e pedidos de informação em situações realistas.",
    icon: Users,
    image: categoryImages.engenharia,
  },
  {
