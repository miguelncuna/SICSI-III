  async function obterElementoCertificado(
    certificate
  ) {
    /*
     * Quando o certificado já está aberto,
     * utilizamos directamente o elemento visível.
     *
     * Isto evita provocar um novo render através
     * de setSelected() antes da captura.
     */
    const elementoActual =
      certificateRef.current ||
      document.querySelector(
        '[data-sicsi-certificate="true"]'
      );

    if (
      elementoActual &&
      elementoActual.getBoundingClientRect().width > 0 &&
      elementoActual.getBoundingClientRect().height > 0
    ) {
      if (document.fonts?.ready) {
        await document.fonts.ready;
      }

      await new Promise((resolve) =>
        requestAnimationFrame(resolve)
      );

      return elementoActual;
    }

    /*
     * Este caminho só é usado quando o botão
     * Baixar é clicado directamente no cartão.
     */
    setSelected(certificate);

    for (
      let tentativa = 0;
      tentativa < 60;
      tentativa++
    ) {
      await new Promise((resolve) =>
        setTimeout(resolve, 100)
      );

      const elemento =
        certificateRef.current ||
        document.querySelector(
          '[data-sicsi-certificate="true"]'
        );

      if (
        elemento &&
        elemento.getBoundingClientRect().width > 0 &&
        elemento.getBoundingClientRect().height > 0
      ) {
        if (document.fonts?.ready) {
          await document.fonts.ready;
        }

        return elemento;
      }
    }

    throw new Error(
      "Não foi possível localizar o certificado visual."
    );
  }
  function converterOklchParaRgb(
    valor
  ) {
    const texto =
      String(valor || "");

    /*
     * Converte OKLab/OKLCH para sRGB.
     *
     * O html2canvas 1.4.1 não interpreta
     * directamente estas funções CSS modernas.
     */

    const converterCanalSrgb = (
      canal
    ) => {
      const limitado =
        Math.min(
          1,
          Math.max(
            0,
            canal
          )
        );

      const srgb =
        limitado <= 0.0031308
          ? 12.92 * limitado
          : 1.055 *
              Math.pow(
                limitado,
                1 / 2.4
              ) -
            0.055;

      return Math.round(
        255 * srgb
      );
    };

    const converterAlpha = (
      valorAlpha
    ) => {
      if (
        valorAlpha === undefined
      ) {
        return 1;
      }

      const limpo =
        String(valorAlpha)
          .trim()
          .replace(
            "%",
            ""
          );

      let alpha =
        Number(limpo);

      if (
        String(valorAlpha)
          .includes("%")
      ) {
        alpha =
          alpha / 100;
      }

      if (
        !Number.isFinite(alpha)
      ) {
        return 1;
      }

      return Math.min(
        1,
        Math.max(
          0,
          alpha
        )
      );
    };

    const converterOklab = (
      L,
      a,
      b,
      alpha
    ) => {
      const l_ =
        L +
        0.3963377774 * a +
        0.2158037573 * b;

      const m_ =
        L -
        0.1055613458 * a -
        0.0638541728 * b;

      const s_ =
        L -
        0.0894841775 * a -
        1.2914855480 * b;

      const l =
        l_ * l_ * l_;

      const m =
        m_ * m_ * m_;

      const s =
        s_ * s_ * s_;

      let vermelho =
        4.0767416621 * l -
        3.3077115913 * m +
        0.2309699292 * s;

      let verde =
        -1.2684380046 * l +
        2.6097574011 * m -
        0.3413193965 * s;

      let azul =
        -0.0041960863 * l -
        0.7034186147 * m +
        1.7076147010 * s;

      vermelho =
        converterCanalSrgb(
          vermelho
        );

      verde =
        converterCanalSrgb(
          verde
        );

      azul =
        converterCanalSrgb(
          azul
        );

      if (
        alpha >= 0.999
      ) {
        return `rgb(${vermelho}, ${verde}, ${azul})`;
      }

      return `rgba(${vermelho}, ${verde}, ${azul}, ${alpha})`;
    };

    /*
     * ========================================================
     * OKLAB
     * ========================================================
     */

    const regexOklab =
      /oklab\(\s*([^\s]+)\s+([^\s]+)\s+([^\s]+)(?:\s*\/\s*([^\s]+))?\s*\)/gi;

    let resultado =
      texto.replace(
        regexOklab,
        (
          _match,
          lValor,
          aValor,
          bValor,
          alphaValor
        ) => {

          let L =
            Number(
              String(lValor)
                .replace(
                  "%",
                  ""
                )
                .trim()
            );

          if (
            String(lValor)
              .includes("%")
          ) {
            L =
              L / 100;
          }

          let a =
            Number(
              String(aValor)
                .replace(
                  "%",
                  ""
                )
                .trim()
            );

          let b =
            Number(
              String(bValor)
                .replace(
                  "%",
                  ""
                )
                .trim()
            );

          /*
           * Em OKLab, percentagens de a/b
           * correspondem aproximadamente a
           * ±0.4 no espaço numérico.
           */
          if (
            String(aValor)
              .includes("%")
          ) {
            a =
              a * 0.4 / 100;
          }

          if (
            String(bValor)
              .includes("%")
          ) {
            b =
              b * 0.4 / 100;
          }

          const alpha =
            converterAlpha(
              alphaValor
            );

          if (
            !Number.isFinite(L) ||
            !Number.isFinite(a) ||
            !Number.isFinite(b)
          ) {
            return _match;
          }

          return converterOklab(
            L,
            a,
            b,
            alpha
          );
        }
      );

    /*
     * ========================================================
     * OKLCH
     * ========================================================
     */

    const regexOklch =
      /oklch\(\s*([^\s]+)\s+([^\s]+)\s+([^\s]+)(?:\s*\/\s*([^\s]+))?\s*\)/gi;

    resultado =
      resultado.replace(
        regexOklch,
        (
          _match,
          lValor,
          cValor,
          hValor,
          alphaValor
        ) => {

          let L =
            Number(
              String(lValor)
                .replace(
                  "%",
                  ""
                )
                .trim()
            );

          if (
            String(lValor)
              .includes("%")
          ) {
            L =
              L / 100;
          }

          let C =
            Number(
              String(cValor)
                .replace(
                  "%",
                  ""
                )
                .trim()
            );

          if (
            String(cValor)
              .includes("%")
          ) {
            C =
              C / 100;
          }

          let H =
            Number(
              String(hValor)
                .replace(
                  "deg",
                  ""
                )
                .trim()
            );

          if (
            String(hValor)
              .includes("rad")
          ) {
            H =
              Number(
                String(hValor)
                  .replace(
                    "rad",
                    ""
                  )
                  .trim()
              ) *
              (180 / Math.PI);
          }

          if (
            String(hValor)
              .includes("turn")
          ) {
            H =
              Number(
                String(hValor)
                  .replace(
                    "turn",
                    ""
                  )
                  .trim()
              ) *
              360;
          }

          if (
            !Number.isFinite(L) ||
            !Number.isFinite(C) ||
            !Number.isFinite(H)
          ) {
            return _match;
          }

          const hRad =
            (H * Math.PI) / 180;

          const a =
            C *
            Math.cos(hRad);

          const b =
            C *
            Math.sin(hRad);

          const alpha =
            converterAlpha(
              alphaValor
            );

          return converterOklab(
            L,
            a,
            b,
            alpha
          );
        }
      );

    return resultado;
  }
  function normalizarEstilosParaCaptura(
    original,
    copia
  ) {
    const originalNodes =
      [
        original,
        ...original.querySelectorAll("*"),
      ];

    const copiaNodes =
      [
        copia,
        ...copia.querySelectorAll("*"),
      ];

    for (
      let i = 0;
      i < originalNodes.length;
      i++
    ) {
      const originalNode =
        originalNodes[i];

      const copiaNode =
        copiaNodes[i];

      if (
        !originalNode ||
        !copiaNode ||
        !originalNode.ownerDocument
      ) {
        continue;
      }

      const estilos =
        window.getComputedStyle(
          originalNode
        );

      for (
        let j = 0;
        j < estilos.length;
        j++
      ) {
        const propriedade =
          estilos[j];

        const valor =
          estilos.getPropertyValue(
            propriedade
          );

        if (!valor) {
          continue;
        }

        copiaNode.style.setProperty(
          propriedade,
          converterOklchParaRgb(
            valor
          )
        );
      }

      copiaNode.removeAttribute(
        "class"
      );
    }
  }
  async function gerarPdfDoCertificado(
    certificate
  ) {
    const elemento =
      await obterElementoCertificado(
        certificate
      );

    if (!elemento) {
      throw new Error(
        "O certificado visual não está disponível."
      );
    }

    if (document.fonts?.ready) {
      await document.fonts.ready;
    }

    const copia =
      elemento.cloneNode(true);

    const rect =
      elemento.getBoundingClientRect();

    const largura =
      Math.ceil(
        rect.width ||
          elemento.scrollWidth
      );

    const altura =
      Math.ceil(
        rect.height ||
          elemento.scrollHeight
      );

    /*
     * A cópia recebe os estilos computados
     * directamente em inline styles.
     *
     * Isto impede o html2canvas de precisar
     * interpretar as cores oklch do Tailwind v4.
     */
    normalizarEstilosParaCaptura(
      elemento,
      copia
    );

    const contentor =
      document.createElement(
        "div"
      );

    contentor.style.position =
      "fixed";

    contentor.style.left =
      "-100000px";

    contentor.style.top =
      "0";

    contentor.style.width =
      `${largura}px`;

    contentor.style.height =
      `${altura}px`;

    contentor.style.overflow =
      "hidden";

    contentor.style.background =
      "#ffffff";

    contentor.style.pointerEvents =
      "none";

    contentor.style.zIndex =
      "-1";

    contentor.appendChild(
      copia
    );

    document.body.appendChild(
      contentor
    );

    try {
      const canvas =
        await html2canvas(
          copia,
          {
            scale: 3,
            useCORS: true,
            allowTaint: false,
            backgroundColor:
              "#ffffff",
            logging: false,
            width: largura,
            height: altura,
            windowWidth: largura,
            windowHeight: altura,
            scrollX: 0,
            scrollY: 0,
          }
        );

      if (
        !canvas ||
        canvas.width <= 0 ||
        canvas.height <= 0
      ) {
        throw new Error(
          "Não foi possível converter o certificado para PDF."
        );
      }

      const imagem =
        canvas.toDataURL(
          "image/png",
          1.0
        );

      const proporcao =
        canvas.width /
        canvas.height;

      const pdf =
        new jsPDF({
          orientation:
            proporcao >= 1
              ? "landscape"
              : "portrait",
          unit: "mm",
          format: "a4",
          compress: true,
        });

      const larguraPagina =
        pdf.internal.pageSize.getWidth();

      const alturaPagina =
        pdf.internal.pageSize.getHeight();

      let larguraImagem =
        larguraPagina;

      let alturaImagem =
        larguraImagem /
        proporcao;

      if (
        alturaImagem >
        alturaPagina
      ) {
        alturaImagem =
          alturaPagina;

        larguraImagem =
          alturaImagem *
          proporcao;
      }

      const posicaoX =
        (larguraPagina -
          larguraImagem) /
        2;

      const posicaoY =
        (alturaPagina -
          alturaImagem) /
        2;

      pdf.addImage(
        imagem,
        "PNG",
        posicaoX,
        posicaoY,
        larguraImagem,
        alturaImagem,
        undefined,
        "FAST"
      );

      return pdf;

    } finally {
      contentor.remove();
    }
  }
  async function downloadCertificate(
    certificate
  ) {
    try {
      showSystemMessage(
        "A preparar o seu certificado para download...",
        "success"
      );

      const pdf =
        await gerarPdfDoCertificado(
          certificate
        );

      const blob =
        pdf.output("blob");

      if (
        !blob ||
        blob.size <= 1000
      ) {
        throw new Error(
          "O ficheiro do certificado não foi gerado correctamente."
        );
      }

      const nomeUsuario =
        certificate.student_name ||
        user?.name ||
        "UTILIZADOR";

      const nomeSeguro =
        String(nomeUsuario)
          .trim()
          .replace(
            /[<>:"/\\|?*]+/g,
            "-"
          );

      const nomeFicheiro =
        `CERTIFICADO SICSI III - ${nomeSeguro}.pdf`;

      const url =
        window.URL.createObjectURL(
          blob
        );

      const link =
        document.createElement("a");

      link.href = url;
      link.download = nomeFicheiro;
      link.setAttribute(
        "download",
        nomeFicheiro
      );

      link.style.display =
        "none";

      document.body.appendChild(
        link
      );

      link.click();

      link.remove();

      window.setTimeout(
        () =>
          window.URL.revokeObjectURL(
            url
          ),
        30000
      );

      showSystemMessage(
        "O certificado foi descarregado com sucesso.",
        "success"
      );

    } catch (error) {
      console.error(
        "[SICSI III] Download do certificado:",
        error
      );

      showSystemMessage(
        error?.message ||
          "Não foi possível descarregar o certificado.",
        "error"
      );
    }
  }
  async function printCertificate(
    certificate
  ) {
    const janela =
      window.open(
        "",
        "_blank"
      );

    if (!janela) {
      showSystemMessage(
        "O navegador bloqueou a abertura do PDF. Permita pop-ups para o SICSI III.",
        "error"
      );

      return;
    }

    try {
      janela.document.title =
        "Certificado SICSI III";

      janela.document.body.innerHTML =
        '<div style="font-family:Arial,sans-serif;padding:40px;text-align:center;color:#475569">A preparar o certificado...</div>';

      showSystemMessage(
        "A preparar o PDF do certificado...",
        "success"
      );

      const pdf =
        await gerarPdfDoCertificado(
          certificate
        );

      const blob =
        pdf.output("blob");

      const url =
        window.URL.createObjectURL(
          blob
        );

      janela.location.href =
        url;

      window.setTimeout(
        () =>
          window.URL.revokeObjectURL(
            url
          ),
        60000
      );

    } catch (error) {
      janela.close();

      showSystemMessage(
        error?.message ||
          "Não foi possível abrir o PDF.",
        "error"
      );
    }
  }
