from pathlib import Path
from datetime import datetime, timezone
from uuid import uuid4
import json

from fastapi import APIRouter, HTTPException, Query
from pydantic import BaseModel


router = APIRouter(
    tags=["Course Admin v2"]
)


BASE_DIR = Path(__file__).resolve().parent
DATA_PATH = BASE_DIR / "data" / "courses.json"


# Estes cursos já pertencem ao projecto e ficam protegidos
# contra eliminação através deste novo backend.
CURSOS_PROTEGIDOS = {
    "course_fundamentos_sicsi",
    "course_contas_credenciais",
    "course_phishing",
    "course_engenharia_social",
}


class QuestionInput(BaseModel):
    question: str
    options: list[str]
    correct_answer: int


class CourseInput(BaseModel):
    title: str
    description: str
    link: str
    published: bool = False
    questions: list[QuestionInput]


class PublishInput(BaseModel):
    published: bool


def agora():
    return datetime.now(timezone.utc).isoformat()


def ler_cursos():
    if not DATA_PATH.exists():
        raise HTTPException(
            status_code=500,
            detail="courses.json não foi encontrado.",
        )

    try:
        dados = json.loads(
            DATA_PATH.read_text(encoding="utf-8")
        )
    except Exception as exc:
        raise HTTPException(
            status_code=500,
            detail=f"Não foi possível ler courses.json: {exc}",
        )

    if not isinstance(dados, list):
        raise HTTPException(
            status_code=500,
            detail="courses.json não contém uma lista de cursos.",
        )

    return dados


def guardar_cursos(cursos):
    temporario = DATA_PATH.with_suffix(".json.tmp")

    temporario.write_text(
        json.dumps(
            cursos,
            ensure_ascii=False,
            indent=2,
        ) + "\n",
        encoding="utf-8",
    )

    temporario.replace(DATA_PATH)


def localizar_curso(cursos, course_id):
    for curso in cursos:
        if isinstance(curso, dict) and curso.get("id") == course_id:
            return curso

    raise HTTPException(
        status_code=404,
        detail="Curso não encontrado.",
    )


def validar_link(link):
    valor = str(link or "").strip()

    if not valor:
        raise HTTPException(
            status_code=422,
            detail="O link do curso é obrigatório.",
        )

    if not (
        valor.startswith("http://")
        or valor.startswith("https://")
    ):
        raise HTTPException(
            status_code=422,
            detail="O link deve começar por http:// ou https://.",
        )

    return valor


def validar_perguntas(perguntas):
    if not isinstance(perguntas, list):
        raise HTTPException(
            status_code=422,
            detail="As perguntas devem ser uma lista.",
        )

    if len(perguntas) != 10:
        raise HTTPException(
            status_code=422,
            detail="Cada curso deve possuir exactamente 10 perguntas.",
        )

    resultado = []

    for indice, pergunta in enumerate(perguntas, start=1):
        texto = str(pergunta.question or "").strip()

        if not texto:
            raise HTTPException(
                status_code=422,
                detail=f"A pergunta {indice} está vazia.",
            )

        if not isinstance(pergunta.options, list):
            raise HTTPException(
                status_code=422,
                detail=f"A pergunta {indice} não possui opções válidas.",
            )

        if len(pergunta.options) != 4:
            raise HTTPException(
                status_code=422,
                detail=f"A pergunta {indice} deve possuir exactamente 4 opções.",
            )

        opcoes = [
            str(opcao or "").strip()
            for opcao in pergunta.options
        ]

        if any(not opcao for opcao in opcoes):
            raise HTTPException(
                status_code=422,
                detail=f"Todas as 4 opções da pergunta {indice} são obrigatórias.",
            )

        try:
            correcta = int(pergunta.correct_answer)
        except Exception:
            raise HTTPException(
                status_code=422,
                detail=f"A resposta correcta da pergunta {indice} é inválida.",
            )

        if correcta < 0 or correcta > 3:
            raise HTTPException(
                status_code=422,
                detail=f"A resposta correcta da pergunta {indice} deve estar entre 0 e 3.",
            )

        resultado.append(
            {
                "question": texto,
                "options": opcoes,
                "correct_answer": correcta,
            }
        )

    return resultado


def preparar_perguntas(
    perguntas_validas,
    perguntas_antigas=None,
):
    antigas = (
        perguntas_antigas
        if isinstance(perguntas_antigas, list)
        else []
    )

    resultado = []

    for indice, pergunta in enumerate(perguntas_validas):
        antiga = (
            antigas[indice]
            if indice < len(antigas)
            and isinstance(antigas[indice], dict)
            else {}
        )

        resultado.append(
            {
                "id": antiga.get(
                    "id",
                    f"question_{uuid4().hex}",
                ),
                "question": pergunta["question"],
                "options": pergunta["options"],
                "correct_answer": pergunta["correct_answer"],
                "explanation": antiga.get(
                    "explanation",
                    "",
                ),
            }
        )

    return resultado


def curso_admin(curso):
    perguntas = (
        curso.get("questions", [])
        if isinstance(curso.get("questions"), list)
        else []
    )

    return {
        "id": curso.get("id"),
        "title": curso.get("title", ""),
        "description": curso.get("description", ""),
        "link": curso.get("link", ""),
        "published": bool(curso.get("published", False)),
        "questions": perguntas,
        "questions_count": len(perguntas),
        "created_at": curso.get("created_at"),
        "updated_at": curso.get("updated_at"),
    }


@router.get("/courses")
def listar_cursos():
    cursos = ler_cursos()
    return [
        curso_admin(curso)
        for curso in cursos
        if isinstance(curso, dict)
    ]


@router.get("/courses/{course_id}")
def obter_curso(course_id: str):
    cursos = ler_cursos()
    curso = localizar_curso(cursos, course_id)
    return curso_admin(curso)


@router.post("/courses")
def criar_curso(body: CourseInput):
    cursos = ler_cursos()

    titulo = str(body.title or "").strip()
    descricao = str(body.description or "").strip()
    link = validar_link(body.link)
    perguntas = validar_perguntas(body.questions)

    if not titulo:
        raise HTTPException(
            status_code=422,
            detail="O título do curso é obrigatório.",
        )

    if not descricao:
        raise HTTPException(
            status_code=422,
            detail="A descrição do curso é obrigatória.",
        )

    agora_valor = agora()

    curso = {
        "id": f"course_admin_{uuid4().hex}",
        "title": titulo,
        "description": descricao,
        "published": bool(body.published),
        "link": link,
        "lessons": [],
        "questions": preparar_perguntas(perguntas),
        "created_at": agora_valor,
        "updated_at": agora_valor,
    }

    cursos.append(curso)
    guardar_cursos(cursos)

    return curso_admin(curso)


@router.put("/courses/{course_id}")
def actualizar_curso(
    course_id: str,
    body: CourseInput,
):
    cursos = ler_cursos()
    curso = localizar_curso(cursos, course_id)

    titulo = str(body.title or "").strip()
    descricao = str(body.description or "").strip()
    link = validar_link(body.link)
    perguntas = validar_perguntas(body.questions)

    if not titulo:
        raise HTTPException(
            status_code=422,
            detail="O título do curso é obrigatório.",
        )

    if not descricao:
        raise HTTPException(
            status_code=422,
            detail="A descrição do curso é obrigatória.",
        )

    perguntas_antigas = curso.get("questions", [])

    curso["title"] = titulo
    curso["description"] = descricao
    curso["link"] = link
    curso["published"] = bool(body.published)
    curso["questions"] = preparar_perguntas(
        perguntas,
        perguntas_antigas,
    )
    curso["updated_at"] = agora()

    guardar_cursos(cursos)

    return curso_admin(curso)


@router.patch("/courses/{course_id}/publish")
def alterar_publicacao(
    course_id: str,
    body: PublishInput,
):
    cursos = ler_cursos()
    curso = localizar_curso(cursos, course_id)

    curso["published"] = bool(body.published)
    curso["updated_at"] = agora()

    guardar_cursos(cursos)

    return curso_admin(curso)


@router.put(
    "/courses/{course_id}/questions/{question_id}"
)
def actualizar_pergunta(
    course_id: str,
    question_id: str,
    pergunta: QuestionInput,
):
    cursos = ler_cursos()
    curso = localizar_curso(cursos, course_id)

    perguntas = curso.get("questions", [])

    if not isinstance(perguntas, list):
        raise HTTPException(
            status_code=500,
            detail="As perguntas do curso são inválidas.",
        )

    if len(perguntas) != 10:
        raise HTTPException(
            status_code=409,
            detail="O curso precisa possuir exactamente 10 perguntas.",
        )

    validas = validar_perguntas(
        [
            pergunta
            for _ in range(1)
        ] + [
            QuestionInput(
                question="placeholder",
                options=["A", "B", "C", "D"],
                correct_answer=0,
            )
            for _ in range(9)
        ]
    )

    # Validamos a pergunta individualmente sem alterar
    # as restantes.
    texto = str(pergunta.question or "").strip()

    if not texto:
        raise HTTPException(
            status_code=422,
            detail="A pergunta é obrigatória.",
        )

    if len(pergunta.options) != 4:
        raise HTTPException(
            status_code=422,
            detail="A pergunta deve possuir exactamente 4 opções.",
        )

    opcoes = [
        str(opcao or "").strip()
        for opcao in pergunta.options
    ]

    if any(not opcao for opcao in opcoes):
        raise HTTPException(
            status_code=422,
            detail="As 4 opções são obrigatórias.",
        )

    correcta = int(pergunta.correct_answer)

    if correcta < 0 or correcta > 3:
        raise HTTPException(
            status_code=422,
            detail="A resposta correcta deve estar entre 0 e 3.",
        )

    alvo = None

    for item in perguntas:
        if isinstance(item, dict) and item.get("id") == question_id:
            alvo = item
            break

    if alvo is None:
        raise HTTPException(
            status_code=404,
            detail="Pergunta não encontrada.",
        )

    alvo["question"] = texto
    alvo["options"] = opcoes
    alvo["correct_answer"] = correcta
    alvo.setdefault("explanation", "")

    curso["updated_at"] = agora()

    guardar_cursos(cursos)

    return curso_admin(curso)


@router.delete("/courses/{course_id}")
def eliminar_curso(
    course_id: str,
    confirm: bool = Query(default=False),
):
    cursos = ler_cursos()
    curso = localizar_curso(cursos, course_id)

    if course_id in CURSOS_PROTEGIDOS:
        raise HTTPException(
            status_code=409,
            detail="Este curso está protegido e não pode ser eliminado por este backend.",
        )

    if not confirm:
        raise HTTPException(
            status_code=400,
            detail="A eliminação exige confirmação explícita.",
        )

    cursos = [
        item
        for item in cursos
        if not (
            isinstance(item, dict)
            and item.get("id") == course_id
        )
    ]

    guardar_cursos(cursos)

    return {
        "success": True,
        "message": "Curso eliminado com sucesso.",
        "id": course_id,
    }
