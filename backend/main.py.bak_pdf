                        12,
                    ),
                    (
                        "BOX",
                        (0, 0),
                        (-1, -1),
                        0.5,
                        dark,
                    ),
                ]
            )
        )

        story.append(brand_table)
        story.append(
            Spacer(1, 0.55 * cm)
        )

        story.append(
            Paragraph(
                "PHISHING",
                styles["eyebrow"],
            )
        )

        story.append(
            Paragraph(
                escape(
                    simulation.get(
                        "title",
                        "Experiência de phishing",
                    )
                ),
                styles["title"],
            )
        )

        story.append(
            Paragraph(
                "Análise final da experiência realizada.",
                styles["subtitle"],
            )
        )

        story.append(
            Spacer(1, 0.35 * cm)
        )

        metadata = Table(
            [
                [
                    Paragraph(
                        "<b>ESTUDANTE</b><br/>"
                        + escape(str(student_name)),
                        styles["small"],
                    ),
                    Paragraph(
                        "<b>DIFICULDADE</b><br/>"
                        + escape(
                            str(
                                simulation.get(
                                    "difficulty",
                                    "—",
                                )
                            )
                        ),
                        styles["small"],
                    ),
                    Paragraph(
                        "<b>CATEGORIA</b><br/>"
                        + escape(
                            str(
                                simulation.get(
                                    "category",
                                    "Phishing",
                                )
                            )
                        ),
                        styles["small"],
                    ),
                ]
            ],
            colWidths=[
                8.1 * cm,
                4.9 * cm,
                3.7 * cm,
            ],
        )

        metadata.setStyle(
            TableStyle(
                [
                    (
                        "BACKGROUND",
                        (0, 0),
                        (-1, -1),
                        soft,
                    ),
                    (
                        "BOX",
                        (0, 0),
                        (-1, -1),
                        0.7,
                        line,
                    ),
                    (
                        "INNERGRID",
                        (0, 0),
                        (-1, -1),
                        0.5,
                        line,
                    ),
                    (
                        "VALIGN",
                        (0, 0),
