                        ),
                    ],
                    Paragraph(
                        "<b>LEITURA DO RESULTADO</b><br/><br/>"
                        + escape(
                            "A pontuação é uma síntese das decisões tomadas "
                            "ao longo da experiência. O mais importante é "
                            "perceber onde o risco aumentou e como agir "
                            "melhor numa situação semelhante."
                        ),
                        styles["white_body"],
                    ),
                ]
            ],
            colWidths=[
                5.2 * cm,
                12.0 * cm,
            ],
        )

        result_table.setStyle(
            TableStyle(
                [
                    (
                        "BACKGROUND",
                        (0, 0),
                        (0, 0),
                        blue,
                    ),
                    (
                        "BACKGROUND",
                        (1, 0),
                        (1, 0),
                        colors.HexColor("#172554"),
                    ),
                    (
                        "VALIGN",
                        (0, 0),
                        (-1, -1),
                        "MIDDLE",
                    ),
                    (
                        "LEFTPADDING",
                        (0, 0),
                        (-1, -1),
                        14,
                    ),
                    (
                        "RIGHTPADDING",
                        (0, 0),
                        (-1, -1),
                        14,
                    ),
                    (
                        "TOPPADDING",
                        (0, 0),
                        (-1, -1),
                        14,
                    ),
                    (
                        "BOTTOMPADDING",
                        (0, 0),
                        (-1, -1),
                        14,
                    ),
                ]
            )
        )

        story.append(result_table)
        story.append(
            Spacer(1, 0.55 * cm)
        )

        # FEEDBACK IGUAL AO WEBSITE
        story.append(
            Paragraph(
                "O SEU FEEDBACK",
                styles["eyebrow"],
            )
        )

        story.append(
            Paragraph(
                "O que aconteceu",
                styles["section"],
            )
        )

        feedback_table = Table(
            [
                [
                    Paragraph(
                        escape(narrative),
                        styles["body"],
                    )
                ]
            ],
            colWidths=[17.2 * cm],
        )

        feedback_table.setStyle(
            TableStyle(
                [
                    (
                        "BACKGROUND",
                        (0, 0),
                        (-1, -1),
                        soft,
                    ),
                    (
                        "BOX",
                        (0, 0),
                        (-1, -1),
                        0.7,
                        line,
                    ),
                    (
                        "LEFTPADDING",
                        (0, 0),
                        (-1, -1),
                        13,
                    ),
                    (
                        "RIGHTPADDING",
                        (0, 0),
                        (-1, -1),
                        13,
                    ),
                    (
                        "TOPPADDING",
                        (0, 0),
                        (-1, -1),
                        12,
                    ),
                    (
                        "BOTTOMPADDING",
                        (0, 0),
                        (-1, -1),
                        12,
                    ),
                ]
            )
        )

        story.append(feedback_table)
        story.append(
            Spacer(1, 0.55 * cm)
        )

        # INFORMAÇÃO
        story.append(
            Paragraph(
                "INFORMAÇÃO POTENCIALMENTE EXPOSTA",
                styles["eyebrow"],
            )
        )

        story.append(
            Paragraph(
                "O que poderia ter sido aproveitado",
                styles["section"],
            )
        )

        information_rows = []

        if email_value:
            information_rows.append(
                [
                    Paragraph(
                        "<b>ENDEREÇO DE CORREIO ELECTRÓNICO</b><br/>"
                        + escape(email_value)
                        + "<br/><br/>"
                        + "<font size='8'>"
                        + "Poderia ser utilizado para tornar "
                        + "futuras tentativas de fraude mais "
                        + "convincentes."
                        + "</font>",
                        styles["body"],
                    )
                ]
            )

        if password_entered:
            information_rows.append(
                [
                    Paragraph(
                        "<b>PALAVRA-PASSE</b><br/>"
                        "Introduzida — conteúdo não guardado"
                        + "<br/><br/>"
                        + "<font size='8'>"
                        + "O SICSI III não guarda nem "
                        + "apresenta o conteúdo da palavra-passe."
                        + "</font>",
                        styles["body"],
                    )
                ]
            )

        if not information_rows:
            information_rows.append(
                [
                    Paragraph(
                        "<b>Nenhuma informação sensível foi entregue.</b><br/><br/>"
                        "A experiência terminou sem registo de "
                        "dados sensíveis.",
                        styles["body"],
                    )
                ]
            )

        info_table = Table(
            information_rows,
            colWidths=[17.2 * cm],
        )

        info_table.setStyle(
            TableStyle(
                [
                    (
                        "BACKGROUND",
                        (0, 0),
                        (-1, -1),
                        red_bg if information_rows else green_bg,
                    ),
                    (
                        "BOX",
                        (0, 0),
                        (-1, -1),
                        0.7,
                        red if information_rows else green,
