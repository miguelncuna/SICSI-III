                        (-1, -1),
                        12,
                    ),
                ]
            )
        )

        story.append(info_table)
        story.append(
            Spacer(1, 0.55 * cm)
        )

        # IMPACTO + MELHORIA
        impact_table = Table(
            [
                [
                    Paragraph(
                        "<b>IMPACTO POSSÍVEL</b><br/><br/>"
                        + escape(impact),
                        styles["body"],
                    ),
                    Paragraph(
                        "<b>COMO MELHORAR</b><br/><br/>"
                        + escape(improvement),
                        styles["body"],
                    ),
                ]
            ],
            colWidths=[
                8.35 * cm,
                8.35 * cm,
            ],
        )

        impact_table.setStyle(
            TableStyle(
                [
                    (
                        "BACKGROUND",
                        (0, 0),
                        (0, 0),
                        red_bg,
                    ),
                    (
                        "BACKGROUND",
                        (1, 0),
                        (1, 0),
