def simulation_next_id(simulation_id):
    if not str(simulation_id).startswith("phishing-"):
        return None

    try:
        number = int(str(simulation_id).split("-")[-1])
    except (TypeError, ValueError):
        return None

    if number >= 5:
        return None

    return f"phishing-{number + 1:02d}"


def build_simulation_report(session, simulation):
    actions = session.get("actions", [])

    dangerous_actions = [
        item for item in actions if not item.get("safe", False)
    ]

    safe_actions = [
        item for item in actions if item.get("safe", False)
    ]

    dangerous_count = len(dangerous_actions)
    safe_count = len(safe_actions)

    score = max(
        0,
        min(
            100,
            100 - (dangerous_count * 25) + (safe_count * 5)
        )
    )

    if score >= 80:
        classification = "Muito segura"
    elif score >= 60:
        classification = "Segura"
    elif score >= 40:
        classification = "A melhorar"
    else:
        classification = "Elevado risco"

    email_value = session.get("form_data", {}).get("email", "")
    password_entered = bool(
        session.get("form_data", {}).get("password_entered", False)
    )

    data_shared = []

    if email_value:
        data_shared.append(
            {
                "field": "Endereço de correio electrónico",
                "value": email_value,
                "sensitive": True,
            }
        )

    if password_entered:
        data_shared.append(
            {
                "field": "Palavra-passe",
                "value": "Introduzida — conteúdo não guardado",
                "sensitive": True,
            }
        )

    report = {
        "behaviour_score": score,
        "classification": classification,
        "total_actions": len(actions),
        "dangerous_actions": dangerous_actions,
        "safe_actions": safe_actions,
        "data_shared": data_shared,
        "form_data": {
            "email": email_value or None,
            "password_entered": password_entered,
        },
        "generated_at": now(),
    }

    return report


def build_simulation_result(session):
    report = build_simulation_report(
        session,
        session.get("simulation", {})
    )

    return {
        "completed": bool(session.get("completed", False)),
        "correct": bool(session.get("last_safe", False)),
        "feedback": session.get(
            "last_feedback",
            "A sua decisão foi registada na experiência."
        ),
        "explanation": session.get(
            "last_explanation",
            ""
        ),
        "next_simulation_id": simulation_next_id(
            session.get("simulation_id", "")
        ),
        "report": report,
    }


@app.get("/api/simulations")
def get_simulations():
    return read_json("simulations")


@app.get("/api/simulations/{simulation_id}")
def get_simulation(simulation_id: str):
    simulations = read_json("simulations")

    simulation = next(
        (
            item
            for item in simulations
            if item.get("id") == simulation_id
        ),
        None,
    )

    if not simulation:
        raise HTTPException(
            status_code=404,
            detail="Simulação não encontrada.",
        )

    return simulation


@app.post("/api/simulations/{simulation_id}/evaluate")
def evaluate_simulation(
    simulation_id: str,
    body: dict,
):
    simulations = read_json("simulations")

    simulation = next(
        (
            item
            for item in simulations
            if item.get("id") == simulation_id
        ),
        None,
    )

    if not simulation:
        raise HTTPException(
            status_code=404,
            detail="Simulação não encontrada.",
        )

    action = body.get("action")
    user_id = body.get("user_id")
    step_id = body.get("step_id")
    interaction_type = body.get(
        "interaction_type"
    ) or action

    metadata = body.get("metadata") or {}

    if not action:
        raise HTTPException(
            status_code=400,
            detail="É necessário indicar uma acção.",
        )

    if not user_id:
        raise HTTPException(
            status_code=400,
            detail="É necessário identificar o utilizador.",
        )

    key = simulation_session_key(
        user_id,
        simulation_id,
    )

    session = SIMULATION_SESSIONS.setdefault(
        key,
        {
            "simulation_id": simulation_id,
            "user_id": user_id,
            "simulation": simulation,
            "actions": [],
            "form_data": {
                "email": "",
                "password_entered": False,
            },
            "completed": False,
            "last_safe": False,
        },
    )

    # O email pode ser apresentado no relatório.
    email_value = str(
        metadata.get("email") or ""
    ).strip()

    if email_value:
        session["form_data"]["email"] = email_value

    # A palavra-passe NUNCA é guardada.
    if metadata.get("password_entered") is True:
        session["form_data"]["password_entered"] = True

    safe = simulation_action_is_safe(
        action,
        interaction_type,
    )

    action_title = simulation_action_title(
        action,
        interaction_type,
    )

    impact = simulation_impact(
        action,
        interaction_type,
    )

    action_record = {
        "action": action,
        "interaction_type": interaction_type,
        "step_id": step_id,
        "title": action_title,
        "safe": safe,
        "impact": impact,
        "data_shared": [],
    }

    if email_value:
        action_record["data_shared"].append(
            "Endereço de correio electrónico"
        )

    if metadata.get("password_entered") is True:
        action_record["data_shared"].append(
            "Palavra-passe"
        )

    session["actions"].append(
        action_record
    )

    session["last_safe"] = safe

    if safe:
        session["last_feedback"] = (
            "Esta decisão reduziu a exposição ao risco."
        )
    else:
        session["last_feedback"] = (
            "Esta decisão aumentou a sua exposição ao risco."
        )

    session["last_explanation"] = impact

    # Acções que concluem a experiência.
    completion_actions = {
        "report",
        "leave_page",
        "finish",
        "submit_credentials",
        "credentials",
        "login",
    }

    if (
        str(interaction_type or action).lower()
        in completion_actions
    ):
        session["completed"] = True

    return build_simulation_result(session)


@app.get("/api/simulations/{simulation_id}/result/{user_id}")
def get_simulation_result(
    simulation_id: str,
    user_id: str,
):
    key = simulation_session_key(
        user_id,
        simulation_id,
    )

    session = SIMULATION_SESSIONS.get(key)

    if not session:
        raise HTTPException(
            status_code=404,
            detail="Ainda não existe um relatório concluído para esta simulação.",
        )

    return build_simulation_result(session)


@app.get("/api/simulations/{simulation_id}/result/{user_id}/pdf")
def simulation_result_pdf(
    simulation_id: str,
    user_id: str,
):
    key = simulation_session_key(
        user_id,
        simulation_id,
    )

    session = SIMULATION_SESSIONS.get(key)

    if not session:
        raise HTTPException(
            status_code=404,
            detail="O relatório temporário já não está disponível.",
        )

    try:
        from io import BytesIO
        from xml.sax.saxutils import escape

        from fastapi.responses import StreamingResponse

        from reportlab.lib import colors
        from reportlab.lib.enums import TA_CENTER, TA_LEFT
        from reportlab.lib.pagesizes import A4
        from reportlab.lib.styles import ParagraphStyle
        from reportlab.lib.units import cm
        from reportlab.platypus import (
            SimpleDocTemplate,
            Paragraph,
            Spacer,
            Table,
            TableStyle,
            KeepTogether,
        )

        # ------------------------------------------------------------
        # DADOS
        # ------------------------------------------------------------

        simulation = None

        for item in SIMULATIONS:
            if item.get("id") == simulation_id:
                simulation = item
                break

        if simulation is None:
            raise HTTPException(
                status_code=404,
                detail="Simulação não encontrada.",
            )

        result = build_simulation_result(session)
        report = result.get("report") or {}

        student_name = (
            session.get("user_name")
            or session.get("student_name")
            or session.get("name")
            or "Estudante"
        )

        score = int(
            report.get("behaviour_score") or 0
        )

        classification = (
            report.get("classification")
            or (
                "Comportamento seguro"
                if score >= 80
                else "Atenção necessária"
                if score >= 60
                else "Exposição elevada ao risco"
            )
        )

        safe_actions = (
            report.get("safe_actions")
            if isinstance(
                report.get("safe_actions"),
                list,
            )
            else []
        )

        dangerous_actions = (
            report.get("dangerous_actions")
            if isinstance(
                report.get("dangerous_actions"),
                list,
            )
            else []
        )

        data_shared = (
            report.get("data_shared")
            if isinstance(
                report.get("data_shared"),
                list,
            )
            else []
        )

        def action_text(action):
            raw = str(
                action.get("interaction_id")
                or action.get("action")
                or action.get("type")
                or action.get("interaction")
                or action.get("decision")
                or action.get("name")
                or action.get("label")
                or ""
            ).lower()

            direct_text = (
                action.get("description")
                or action.get("text")
                or action.get("title")
                or ""
            )

            if (
                isinstance(direct_text, str)
                and len(direct_text.strip()) > 12
            ):
                return direct_text.strip().rstrip(".!?")

            if (
                "inspect_sender" in raw
                or "sender" in raw
                or "remetente" in raw
            ):
                return "verificou os dados do remetente"

            if (
                "open_link" in raw
                or "click" in raw
                or "link" in raw
            ):
                return "abriu a ligação apresentada na mensagem"

            if (
                "open_form" in raw
                or "form" in raw
            ):
                return "abriu o formulário apresentado"

            if (
                "report_email" in raw
                or "report" in raw
                or "flag" in raw
                or "denunc" in raw
            ):
                return "denunciou a mensagem como suspeita"

            if (
                "inspect_url" in raw
                or "url" in raw
            ):
                return "verificou o endereço da página"

            if (
                "submit_credentials" in raw
                or "credential" in raw
                or "password" in raw
                or "login" in raw
            ):
                return "introduziu dados de acesso no formulário"

            if (
                "submit_personal_data" in raw
                or "personal" in raw
            ):
                return "introduziu os dados pessoais pedidos"

            if (
                "submit_mfa" in raw
                or "otp" in raw
                or "mfa" in raw
                or "code" in raw
            ):
                return "introduziu um código de segurança"

            if (
                "refuse" in raw
                or "reject" in raw
                or "cancel" in raw
            ):
                return "recusou continuar com o pedido"

            if (
                "leave" in raw
                or "exit" in raw
                or "back" in raw
            ):
                return "saiu da página sem fornecer mais informação"

            if "download" in raw:
                return "descarregou o ficheiro apresentado"

            if (
                "delete" in raw
                or "remove" in raw
            ):
                return "eliminou o conteúdo suspeito"

            if (
                "inspect" in raw
                or "verify" in raw
                or "check" in raw
            ):
                return "verificou a informação antes de continuar"

            return "avançou numa etapa da situação simulada"

        ordered = (
            safe_actions +
            dangerous_actions
        )

        action_descriptions = []

        for action in ordered:
            text = action_text(action)

            if text not in action_descriptions:
                action_descriptions.append(text)

        narrative_parts = []

        if action_descriptions:
            narrative_parts.append(
                "Durante a experiência, "
                + ", ".join(action_descriptions)
                + "."
            )

        email_value = ""

        for item in data_shared:
            if (
                isinstance(item, dict)
                and str(item.get("field", "")).lower()
                == "email"
            ):
                email_value = str(
                    item.get("value") or ""
                )
                break

        password_entered = any(
            isinstance(item, dict)
            and str(item.get("field", "")).lower()
            == "password"
            for item in data_shared
        )

        if email_value:
            narrative_parts.append(
                "Foi introduzido o endereço de correio electrónico "
                + email_value
                + "."
            )

        if password_entered:
            narrative_parts.append(
                "Também foi introduzida uma palavra-passe. "
                "O seu conteúdo não é guardado nem apresentado."
            )

        if dangerous_actions:
            narrative_parts.append(
                "As decisões de risco aumentaram a exposição porque "
                "permitiram que a situação se aproximasse de um possível "
                "acesso indevido à conta."
            )

        if dangerous_actions:
            narrative_parts.append(
                "A melhoria principal é parar antes de agir, confirmar "
                "a origem por um canal oficial e só depois decidir."
            )
        else:
            narrative_parts.append(
                "O percurso foi prudente e evitou o agravamento da situação."
            )

        narrative = " ".join(
            narrative_parts
        )

        if not narrative:
            narrative = (
                "A experiência foi concluída sem informação suficiente "
                "para produzir uma análise detalhada."
            )

        if dangerous_actions:
            impact = (
                "Num caso real, uma mensagem deste tipo poderia ser "
                "utilizada para conduzir a vítima para uma página falsa "
                "e recolher informação que facilitasse tentativas de "
                "acesso, fraude ou engenharia social."
            )

            improvement = (
                "Antes de abrir uma ligação, confirme o remetente e o "
                "endereço real do serviço. Quando existir pressão ou "
                "urgência, interrompa o processo e confirme por um canal "
                "oficial."
            )
        else:
            impact = (
                "As decisões tomadas reduziram a possibilidade de "
                "entregar informação a uma página suspeita."
            )

            improvement = (
                "Continue a verificar a origem das mensagens antes de "
                "abrir ligações ou fornecer qualquer informação."
            )

        # ------------------------------------------------------------
        # PDF
        # ------------------------------------------------------------

        buffer = BytesIO()

        document = SimpleDocTemplate(
            buffer,
            pagesize=A4,
            rightMargin=1.55 * cm,
            leftMargin=1.55 * cm,
            topMargin=1.45 * cm,
            bottomMargin=1.45 * cm,
            title=(
