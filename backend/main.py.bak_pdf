        soft = colors.HexColor("#f8fafc")
        line = colors.HexColor("#e2e8f0")
        red = colors.HexColor("#dc2626")
        red_bg = colors.HexColor("#fef2f2")
        green = colors.HexColor("#059669")
        green_bg = colors.HexColor("#ecfdf5")

        styles = {
