                        8,
                    ),
                    (
                        "VALIGN",
                        (0, 0),
                        (-1, -1),
                        "MIDDLE",
                    ),
                    (
                        "ALIGN",
                        (1, 0),
                        (1, 0),
                        "RIGHT",
                    ),
                ]
            )
        )

        story.append(footer)

        document.build(story)

        buffer.seek(0)

        safe_title = (
            str(
                simulation.get(
                    "title",
                    simulation_id,
                )
            )
            .replace("ã", "a")
            .replace("á", "a")
            .replace("à", "a")
            .replace("â", "a")
            .replace("é", "e")
            .replace("ê", "e")
            .replace("í", "i")
            .replace("ó", "o")
            .replace("ô", "o")
            .replace("õ", "o")
            .replace("ú", "u")
            .replace("ç", "c")
        )

        import re

        safe_title = re.sub(
            r"[^A-Za-z0-9]+",
            "_",
            safe_title,
        ).strip("_")

        filename = (
            "SICSI_III_Relatorio_"
            + safe_title
            + ".pdf"
        )

        # O resultado da simulação é temporário.
        SIMULATION_SESSIONS.pop(
            key,
            None,
        )

        return StreamingResponse(
            buffer,
            media_type="application/pdf",
            headers={
                "Content-Disposition":
                    f'attachment; filename="{filename}"'
            },
        )

    except ImportError:
        raise HTTPException(
            status_code=500,
            detail=(
                "A biblioteca necessária para gerar PDF "
                "não está instalada."
            ),
        )
@app.delete("/api/simulations/{simulation_id}/result/{user_id}")
def clear_simulation_result(
    simulation_id: str,
    user_id: str,
):
    key = simulation_session_key(
        user_id,
        simulation_id,
    )

    SIMULATION_SESSIONS.pop(
        key,
        None,
    )

    return {
        "status": "deleted",
    }