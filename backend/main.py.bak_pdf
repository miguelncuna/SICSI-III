        story.append(metadata)
        story.append(
            Spacer(1, 0.5 * cm)
        )

        # RESULTADO
        result_table = Table(
            [
                [
                    [
                        Paragraph(
                            "RESULTADO",
                            ParagraphStyle(
                                "r1",
                                fontName="Helvetica-Bold",
                                fontSize=8,
                                leading=10,
                                textColor=colors.HexColor("#bfdbfe"),
