        # RODAPÉ
        footer = Table(
            [
                [
                    Paragraph(
                        "SICSI III • Segurança Digital",
                        styles["small"],
                    ),
                    Paragraph(
                        "Relatório de aprendizagem",
                        styles["small"],
                    ),
                ]
            ],
            colWidths=[
                8.6 * cm,
                8.6 * cm,
            ],
        )

        footer.setStyle(
            TableStyle(
                [
                    (
                        "LINEABOVE",
                        (0, 0),
                        (-1, -1),
                        0.6,
                        line,
                    ),
                    (
                        "TOPPADDING",
                        (0, 0),
